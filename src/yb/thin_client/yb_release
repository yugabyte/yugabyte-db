# yb_release for the yb_thin_client library.
#
# Builds a self-contained libyb_thin_client.so via full-LTO whole-program linking (the mechanism
# yb_release uses for the server binaries) and packages it with the C ABI header and version file
# into $YB_SRC_ROOT/build:
#   yb_thin_client-<version>-<commit>-<build_type>-<system>-<arch>/
#     lib/libyb_thin_client.so    include/yb_thin_client.h    version.txt
#
# The .so depends only on system libraries, exports only the ybthin_* ABI, and uses libc malloc
# (see --no-tcmalloc) so it does not interpose the allocator of the process that loads it.
#
# It first builds all of YugabyteDB except tests and Java, which dominates the time on a cold tree.
# The whole-program link needs ~13 GiB of free RAM (same gate as yb_release's server link).
#
# usage: src/yb/thin_client/yb_release [build_type]     (build_type defaults to "release")
#        --destination <dir>   also copy the tarball into <dir> (like yb_release --destination)

set -euo pipefail

script_dir=$( cd "${BASH_SOURCE%/*}" && pwd )
yb_src_root=$( cd "$script_dir/../../.." && pwd )
# shellcheck source=build-support/common-build-env.sh
. "$yb_src_root/build-support/common-build-env.sh"

build_type="release"
destination=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --destination) destination=$2; shift 2 ;;
    --destination=*) destination=${1#*=}; shift ;;
    -h|--help) grep '^#' "$BASH_SOURCE" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) build_type=$1; shift ;;
  esac
done
validate_build_type "$build_type"

activate_virtualenv
set_pythonpath

readonly lib_name="libyb_thin_client.so"
readonly cmake_target="yb_thin_client"

# Build everything except tests and Java first. The link-command step below reads
# postgres_build/src/common/libpgcommon_srv.a, which the PostgreSQL make produces with no ninja edge
# of its own, and building PostgreSQL pulls in the server closure anyway (the postgres target
# depends on yb_pggate and server_process).
#
# This build runs with tcmalloc on. Without tcmalloc every shared library links with
# --no-undefined, which libyb_pggate_util.so cannot satisfy: it calls into yb_dockv, which depends
# on it in turn, a cycle CMake cannot declare. YB_TCMALLOC_ENABLED=1 is set explicitly because
# yb_build.sh otherwise keeps the cached value, which is 0 after any earlier run of this script.
log "Building YugabyteDB without tests or Java ($build_type)"
YB_TCMALLOC_ENABLED=1 YB_LINKING_TYPE=full-lto YB_BUILD_TESTS=false \
  "$yb_src_root/yb_build.sh" "$build_type" --force-run-cmake --skip-java

# The client links src/common objects from this build, and they were compiled with the tcmalloc
# defines: CMakeLists.txt copies the C++ flags into CMAKE_C_FLAGS, which PostgreSQL builds from, and
# PostgreSQL's make does not recompile when flags change. That matches a build without tcmalloc
# only while nothing those objects are compiled from tests the macros, so check it: src/common,
# PostgreSQL's headers, and the YugabyteDB headers they include, followed transitively.
pg_src="$yb_src_root/src/postgres/src"
mapfile -t tc_inputs < <( find "$pg_src/common" "$pg_src/include" -name '*.[ch]' )
declare -A yb_headers=()
queue=( "${tc_inputs[@]}" )
while (( ${#queue[@]} )); do
  f=${queue[-1]}; unset 'queue[-1]'
  while read -r h; do
    p="$yb_src_root/src/$h"
    if [[ -f "$p" && -z "${yb_headers[$p]:-}" ]]; then yb_headers[$p]=1; queue+=( "$p" ); fi
  done < <( sed -nE 's/^[[:space:]]*#[[:space:]]*include[[:space:]]+"(yb\/[^"]+)".*/\1/p' "$f" )
done
tc_inputs+=( "${!yb_headers[@]}" )
if grep -lwE 'YB_TCMALLOC_ENABLED|YB_GOOGLE_TCMALLOC|YB_GPERFTOOLS_TCMALLOC' "${tc_inputs[@]}"; then
  fatal "the files above test a tcmalloc macro, so the PostgreSQL objects built with tcmalloc on \
differ from what the client needs; build them without the tcmalloc defines instead"
fi

# Reconfigure the same tree without tcmalloc for the client. Servers link Google tcmalloc as the
# process allocator, but this .so is loaded into a process that owns its own; the code is
# #ifdef-guarded to fall back to libc malloc/free. The closure is recompiled with these flags below.
log "Reconfiguring the full-LTO tree without tcmalloc ($build_type)"
build_log=$( mktemp )
YB_LINKING_TYPE=full-lto YB_BUILD_TESTS=false \
  "$yb_src_root/yb_build.sh" "$build_type" --no-tcmalloc --force-run-cmake --cmake-only \
  --skip-java 2>&1 | tee "$build_log"
build_root=$( grep -E '^Build directory' "$build_log" | tail -1 | sed -E 's/^[^:]*:[[:space:]]*//' )
[[ -d "$build_root" ]] || fatal "Could not determine the full-LTO build root from the build output"
log "Full-LTO build root: $build_root"

lto_out="$build_root/lib/$lib_name"

# Emit the link command without running the linker. Apart from the PostgreSQL archive and
# link-canary.o built above, it needs only the configured build graph (--incomplete-build), and it
# names every object the client links -- our build work-list.
log "Computing the whole-program link command (and the real object closure) for $lib_name"
"$YB_SCRIPT_PATH_DEPENDENCY_GRAPH" \
  --build-root="$build_root" \
  --file-regex="^.*/libyb_thin_client[.]so\$" \
  --incomplete-build \
  --never-run-build \
  --run-linker=false \
  --lto-output-path="$lto_out" \
  link-whole-program

link_args_file="${lto_out}_lto_link_cmd_args.txt"
[[ -f "$link_args_file" ]] || fatal "Whole-program link did not emit args file: $link_args_file"

# Recompile the client's object closure without tcmalloc. The PostgreSQL archives it links came from
# the full build above; requesting them again would force the postgres target, whose dependencies
# cannot link without tcmalloc. YB_BUILD_ROOT must be exported: several closure objects
# order-only-depend on configure_postgres/genbki, and build_postgres aborts without it.
log "Recompiling the client's link closure without tcmalloc"
# The args file names objects both relative to the build root (the shim's own object, taken from the
# original link command) and as absolute paths under it; keep both, as build-root-relative paths.
mapfile -t closure_objs < <(
  grep -oE '[^ ]+\.cc\.o' "$link_args_file" | sed "s#^${build_root}/##" | grep -v '^/' | sort -u )
shim_obj="src/yb/thin_client/CMakeFiles/yb_thin_client.dir/yb_thin_client.cc.o"
printf '%s\n' "${closure_objs[@]}" | grep -qxF "$shim_obj" ||
  fatal "$shim_obj is missing from the object closure in $link_args_file"
log "Closure: ${#closure_objs[@]} objects"
( cd "$build_root" && YB_BUILD_ROOT="$build_root" ninja "${closure_objs[@]}" ) ||
  fatal "failed to recompile the link closure -- see ninja output above"

# Localize everything but the ybthin_* ABI, so the shim cannot collide with or interpose symbols
# (protobuf/absl/OpenSSL/...) in the host process.
version_script=$( mktemp )
cat >"$version_script" <<'VS'
YBTHIN {
  global:
    ybthin_*;
  local:
    *;
};
VS

log "Linking $lib_name (single self-contained object)"
# The link args use paths relative to the build root, so run from there.
mapfile -t link_args < "$link_args_file"
( cd "$build_root" &&
  "${link_args[@]}" -Wl,--gc-sections -Wl,--version-script="$version_script" -o "$lto_out" )
strip --strip-all "$lto_out"

version=$( tr -d '[:space:]' < "$yb_src_root/version.txt" 2>/dev/null || echo "0.0.0.0" )
commit=$( cd "$yb_src_root" && git rev-parse --short HEAD 2>/dev/null || echo unknown )
arch=$( uname -m )
system=$( uname -s | tr '[:upper:]' '[:lower:]' )
pkg_name="yb_thin_client-${version}-${commit}-${build_type}-${system}-${arch}"

stage=$( mktemp -d )
pkg_dir="$stage/$pkg_name"
mkdir -p "$pkg_dir/lib" "$pkg_dir/include"
cp "$lto_out" "$pkg_dir/lib/$lib_name"
cp "$script_dir/yb_thin_client.h" "$pkg_dir/include/yb_thin_client.h"
cp "$yb_src_root/version.txt" "$pkg_dir/version.txt"

release_dir="$yb_src_root/build"
mkdir -p "$release_dir"
tarball="$release_dir/${pkg_name}.tar.gz"
tar -czf "$tarball" -C "$stage" "$pkg_name"
rm -rf "$stage"
log "Packaged: $tarball ($( du -h "$tarball" | cut -f1 ))"

if [[ -n "$destination" ]]; then
  [[ -d "$destination" ]] || fatal "Destination $destination is not a directory"
  cp "$tarball" "$destination/"
  log "Copied to $destination/${pkg_name}.tar.gz"
fi
