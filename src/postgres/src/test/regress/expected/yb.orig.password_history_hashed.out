--
-- YB_PASSWORD_HISTORY_HASHED Testsuite: the mode in which pre-hashed
-- passwords are accepted and so no reuse policy can be enforced.
--
ALTER ROLE ALL SET yb_password_reuse_history = 0;
ALTER ROLE ALL SET yb_password_reuse_interval = 0;
\c yugabyte yugabyte
SET yb_allow_prehashed_passwords = on;
-- Pre-hashed passwords and reuse policy are mutually exclusive.
ALTER ROLE ALL SET yb_password_reuse_history = 3;  -- ERROR
ERROR:  invalid value for parameter "yb_password_reuse_history": 3
DETAIL:  A password reuse policy cannot be enforced while pre-hashed passwords are accepted.
HINT:  Set yb_allow_prehashed_passwords to off first.
ALTER ROLE ALL SET yb_password_reuse_interval = 60; -- ERROR
ERROR:  invalid value for parameter "yb_password_reuse_interval": 60
DETAIL:  A password reuse policy cannot be enforced while pre-hashed passwords are accepted.
HINT:  Set yb_allow_prehashed_passwords to off first.
-- Pre-hashed passwords are accepted.
CREATE USER phh_scram PASSWORD 'SCRAM-SHA-256$4096:MDEyMzQ1Njc4OWFiY2RlZg==$AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=:ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=';
CREATE USER phh_md5 PASSWORD 'md5aabbccddeeff00112233445566778899';
SELECT rolname, substring(rolpassword from '^(md5|SCRAM-SHA-256)') AS stored_format
  FROM pg_authid WHERE rolname IN ('phh_scram', 'phh_md5') ORDER BY rolname;
  rolname  | stored_format 
-----------+---------------
 phh_md5   | md5
 phh_scram | SCRAM-SHA-256
(2 rows)

-- With the policy off, no entries are recorded.
SELECT count(*) FROM pg_catalog.pg_yb_password_history h
  JOIN pg_authid a ON a.oid = h.pwdhstrole
  WHERE a.rolname IN ('phh_scram', 'phh_md5');
 count 
-------
     0
(1 row)

-- Reuse is not blocked.
ALTER USER phh_md5 PASSWORD 'md5aabbccddeeff00112233445566778899';
-- yb_allow_prehashed_passwords off rejects a pre-hashed password on CREATE
-- and ALTER even when both reuse windows are 0.  Nothing is recorded.
SET yb_allow_prehashed_passwords = off;
ALTER USER phh_md5 PASSWORD 'md5aabbccddeeff00112233445566778899';   -- ERROR
ERROR:  pre-hashed passwords are not accepted
DETAIL:  yb_allow_prehashed_passwords is off.
HINT:  Supply the password in plaintext; it is encrypted before being stored.
ALTER USER phh_scram PASSWORD 'SCRAM-SHA-256$4096:MDEyMzQ1Njc4OWFiY2RlZg==$AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=:ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=';   -- ERROR
ERROR:  pre-hashed passwords are not accepted
DETAIL:  yb_allow_prehashed_passwords is off.
HINT:  Supply the password in plaintext; it is encrypted before being stored.
CREATE USER phh_md5_new PASSWORD 'md5aabbccddeeff00112233445566778899';   -- ERROR
ERROR:  pre-hashed passwords are not accepted
DETAIL:  yb_allow_prehashed_passwords is off.
HINT:  Supply the password in plaintext; it is encrypted before being stored.
CREATE USER phh_scram_new PASSWORD 'SCRAM-SHA-256$4096:MDEyMzQ1Njc4OWFiY2RlZg==$AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=:ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=';   -- ERROR
ERROR:  pre-hashed passwords are not accepted
DETAIL:  yb_allow_prehashed_passwords is off.
HINT:  Supply the password in plaintext; it is encrypted before being stored.
-- Plaintext is still accepted, and no history row is written.
CREATE USER phh_plain PASSWORD 'pw_plain';
SELECT count(*) FROM pg_catalog.pg_yb_password_history h
  JOIN pg_authid a ON a.oid = h.pwdhstrole
  WHERE a.rolname = 'phh_plain';
 count 
-------
     0
(1 row)

DROP USER phh_scram;
DROP USER phh_md5;
DROP USER phh_plain;
-- Drop the ALTER ROLE ALL overrides so a later schedule file sees the config-file policy.
ALTER ROLE ALL RESET yb_password_reuse_history;
ALTER ROLE ALL RESET yb_password_reuse_interval;
