CALL typmod_idx_record('varchar(10) -> varchar(20)', 'idx_typmod_v_part');
CALL typmod_idx_snapshot('varchar(20) -> varchar(15)', 'idx_typmod_v_expr');
CALL typmod_idx_snapshot('varchar(20) -> varchar(15)', 'idx_typmod_v_part');
