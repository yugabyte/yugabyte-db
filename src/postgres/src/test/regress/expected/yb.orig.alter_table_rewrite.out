-- Various expression types.
CREATE DOMAIN pin_dom AS text;
CREATE TABLE pin_test (k int PRIMARY KEY, c varchar(10));
-- Supported.
CREATE INDEX idx_pin_ok_funcexpr ON pin_test (lower(c));
CREATE INDEX idx_pin_ok_opexpr ON pin_test ((c || 'x'));
CREATE INDEX idx_pin_ok_distinctexpr ON pin_test (k) WHERE c IS DISTINCT FROM 'a';
CREATE INDEX idx_pin_ok_nullifexpr ON pin_test ((NULLIF(c, '')));
-- c IN (...) is not reused, so use ANY.
CREATE INDEX idx_pin_ok_scalararrayopexpr ON pin_test (k) WHERE c::text = ANY (ARRAY['a', 'b']);
CREATE INDEX idx_pin_ok_boolexpr ON pin_test (k) WHERE c = 'a' OR c = 'b';
CREATE INDEX idx_pin_ok_caseexpr ON pin_test ((CASE WHEN c = 'a' THEN 1 ELSE 0 END));
CREATE INDEX idx_pin_ok_coalesceexpr ON pin_test ((COALESCE(c, 'x')));
CREATE INDEX idx_pin_ok_minmaxexpr ON pin_test ((GREATEST(c, 'm')));
CREATE INDEX idx_pin_ok_nulltest ON pin_test (k) WHERE c IS NOT NULL;
CREATE INDEX idx_pin_ok_booleantest ON pin_test (k) WHERE (c = 'a') IS NOT TRUE;
CREATE INDEX idx_pin_ok_arrayexpr ON pin_test (k) WHERE ARRAY[c] <> '{}';
CREATE INDEX idx_pin_ok_rowexpr ON pin_test (k) WHERE ROW(c, k) IS NOT NULL;
CREATE INDEX idx_pin_ok_collateexpr ON pin_test (lower(c COLLATE "C"));
-- Not supported.
CREATE INDEX idx_pin_no_coerceviaio ON pin_test (k) WHERE length(c) > 0 AND k::text <> '';
CREATE INDEX idx_pin_no_subscriptingref ON pin_test (k) WHERE (ARRAY[c])[1] <> '';
-- a cast on an ARRAY[...] literal casts its elements, so cast an expression.
CREATE INDEX idx_pin_no_arraycoerceexpr ON pin_test (k) WHERE (ARRAY[c] || ARRAY[c])::text[] <> '{}';
CREATE INDEX idx_pin_no_coercetodomain ON pin_test ((c::pin_dom));
