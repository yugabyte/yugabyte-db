-- Other types. idx_typmod_witness is on a column that is not altered.
CREATE TABLE typmod_test2 (k int PRIMARY KEY, ts timestamp(0), tstz timestamptz(0), t time(0), tz timetz(0),
    iv interval day, vb varbit(8), vu varchar(10), b bit(8), arr varchar(10)[]);
CREATE INDEX idx_typmod_ts_expr ON typmod_test2 (date_trunc('day', ts));
CREATE INDEX idx_typmod_ts_part ON typmod_test2 (k) WHERE ts > '2020-01-01';
CREATE INDEX idx_typmod_tstz_expr ON typmod_test2 ((tstz AT TIME ZONE 'UTC'));
CREATE INDEX idx_typmod_tstz_part ON typmod_test2 (k) WHERE tstz IS NOT NULL;
CREATE INDEX idx_typmod_t_expr ON typmod_test2 ((t + interval '1 hour'));
CREATE INDEX idx_typmod_t_part ON typmod_test2 (k) WHERE t > '00:00';
-- YB does not support timetz or interval index keys.
CREATE INDEX idx_typmod_tz_expr ON typmod_test2 (date_part('hour', tz));
CREATE INDEX idx_typmod_tz_part ON typmod_test2 (k) WHERE tz IS NOT NULL;
CREATE INDEX idx_typmod_iv_expr ON typmod_test2 (date_part('day', iv));
CREATE INDEX idx_typmod_iv_part ON typmod_test2 (k) WHERE iv > interval '0';
CREATE INDEX idx_typmod_vb_expr ON typmod_test2 (length(vb));
CREATE INDEX idx_typmod_vb_part ON typmod_test2 (k) WHERE length(vb) > 0;
CREATE INDEX idx_typmod_vu_expr ON typmod_test2 (lower(vu));
CREATE INDEX idx_typmod_vu_part ON typmod_test2 (k) WHERE vu <> '';
CREATE INDEX idx_typmod_b_expr ON typmod_test2 (length(b));
CREATE INDEX idx_typmod_b_part ON typmod_test2 (k) WHERE b IS NOT NULL;
CREATE INDEX idx_typmod_arr_expr ON typmod_test2 (array_length(arr, 1));
CREATE INDEX idx_typmod_arr_part ON typmod_test2 (k) WHERE cardinality(arr) > 0;
CREATE INDEX idx_typmod_witness ON typmod_test2 (k);
