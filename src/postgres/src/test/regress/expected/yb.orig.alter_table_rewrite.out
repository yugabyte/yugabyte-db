TRUNCATE typmod_idx_info;
-- Only indexes that reference the altered column, including through INCLUDE, are checked.
-- Reuse is turned off to show which.
-- Indexes with whole-row references cannot be built yet (#35808).
CREATE TABLE dep_test (k int PRIMARY KEY, a varchar(10), b varchar(10));
CREATE INDEX idx_dep_expr_a ON dep_test (lower(a));
CREATE INDEX idx_dep_part_a ON dep_test (k) WHERE a <> '';
CREATE INDEX idx_dep_expr_incl_b ON dep_test (lower(a)) INCLUDE (b);
CREATE INDEX idx_dep_part_incl_b ON dep_test (k) INCLUDE (b) WHERE a <> '';
-- expressions are not allowed in INCLUDE.
CREATE INDEX idx_dep_incl_expr ON dep_test (k) INCLUDE (lower(b));
ERROR:  expressions are not supported in included columns
