CALL typmod_idx_snapshot('alter b, reuse on', 'idx_dep_part_a');
CALL typmod_idx_snapshot('alter b, reuse on', 'idx_dep_expr_incl_b');
CALL typmod_idx_snapshot('alter b, reuse on', 'idx_dep_part_incl_b');
