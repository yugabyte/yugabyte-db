CALL typmod_idx_record('varchar(15) -> text', 'idx_typmod_v_part');
CALL typmod_idx_snapshot('numeric(10, 2) -> numeric(12, 2)', 'idx_typmod_n_expr');
CALL typmod_idx_snapshot('numeric(10, 2) -> numeric(12, 2)', 'idx_typmod_n_part');
