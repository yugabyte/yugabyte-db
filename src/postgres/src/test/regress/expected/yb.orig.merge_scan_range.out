--
-- See yb_merge_scan_schedule for details about the test.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/merge_scan_setup.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/parameterized_query.sql'
\i :filename
\set _echo_parameterized_query :ECHO
\set ECHO none
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set P1 ':explain'
\set P2
\set Q1 ':off'
\set Q2 ':on'
-- Small response pages make the execution metrics of the plan variants
-- distinct without growing the tables: at the default page size their rows
-- come back in one read request either way.
SET yb_fetch_row_limit = 16;
-- No order
-- Merge scan should not be used.
\set query ':explain :Q SELECT * FROM r5n WHERE r1 IN (0, 1, 2, 3) LIMIT 5;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT * FROM r5n WHERE r1 IN (0, 1, 2, 3) LIMIT 5;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Limit (actual rows=5 loops=1)
   Output: n, r5, r3, r1, r2, r4
   ->  Index Scan using r5n_pkey on public.r5n (actual rows=5 loops=1)
         Output: n, r5, r3, r1, r2, r4
         Index Cond: (r5n.r1 = ANY ('{0,1,2,3}'::integer[]))
         Storage Table Read Requests: 1
         Storage Table Read Ops: 6
         Storage Table Rows Scanned: 21
(8 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 64)*/ SELECT * FROM r5n WHERE r1 IN (0, 1, 2, 3) LIMIT 5;
(output identical to previous)
-- No limit
\set query ':explain :Q SELECT * FROM r5n WHERE r1 IN (0, 1, 2, 3) ORDER BY r2, r3, r4;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
