   Sort Key: r5n.r2, r5n.r3, r5n.r4
   Sort Method: quicksort
   ->  Index Scan using r5n_pkey on public.r5n (actual rows=1983 loops=1)
         Output: n, r5, r3, r1, r2, r4
         Index Cond: (r5n.r1 = ANY ('{0,1,2,3}'::integer[]))
         Storage Table Read Requests: 32
         Storage Table Read Ops: 128
         Storage Table Rows Scanned: 1983
(10 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 64)*/ SELECT * FROM r5n WHERE r1 IN (0, 1, 2, 3) ORDER BY r2, r3, r4;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Index Scan using r5n_pkey on public.r5n (actual rows=1983 loops=1)
   Output: n, r5, r3, r1, r2, r4
   Index Cond: (r5n.r1 = ANY ('{0,1,2,3}'::integer[]))
