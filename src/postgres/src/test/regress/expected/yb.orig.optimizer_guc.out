-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Seq Scan on pg_class
 Settings: yb_enable_bitmapscan = 'on', yb_parallel_range_rows = '10', yb_enable_update_reltuples_after_create_index = 'on', yb_use_cluster_config_for_geolocation_costing = 'on', yb_enable_cbo = 'on', yb_bnl_optimize_first_batch = 'off', yb_prefer_bnl = 'off', yb_enable_batchednl = 'off', yb_enable_geolocation_costing = 'off', yb_enable_distinct_pushdown = 'off', yb_test_skip_binding_scan_keys = 'on', yb_bnl_batch_size = '1', yb_fetch_row_limit = '0', yb_fetch_size_limit = '2kB', yb_parallel_range_size = '1kB', yb_network_fetch_cost = '100'
(2 rows)

---------------------------------------------------------------------
-- reset all then try a few yb_ parameters that won't affect plans --
---------------------------------------------------------------------
reset all;
explain (settings, costs off)
select * from pg_class;
      QUERY PLAN      
----------------------
 Seq Scan on pg_class
(1 row)

set yb_enable_memory_tracking = off;
set yb_enable_planner_trace = on;
explain (settings, costs off)
select * from pg_class;
      QUERY PLAN      
----------------------
 Seq Scan on pg_class
(1 row)

