CREATE INDEX NONCONCURRENTLY ON bkt_tbl (bkt ASC, r3, r2, r1)
SPLIT AT VALUES (
    (1),
    (2),
    (2, 2),
    (2, 2, 2),
    (2, 2, 2, 2),
    (3));
-- No limit
-- TODO(#29078): this likely should use merge scan.
\set query ':explain :Q SELECT * FROM bkt_tbl ORDER BY r3, r2, r1;'
\i :run_query
