--
-- Test YB's automatic insertion of scalar-array-op conditions for merge scan.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/merge_scan_setup.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/parameterized_query.sql'
\i :filename
\set _echo_parameterized_query :ECHO
\set ECHO none
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set P1 ':explain'
\set P2
\set Q1 ':off'
\set Q2 ':on'
-- Small response pages make the execution metrics of the plan variants
-- distinct without growing the tables: at the default page size their rows
-- come back in one read request either way.
SET yb_fetch_row_limit = 16;
\set off '/*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 64)*/'
SET yb_enable_derived_saops = true;
--
-- Derive from generated column
--
-- No order
-- Merge scan should not be used.
\set query ':explain :Q SELECT * FROM bkt_tbl;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 0)*/ SELECT * FROM bkt_tbl;
                      QUERY PLAN                       
-------------------------------------------------------
 Seq Scan on public.bkt_tbl (actual rows=5048 loops=1)
   Output: n, r5, r3, r1, r2, r4, bkt
   Storage Table Read Requests: 107
   Storage Table Read Ops: 321
   Storage Table Rows Scanned: 5048
(5 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 64)*/ SELECT * FROM bkt_tbl;
(output identical to previous)
-- No limit
\set query ':explain :Q SELECT * FROM bkt_tbl ORDER BY r1, r2, r3;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 0)*/ SELECT * FROM bkt_tbl ORDER BY r1, r2, r3;
                         QUERY PLAN                          
-------------------------------------------------------------
 Sort (actual rows=5048 loops=1)
   Output: n, r5, r3, r1, r2, r4, bkt
   Sort Key: bkt_tbl.r1, bkt_tbl.r2, bkt_tbl.r3
   Sort Method: quicksort
   ->  Seq Scan on public.bkt_tbl (actual rows=5048 loops=1)
         Output: n, r5, r3, r1, r2, r4, bkt
         Storage Table Read Requests: 107
         Storage Table Read Ops: 321
         Storage Table Rows Scanned: 5048
(9 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(enable_parallel_append off) Set(yb_max_merge_scan_streams 64)*/ SELECT * FROM bkt_tbl ORDER BY r1, r2, r3;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Index Scan using bkt_tbl_pkey on public.bkt_tbl (actual rows=5048 loops=1)
   Output: n, r5, r3, r1, r2, r4, bkt
   Index Cond: (bkt_tbl.bkt = ANY ('{0,1,2}'::integer[]))
   Merge Sort Key: bkt_tbl.r1, bkt_tbl.r2, bkt_tbl.r3
   Merge Stream Key: bkt_tbl.bkt
   Merge Streams: 3
   Merge Cond: (bkt_tbl.bkt = ANY ('{0,1,2}'::integer[]))
   Storage Table Read Requests: 107
   Storage Table Read Ops: 320
   Storage Table Rows Scanned: 5048
(10 rows)

