  id1 int4range,
  id2 int4range,
  valid_at daterange,
  CONSTRAINT temporal_rng2_pk PRIMARY KEY (id1, id2, valid_at WITHOUT OVERLAPS)
);
\o :yb_desc_output_file
\d temporal_rng2
\o :yb_stdout
:yb_replace_temp_schema_name
regexp_replace
