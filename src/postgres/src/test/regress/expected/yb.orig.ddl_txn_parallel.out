--
-- GH #30978: a parallel worker reads only committed catalog rows, so a
-- parallel query after a DDL in the same transaction block runs in the
-- leader alone. Scenario: BEGIN, ALTER TABLE ADD COLUMN c, then a parallel
-- scan that filters on c. A worker launched there fails with "invalid
-- attnum 3 for relation".
--
SET yb_enable_cbo = on;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET yb_parallel_range_rows = 1;
CREATE TABLE ddl_par (id INT, name TEXT, PRIMARY KEY (id ASC));
INSERT INTO ddl_par SELECT i, 'n' || i FROM generate_series(1, 1000) i;
ANALYZE ddl_par;
BEGIN;
ALTER TABLE ddl_par ADD COLUMN c TEXT DEFAULT 'g';
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
                  QUERY PLAN                   
-----------------------------------------------
 Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Parallel Seq Scan on ddl_par
               Storage Filter: (c = 'g'::text)
(5 rows)

-- The plan keeps its Gather, but no worker is launched.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
                             QUERY PLAN                              
---------------------------------------------------------------------
 Aggregate (actual rows=1 loops=1)
   ->  Gather (actual rows=1000 loops=1)
         Workers Planned: 2
         Workers Launched: 0
         ->  Parallel Seq Scan on ddl_par (actual rows=1000 loops=1)
               Storage Filter: (c = 'g'::text)
(6 rows)

SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
 count 
-------
  1000
(1 row)

ROLLBACK;
DROP TABLE ddl_par;
-- GH #34740: a parallel scan of a table created earlier in the same
-- transaction block must not fail with "relation with OID ... does not
-- exist".
SET force_parallel_mode = on;
BEGIN;
CREATE TABLE ddl_par_new (k INT);
INSERT INTO ddl_par_new VALUES (1), (2);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par_new;
                     QUERY PLAN                     
----------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Seq Scan on ddl_par_new
                     Partial Aggregate: true
(6 rows)

SELECT COUNT(*) FROM ddl_par_new;
 count 
-------
     2
(1 row)

ROLLBACK;
RESET force_parallel_mode;
