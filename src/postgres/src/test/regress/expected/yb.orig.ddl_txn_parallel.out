--
-- GH #30978: once a DDL has run in a transaction block, the block makes no
-- parallel plan and launches no parallel workers. This is needed until
-- parallel workers stop reading the catalog in legacy mode (see
-- YBCIsLegacyModeForCatalogOps). In legacy mode, workers do not see the
-- uncommitted catalog writes of earlier DDLs in the block.
-- yb_disable_parallel_query_after_ddl = off turns this off; it is on here
-- except in the case that tests it.
-- Scenario: BEGIN, ALTER TABLE ADD COLUMN c, then a scan that filters on c.
-- A worker launched there fails with "invalid attnum 3 for relation".
--
SET yb_enable_cbo = on;
SET force_parallel_mode = on;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET yb_parallel_range_rows = 1;
CREATE TABLE ddl_par (id INT, name TEXT, PRIMARY KEY (id ASC));
INSERT INTO ddl_par SELECT i, 'n' || i FROM generate_series(1, 1000) i;
ANALYZE ddl_par;
-- A generic plan cached before the block is parallel; the ALTER TABLE
-- invalidates it, and the replanned query has no Gather.
PREPARE ddl_par_count AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_count;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

BEGIN;
ALTER TABLE ddl_par ADD COLUMN c TEXT DEFAULT 'g';
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
               QUERY PLAN                
-----------------------------------------
 Finalize Aggregate
   ->  Seq Scan on ddl_par
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
                    QUERY PLAN                     
---------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Seq Scan on ddl_par (actual rows=1 loops=1)
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

SELECT COUNT(*) FROM ddl_par WHERE c = 'g';
 count 
-------
  1000
(1 row)

EXPLAIN (COSTS OFF) EXECUTE ddl_par_count;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE ddl_par_count;
                                 QUERY PLAN                                  
-----------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Index Only Scan using ddl_par_pkey on ddl_par (actual rows=1 loops=1)
         Heap Fetches: 0
         Partial Aggregate: true
(4 rows)

EXECUTE ddl_par_count;
 count 
-------
  1000
(1 row)

ROLLBACK;
DEALLOCATE ddl_par_count;
-- Once the block ends, queries get parallel plans again, whether the block
-- rolled back (above) or committed.
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

BEGIN;
CREATE TABLE ddl_par_commit (k INT);
COMMIT;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DROP TABLE ddl_par_commit;
-- A generic plan first built after the DDL has no Gather. It depends on
-- nothing the block changed, so once the block ends it must still be
-- replanned, or it stays serial for the rest of the session.
BEGIN;
CREATE TABLE ddl_par_after_t (k INT);
PREPARE ddl_par_after AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_after;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

COMMIT;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_after;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_after;
DROP TABLE ddl_par_after_t;
-- The same with an ALTER TABLE on a table the plan does not use: the plan
-- has no dependency on what the block changed, yet it must still get its
-- Gather back after COMMIT.
CREATE TABLE ddl_par_other (k INT);
BEGIN;
ALTER TABLE ddl_par_other ADD COLUMN x INT;
PREPARE ddl_par_alter AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_alter;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

COMMIT;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_alter;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_alter;
-- The same after ROLLBACK.
BEGIN;
ALTER TABLE ddl_par_other ADD COLUMN y INT;
PREPARE ddl_par_rb AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_rb;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

ROLLBACK;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_rb;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_rb;
-- The same when the block's only DDL replaces a function the plan does not
-- call. Nothing invalidates the plan, so the plan cache must replan it once
-- the block ends, after COMMIT and after ROLLBACK. Inside the block it stays
-- serial.
CREATE FUNCTION ddl_par_noop() RETURNS INT LANGUAGE sql AS 'SELECT 1';
BEGIN;
CREATE OR REPLACE FUNCTION ddl_par_noop() RETURNS INT LANGUAGE sql
  AS 'SELECT 2';
PREPARE ddl_par_fn_c AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_fn_c;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

EXPLAIN (COSTS OFF) EXECUTE ddl_par_fn_c;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

COMMIT;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_fn_c;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_fn_c;
BEGIN;
CREATE OR REPLACE FUNCTION ddl_par_noop() RETURNS INT LANGUAGE sql
  AS 'SELECT 3';
PREPARE ddl_par_fn_r AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_fn_r;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

ROLLBACK;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_fn_r;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_fn_r;
DROP FUNCTION ddl_par_noop();
-- Generic plans cached before the block keep their Gather when the block's
-- only DDL replaces a function they do not call, and run in the leader with
-- no workers. Without workers no shared scan state is set up, so each
-- parallel scan must read the whole table alone: both counts are 1000.
CREATE FUNCTION ddl_par_unused() RETURNS INT LANGUAGE sql AS 'SELECT 1';
PREPARE ddl_par_seq AS SELECT COUNT(*) FROM ddl_par WHERE name LIKE 'n%';
PREPARE ddl_par_idx AS SELECT COUNT(name) FROM ddl_par WHERE id > 0;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_seq;
                        QUERY PLAN                        
----------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Seq Scan on ddl_par
                     Storage Filter: (name ~~ 'n%'::text)
                     Partial Aggregate: true
(7 rows)

EXPLAIN (COSTS OFF) EXECUTE ddl_par_idx;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Scan using ddl_par_pkey on ddl_par
                     Index Cond: (id > 0)
                     Partial Aggregate: true
(7 rows)

BEGIN;
CREATE OR REPLACE FUNCTION ddl_par_unused() RETURNS INT LANGUAGE sql
  AS 'SELECT 2';
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE ddl_par_seq;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Gather (actual rows=1 loops=1)
         Workers Planned: 2
         Workers Launched: 0
         ->  Noop Aggregate (actual rows=1 loops=1)
               ->  Parallel Seq Scan on ddl_par (actual rows=1 loops=1)
                     Storage Filter: (name ~~ 'n%'::text)
                     Partial Aggregate: true
(8 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE ddl_par_idx;
                                         QUERY PLAN                                          
---------------------------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Gather (actual rows=1 loops=1)
         Workers Planned: 2
         Workers Launched: 0
         ->  Noop Aggregate (actual rows=1 loops=1)
               ->  Parallel Index Scan using ddl_par_pkey on ddl_par (actual rows=1 loops=1)
                     Index Cond: (id > 0)
                     Partial Aggregate: true
(8 rows)

EXECUTE ddl_par_seq;
 count 
-------
  1000
(1 row)

EXECUTE ddl_par_idx;
 count 
-------
  1000
(1 row)

ROLLBACK;
DEALLOCATE ddl_par_seq;
DEALLOCATE ddl_par_idx;
-- The same for a Gather Merge: no workers, and the leader still returns the
-- rows in order.
PREPARE ddl_par_gm AS SELECT name FROM ddl_par ORDER BY name LIMIT 3;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_gm;
                   QUERY PLAN                   
------------------------------------------------
 Limit
   ->  Gather Merge
         Workers Planned: 2
         ->  Sort
               Sort Key: name
               ->  Parallel Seq Scan on ddl_par
(6 rows)

BEGIN;
CREATE OR REPLACE FUNCTION ddl_par_unused() RETURNS INT LANGUAGE sql
  AS 'SELECT 3';
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE ddl_par_gm;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Limit (actual rows=3 loops=1)
   ->  Gather Merge (actual rows=3 loops=1)
         Workers Planned: 2
         Workers Launched: 0
         ->  Sort (actual rows=3 loops=1)
               Sort Key: name
               Sort Method: top-N heapsort
               ->  Parallel Seq Scan on ddl_par (actual rows=1000 loops=1)
(8 rows)

EXECUTE ddl_par_gm;
 name 
------
 n1
 n10
 n100
(3 rows)

ROLLBACK;
DEALLOCATE ddl_par_gm;
DROP FUNCTION ddl_par_unused();
-- CREATE INDEX in a block builds the index nonconcurrently and marks the
-- block like any other DDL: no Gather after it.
BEGIN;
CREATE INDEX ddl_par_other_k ON ddl_par_other (k);
NOTICE:  making create index for table "ddl_par_other" nonconcurrent
DETAIL:  Create index in transaction block cannot be concurrent.
HINT:  Consider running it outside of a transaction block. See https://github.com/yugabyte/yugabyte-db/issues/6240.
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

ROLLBACK;
DROP TABLE ddl_par_other;
-- yb_disable_parallel_query_after_ddl = off turns the checks off: after a DDL
-- that touches nothing the query reads, the query gets a parallel plan in the
-- same block. The setting cannot change inside a block, so every plan cached
-- in a block was made under one setting.
SET yb_disable_parallel_query_after_ddl = off;
BEGIN;
CREATE TABLE ddl_par_guc (k INT);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

SELECT COUNT(*) FROM ddl_par;
 count 
-------
  1000
(1 row)

SET yb_disable_parallel_query_after_ddl = on;
ERROR:  invalid value for parameter "yb_disable_parallel_query_after_ddl": 1
DETAIL:  Cannot be set within a txn block.
ROLLBACK;
RESET yb_disable_parallel_query_after_ddl;
BEGIN;
CREATE TABLE ddl_par_guc (k INT);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

ROLLBACK;
-- A DDL outside a block ends with its own implicit commit, so the next query
-- gets a parallel plan.
CREATE TABLE ddl_par_auto (k INT);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DROP TABLE ddl_par_auto;
-- GH #30978 as filed ran in REPEATABLE READ and rolled back to a savepoint
-- taken after the DDL. The DDL before the savepoint stays, so the block
-- still has uncommitted catalog rows and the query gets no parallel plan.
-- This schedule turns DDL savepoint support off (#33497), so no DDL runs
-- after the savepoint here.
CREATE TABLE ddl_par_sp (id INT, PRIMARY KEY (id ASC));
INSERT INTO ddl_par_sp SELECT i FROM generate_series(1, 1000) i;
ANALYZE ddl_par_sp;
BEGIN ISOLATION LEVEL REPEATABLE READ;
ALTER TABLE ddl_par_sp ADD COLUMN c TEXT DEFAULT 'g';
SAVEPOINT s1;
UPDATE ddl_par_sp SET c = 'special' WHERE id <= 10;
ROLLBACK TO SAVEPOINT s1;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par_sp WHERE c = 'g';
               QUERY PLAN                
-----------------------------------------
 Finalize Aggregate
   ->  Seq Scan on ddl_par_sp
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  SELECT COUNT(*) FROM ddl_par_sp WHERE c = 'g';
                      QUERY PLAN                      
------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Seq Scan on ddl_par_sp (actual rows=1 loops=1)
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

SELECT COUNT(*) FROM ddl_par_sp WHERE c = 'g';
 count 
-------
  1000
(1 row)

ROLLBACK;
DROP TABLE ddl_par_sp;
-- A temp-table DDL also turns off parallel query for the rest of the block,
-- even for queries on permanent tables, although workers never read temp
-- tables. This block also skips the catalog version bump, so a generic plan
-- made in it must still be replanned with a Gather after COMMIT.
BEGIN;
CREATE TEMP TABLE ddl_par_tmp (k INT);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

PREPARE ddl_par_tmp_q AS SELECT COUNT(*) FROM ddl_par;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_tmp_q;
                     QUERY PLAN                      
-----------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_par_pkey on ddl_par
         Partial Aggregate: true
(3 rows)

COMMIT;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_tmp_q;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_par_pkey on ddl_par
                     Partial Aggregate: true
(6 rows)

DEALLOCATE ddl_par_tmp_q;
DROP TABLE ddl_par_tmp;
-- CREATE TABLE AS is a DDL, so it sets the flag before it plans its query.
-- With transactional DDL on, yb_disable_parallel_query_in_ddl = off then
-- brings no parallel plan back while yb_disable_parallel_query_after_ddl is on.
SET yb_disable_parallel_query_in_ddl = off;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  CREATE TABLE ddl_par_ctas AS SELECT COUNT(*) FROM ddl_par;
                                 QUERY PLAN                                  
-----------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Index Only Scan using ddl_par_pkey on ddl_par (actual rows=1 loops=1)
         Heap Fetches: 0
         Partial Aggregate: true
(4 rows)

RESET yb_disable_parallel_query_in_ddl;
DROP TABLE ddl_par_ctas;
DROP TABLE ddl_par;
-- GH #34740: a parallel scan of a table created earlier in the same
-- transaction block must not fail with "relation with OID ... does not
-- exist".
BEGIN;
CREATE TABLE ddl_par_new (k INT) SPLIT INTO 1 TABLETS;
INSERT INTO ddl_par_new VALUES (1), (2);
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_par_new;
           QUERY PLAN            
---------------------------------
 Finalize Aggregate
   ->  Seq Scan on ddl_par_new
         Partial Aggregate: true
(3 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) SELECT COUNT(*) FROM ddl_par_new;
                      QUERY PLAN                       
-------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Seq Scan on ddl_par_new (actual rows=1 loops=1)
         Partial Aggregate: true
(3 rows)

SELECT COUNT(*) FROM ddl_par_new;
 count 
-------
     2
(1 row)

ROLLBACK;
-- A plan cached before the block keeps its Gather when the block's DDL
-- changes nothing the plan depends on. The plan depends on f only, so
-- replacing g, which f calls, does not invalidate it. Workers read the
-- committed catalog and would run the old g. With leader participation off,
-- every row goes through a worker, so a wrong run sums to 1000; the correct
-- sum in the block is 2000. The same query planned in the block has no
-- Gather. The cached plan keeps its Gather, but must launch no workers.
SET parallel_leader_participation = off;
CREATE TABLE ddl_par_gap (k INT, PRIMARY KEY (k ASC));
INSERT INTO ddl_par_gap SELECT i FROM generate_series(1, 1000) i;
ANALYZE ddl_par_gap;
CREATE FUNCTION ddl_par_g() RETURNS INT LANGUAGE sql PARALLEL SAFE
  AS 'SELECT 1';
CREATE FUNCTION ddl_par_f(INT) RETURNS INT LANGUAGE plpgsql PARALLEL SAFE
  AS $$ BEGIN RETURN ddl_par_g(); END $$;
PREPARE ddl_par_sum AS SELECT SUM(ddl_par_f(k)) FROM ddl_par_gap;
EXPLAIN (COSTS OFF) EXECUTE ddl_par_sum;
                     QUERY PLAN                     
----------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Partial Aggregate
               ->  Parallel Seq Scan on ddl_par_gap
(5 rows)

EXECUTE ddl_par_sum;
 sum  
------
 1000
(1 row)

BEGIN;
CREATE OR REPLACE FUNCTION ddl_par_g() RETURNS INT LANGUAGE sql PARALLEL SAFE
  AS 'SELECT 2';
SELECT ddl_par_g();
 ddl_par_g 
-----------
         2
(1 row)

EXPLAIN (COSTS OFF) SELECT SUM(ddl_par_f(k)) FROM ddl_par_gap;
          QUERY PLAN           
-------------------------------
 Aggregate
   ->  Seq Scan on ddl_par_gap
(2 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  SELECT SUM(ddl_par_f(k)) FROM ddl_par_gap;
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate (actual rows=1 loops=1)
   ->  Seq Scan on ddl_par_gap (actual rows=1000 loops=1)
(2 rows)

SELECT SUM(ddl_par_f(k)) FROM ddl_par_gap;
 sum  
------
 2000
(1 row)

EXPLAIN (COSTS OFF) EXECUTE ddl_par_sum;
                     QUERY PLAN                     
----------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Partial Aggregate
               ->  Parallel Seq Scan on ddl_par_gap
(5 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) EXECUTE ddl_par_sum;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Gather (actual rows=1 loops=1)
         Workers Planned: 2
         Workers Launched: 0
         ->  Partial Aggregate (actual rows=1 loops=1)
               ->  Parallel Seq Scan on ddl_par_gap (actual rows=1000 loops=1)
(6 rows)

EXECUTE ddl_par_sum;
 sum  
------
 2000
(1 row)

ROLLBACK;
DEALLOCATE ddl_par_sum;
RESET parallel_leader_participation;
DROP FUNCTION ddl_par_f(INT);
DROP FUNCTION ddl_par_g();
DROP TABLE ddl_par_gap;
RESET force_parallel_mode;
