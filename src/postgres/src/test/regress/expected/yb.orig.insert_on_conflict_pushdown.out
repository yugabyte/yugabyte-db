--- Unsupported cases
-- DO UPDATE.
CREATE TABLE pd_do_update (id int PRIMARY KEY, val int);
INSERT INTO pd_do_update VALUES (1, 10);
SELECT ioc_pushdown($$INSERT INTO pd_do_update VALUES (1, 20) ON CONFLICT (id) DO UPDATE SET val = excluded.val$$);
 ioc_pushdown 
--------------
 fallback
(1 row)

SELECT * FROM pd_do_update ORDER BY id;   -- updated to (1,20): DO UPDATE still works via fallback
