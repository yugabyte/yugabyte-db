----------
 fallback
(1 row)

SELECT ioc_plan($$INSERT INTO pd_do_update VALUES (1, 0) ON CONFLICT (id) DO UPDATE SET val = pd_do_update.val + 1 WHERE pd_do_update.val > 0$$);
