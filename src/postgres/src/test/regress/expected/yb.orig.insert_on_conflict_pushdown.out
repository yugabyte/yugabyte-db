-- An auto-updatable view is rewritten to target its base table, allowing
-- pushdown.
CREATE TABLE pd_view_base (id int PRIMARY KEY, val int);
CREATE VIEW pd_view AS SELECT * FROM pd_view_base;
INSERT INTO pd_view_base VALUES (1, 10);
SELECT ioc_pushdown($$INSERT INTO pd_view VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

SELECT ioc_pushdown($$INSERT INTO pd_view VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

SELECT * FROM pd_view_base ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

-- A view with an INSTEAD OF INSERT trigger remains the target, so pushdown
-- falls back.  Use the plan because the trigger body issues storage requests.
-- An arbiter cannot be inferred on a view, so use bare DO NOTHING.  ExecInsert
-- returns after firing the trigger, so duplicate handling happens in the
-- trigger body.
CREATE TABLE pd_view_trig_base (id int PRIMARY KEY, val int);
CREATE VIEW pd_view_trig AS SELECT * FROM pd_view_trig_base;
CREATE FUNCTION pd_view_trig_fn() RETURNS trigger LANGUAGE plpgsql AS
  $$ BEGIN INSERT INTO pd_view_trig_base VALUES (NEW.id, NEW.val)
       ON CONFLICT DO NOTHING; RETURN NEW; END; $$;
CREATE TRIGGER pd_view_trig_ii INSTEAD OF INSERT ON pd_view_trig
  FOR EACH ROW EXECUTE FUNCTION pd_view_trig_fn();
INSERT INTO pd_view_trig_base VALUES (1, 10);
SELECT ioc_plan($$INSERT INTO pd_view_trig VALUES (1, 99) ON CONFLICT DO NOTHING$$);
 ioc_plan 
----------
 fallback
(1 row)

INSERT INTO pd_view_trig VALUES (1, 99) ON CONFLICT DO NOTHING;
INSERT INTO pd_view_trig VALUES (2, 20) ON CONFLICT DO NOTHING;
SELECT * FROM pd_view_trig_base ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

--- Prepared statements
-- Adding an index invalidates the cached plan and disables pushdown.
CREATE TABLE pd_prep_ddl (id int PRIMARY KEY, val int);
INSERT INTO pd_prep_ddl VALUES (1, 10);
PREPARE pd_prep_ddl_p (int, int) AS INSERT INTO pd_prep_ddl VALUES ($1, $2) ON CONFLICT (id) DO NOTHING;
-- Execute enough times to select a generic plan.
EXECUTE pd_prep_ddl_p (2, 20);
EXECUTE pd_prep_ddl_p (3, 30);
EXECUTE pd_prep_ddl_p (4, 40);
EXECUTE pd_prep_ddl_p (5, 50);
EXECUTE pd_prep_ddl_p (6, 60);
SELECT ioc_pushdown($$EXECUTE pd_prep_ddl_p (1, 99)$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

CREATE INDEX pd_prep_ddl_val_idx ON pd_prep_ddl (val);
SELECT ioc_pushdown($$EXECUTE pd_prep_ddl_p (1, 99)$$);
 ioc_pushdown 
--------------
 fallback
(1 row)

EXECUTE pd_prep_ddl_p (7, 70);
SELECT * FROM pd_prep_ddl WHERE val = 70 ORDER BY id;
 id | val 
----+-----
  7 |  70
(1 row)

SELECT * FROM pd_prep_ddl WHERE val = 99;
 id | val 
----+-----
(0 rows)

SELECT * FROM pd_prep_ddl ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
  3 |  30
  4 |  40
  5 |  50
  6 |  60
  7 |  70
(7 rows)

