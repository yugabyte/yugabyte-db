--
-- INSERT ... ON CONFLICT DO NOTHING pushdown
--
-- For eligible single-row inserts, DocDB resolves the conflict as part of the
-- write and avoids a separate conflict-check read.  Most tests below check the
-- path using the storage read count:
--   pushdown: no storage reads
--   fallback: one or more storage reads
--
-- ioc_plan() is used when the storage read count cannot distinguish the paths.
-- Keep this test independent of yb_insert_on_conflict_read_batch_size because
-- it runs as part of the existing INSERT ON CONFLICT schedule.
-- Pushdown is enabled for the whole file; individual sections turn it off when
-- exercising the fallback path.
-- Execute cmd and identify the path from its storage read count.
CREATE FUNCTION ioc_pushdown(cmd text) RETURNS text
  LANGUAGE plpgsql AS $$
DECLARE
  ln text;
  reads int := 0;
BEGIN
  FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, DIST, COSTS OFF, TIMING OFF) ' || cmd
  LOOP
    ln := btrim(ln);
    IF ln LIKE 'Storage Read Requests:%' THEN
      reads := btrim(split_part(ln, ':', 2))::int;
    END IF;
  END LOOP;
  RETURN CASE WHEN reads = 0 THEN 'pushdown' ELSE 'fallback' END;
END;
$$;
-- Return the affected-row count: 1 for an insert and 0 for a skipped row.
CREATE FUNCTION ins_count(cmd text) RETURNS bigint
  LANGUAGE plpgsql AS $$
DECLARE
  n bigint;
BEGIN
  EXECUTE cmd;
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n;
END;
$$;
-- Check the plan without executing cmd.  This is needed for tables where neither
-- path issues a storage read, such as a table without an index.
CREATE FUNCTION ioc_plan(cmd text) RETURNS text
  LANGUAGE plpgsql AS $$
DECLARE
  ln text;
BEGIN
  FOR ln IN EXECUTE 'EXPLAIN (COSTS OFF) ' || cmd
  LOOP
    IF btrim(ln) LIKE 'Conflict Resolution Pushdown:%' THEN
      RETURN 'pushdown';
    END IF;
  END LOOP;
  RETURN 'fallback';
END;
$$;
-- Return the inserted and conflicting tuple counts reported by EXPLAIN ANALYZE.
CREATE FUNCTION ioc_tuples(cmd text) RETURNS text
  LANGUAGE plpgsql AS $$
DECLARE
  ln text;
  ins text := 'none';
  conf text := 'none';
BEGIN
  FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF) ' || cmd
  LOOP
    ln := btrim(ln);
    IF ln LIKE 'Tuples Inserted:%' THEN
      ins := btrim(split_part(ln, ':', 2));
    ELSIF ln LIKE 'Conflicting Tuples:%' THEN
      conf := btrim(split_part(ln, ':', 2));
    END IF;
  END LOOP;
  RETURN format('inserted=%s conflicting=%s', ins, conf);
END;
$$;
-- Execute cmd and return the transaction type reported by EXPLAIN ANALYZE.
CREATE FUNCTION ioc_txn(cmd text) RETURNS text
  LANGUAGE plpgsql AS $$
DECLARE
  ln text;
BEGIN
  FOR ln IN EXECUTE 'EXPLAIN (ANALYZE, DIST, COSTS OFF, TIMING OFF) ' || cmd
  LOOP
    IF btrim(ln) LIKE 'Transaction: Fast Path%' THEN
      RETURN 'fast_path';
    END IF;
  END LOOP;
  RETURN 'distributed';
END;
$$;
SET yb_enable_ioc_do_nothing_pushdown = on;
--- Basic
CREATE TABLE pd_basic (id int PRIMARY KEY, val int);
INSERT INTO pd_basic VALUES (1, 10);
-- Disabling the feature uses the regular ON CONFLICT path.
SET yb_enable_ioc_do_nothing_pushdown = off;
SELECT ioc_pushdown($$INSERT INTO pd_basic VALUES (1, 999) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 fallback
(1 row)

SELECT * FROM pd_basic ORDER BY id;
 id | val 
----+-----
  1 |  10
(1 row)

SET yb_enable_ioc_do_nothing_pushdown = on;
-- Insert a new row.
SELECT ioc_pushdown($$INSERT INTO pd_basic VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

SELECT * FROM pd_basic ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

-- Skip a conflicting row.
SELECT ioc_pushdown($$INSERT INTO pd_basic VALUES (1, 999) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

SELECT * FROM pd_basic ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

-- Check the affected-row count for an insert and a skip.
SELECT ins_count($$INSERT INTO pd_basic VALUES (3, 30) ON CONFLICT (id) DO NOTHING$$) AS n;  -- 1
 n 
---
 1
(1 row)

SELECT ins_count($$INSERT INTO pd_basic VALUES (3, 31) ON CONFLICT (id) DO NOTHING$$) AS n;  -- 0
 n 
---
 0
(1 row)

SELECT * FROM pd_basic ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
  3 |  30
(3 rows)

