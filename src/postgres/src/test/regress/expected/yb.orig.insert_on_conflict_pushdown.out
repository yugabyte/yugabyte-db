-- BEFORE ROW trigger.
CREATE TABLE pd_bef_trig (id int PRIMARY KEY, val int);
CREATE FUNCTION pd_bef_trig_fn() RETURNS trigger LANGUAGE plpgsql AS
  $$ BEGIN RETURN NEW; END; $$;
CREATE TRIGGER pd_bef_trig_bi BEFORE INSERT ON pd_bef_trig FOR EACH ROW EXECUTE FUNCTION pd_bef_trig_fn();
INSERT INTO pd_bef_trig VALUES (1, 10);
