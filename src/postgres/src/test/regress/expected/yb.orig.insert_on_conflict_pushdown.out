--- Read batching
-- Set the batch size explicitly because this test runs under several batch-size
-- configurations.
SET yb_insert_on_conflict_read_batch_size = 2;
CREATE TABLE pd_batch (id int PRIMARY KEY, val int);
INSERT INTO pd_batch VALUES (1, 10);
-- Single-row inserts use pushdown.
SELECT ioc_pushdown($$INSERT INTO pd_batch VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

SELECT ioc_pushdown($$INSERT INTO pd_batch VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

-- Multi-row inserts use the batched fallback path.
SELECT ioc_plan($$INSERT INTO pd_batch VALUES (2, 99), (3, 30), (4, 40) ON CONFLICT (id) DO NOTHING$$);
 ioc_plan 
----------
 fallback
(1 row)

SELECT ins_count($$INSERT INTO pd_batch VALUES (2, 99), (3, 30), (4, 40) ON CONFLICT (id) DO NOTHING$$) AS n;  -- 2
 n 
---
 2
(1 row)

SELECT * FROM pd_batch ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
  3 |  30
  4 |  40
(4 rows)

RESET yb_insert_on_conflict_read_batch_size;
--- Tuple accounting
-- RETURNING uses the locally generated row, including default and generated
-- values.
CREATE TABLE pd_tup_def (id int PRIMARY KEY, val int DEFAULT 42,
                 val_dbl int GENERATED ALWAYS AS (val * 2) STORED);
INSERT INTO pd_tup_def (id, val) VALUES (1, 10);
INSERT INTO pd_tup_def (id) VALUES (2) ON CONFLICT (id) DO NOTHING RETURNING *;
 id | val | val_dbl 
----+-----+---------
  2 |  42 |      84
(1 row)

INSERT INTO pd_tup_def (id) VALUES (2) ON CONFLICT (id) DO NOTHING RETURNING *;
 id | val | val_dbl 
----+-----+---------
(0 rows)

SELECT * FROM pd_tup_def ORDER BY id;
 id | val | val_dbl 
----+-----+---------
  1 |  10 |      20
  2 |  42 |      84
(2 rows)

-- Tuple counts for an insert and a skip.
CREATE TABLE pd_tup_cnt (id int PRIMARY KEY, val int);
INSERT INTO pd_tup_cnt VALUES (1, 10);
SELECT ioc_tuples($$INSERT INTO pd_tup_cnt VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
        ioc_tuples        
--------------------------
 inserted=1 conflicting=0
(1 row)

SELECT ioc_tuples($$INSERT INTO pd_tup_cnt VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
        ioc_tuples        
--------------------------
 inserted=0 conflicting=1
(1 row)

SELECT * FROM pd_tup_cnt ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

-- Source produces no rows.
CREATE TABLE pd_empty_src (id int PRIMARY KEY, val int);
SELECT ioc_plan($$INSERT INTO pd_empty_src SELECT 1, 10 WHERE false ON CONFLICT (id) DO NOTHING$$);
 ioc_plan 
----------
 pushdown
(1 row)

SELECT ins_count($$INSERT INTO pd_empty_src SELECT 1, 10 WHERE false ON CONFLICT (id) DO NOTHING$$) AS n;  -- 0
 n 
---
 0
(1 row)

INSERT INTO pd_empty_src SELECT 1, 10 WHERE false ON CONFLICT (id) DO NOTHING RETURNING *;
 id | val 
----+-----
(0 rows)

SELECT count(*) FROM pd_empty_src;
 count 
-------
     0
(1 row)

--- Checks before pushdown
-- NULL primary key.
CREATE TABLE pd_null_pk (id int PRIMARY KEY, val int);
INSERT INTO pd_null_pk VALUES (1, 10);
INSERT INTO pd_null_pk VALUES (NULL, 1) ON CONFLICT (id) DO NOTHING;
ERROR:  null value in column "id" of relation "pd_null_pk" violates not-null constraint
DETAIL:  Failing row contains (null, 1).
SELECT * FROM pd_null_pk ORDER BY id;
 id | val 
----+-----
  1 |  10
(1 row)

-- Row-level security policy.
CREATE TABLE pd_rls (id int PRIMARY KEY, val int);
INSERT INTO pd_rls VALUES (1, 10);
ALTER TABLE pd_rls ENABLE ROW LEVEL SECURITY;
CREATE POLICY pd_rls_policy ON pd_rls FOR ALL USING (true) WITH CHECK (val > 0);
CREATE USER pd_rls_user;
GRANT SELECT, INSERT ON pd_rls TO pd_rls_user;
SET ROLE pd_rls_user;
SELECT ioc_plan($$INSERT INTO pd_rls VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
 ioc_plan 
----------
 pushdown
(1 row)

INSERT INTO pd_rls VALUES (2, 0) ON CONFLICT (id) DO NOTHING;   -- policy violation
ERROR:  new row violates row-level security policy for table "pd_rls"
INSERT INTO pd_rls VALUES (1, 0) ON CONFLICT (id) DO NOTHING;   -- policy violation on a conflicting key
ERROR:  new row violates row-level security policy for table "pd_rls"
INSERT INTO pd_rls VALUES (2, 20) ON CONFLICT (id) DO NOTHING;  -- allowed, inserted
INSERT INTO pd_rls VALUES (1, 99) ON CONFLICT (id) DO NOTHING;  -- allowed, skipped
RESET ROLE;
SELECT * FROM pd_rls ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
(2 rows)

REVOKE ALL ON pd_rls FROM pd_rls_user;
DROP USER pd_rls_user;
--- Fast path
-- An eligible autocommit insert can use a single-shard transaction.
CREATE TABLE pd_fast (id int PRIMARY KEY, val int);
INSERT INTO pd_fast VALUES (1, 10);
-- Control case.
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (100, 100)$$);
  ioc_txn  
-----------
 fast_path
(1 row)

-- Insert a new row.
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (2, 20) ON CONFLICT (id) DO NOTHING$$);
  ioc_txn  
-----------
 fast_path
(1 row)

SELECT * FROM pd_fast WHERE id = 2;
 id | val 
----+-----
  2 |  20
(1 row)

-- Skip a conflicting row.
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
  ioc_txn  
-----------
 fast_path
(1 row)

SELECT * FROM pd_fast WHERE id = 1;
 id | val 
----+-----
  1 |  10
(1 row)

-- Pushdown disabled.
SET yb_enable_ioc_do_nothing_pushdown = off;
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
   ioc_txn   
-------------
 distributed
(1 row)

SELECT ioc_pushdown($$INSERT INTO pd_fast VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 fallback
(1 row)

SET yb_enable_ioc_do_nothing_pushdown = on;
-- Explicit transaction block.
BEGIN;
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (3, 30) ON CONFLICT (id) DO NOTHING$$);
   ioc_txn   
-------------
 distributed
(1 row)

SELECT ioc_pushdown($$INSERT INTO pd_fast VALUES (4, 40) ON CONFLICT (id) DO NOTHING$$);
 ioc_pushdown 
--------------
 pushdown
(1 row)

COMMIT;
SELECT * FROM pd_fast WHERE id IN (3, 4) ORDER BY id;
 id | val 
----+-----
  3 |  30
  4 |  40
(2 rows)

-- Secondary index disqualifies pushdown and fast path.
CREATE INDEX pd_fast_val_idx ON pd_fast (val);
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (1, 99) ON CONFLICT (id) DO NOTHING$$);
   ioc_txn   
-------------
 distributed
(1 row)

DROP INDEX pd_fast_val_idx;
-- RETURNING.
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (6, 60) ON CONFLICT (id) DO NOTHING RETURNING id, val$$);
  ioc_txn  
-----------
 fast_path
(1 row)

INSERT INTO pd_fast VALUES (6, 61) ON CONFLICT (id) DO NOTHING RETURNING id, val;
 id | val 
----+-----
(0 rows)

SELECT * FROM pd_fast WHERE id = 6;
 id | val 
----+-----
  6 |  60
(1 row)

-- Scalar subquery in RETURNING.
SELECT ioc_txn($$INSERT INTO pd_fast VALUES (7, 70) ON CONFLICT (id) DO NOTHING
  RETURNING (SELECT max(val) FROM pd_fast)$$);
   ioc_txn   
-------------
 distributed
(1 row)

SELECT * FROM pd_fast WHERE id = 7;
 id | val 
----+-----
  7 |  70
(1 row)

-- Changing the GUC also changes the transaction path of a prepared statement.
CREATE TABLE pd_fast_guc (id int PRIMARY KEY, val int);
INSERT INTO pd_fast_guc VALUES (1, 10);
PREPARE pd_fast_guc_p (int, int) AS
  INSERT INTO pd_fast_guc VALUES ($1, $2) ON CONFLICT (id) DO NOTHING;
EXECUTE pd_fast_guc_p (2, 20);
EXECUTE pd_fast_guc_p (3, 30);
EXECUTE pd_fast_guc_p (4, 40);
EXECUTE pd_fast_guc_p (5, 50);
EXECUTE pd_fast_guc_p (6, 60);
SELECT ioc_txn($$EXECUTE pd_fast_guc_p (10, 100)$$);
  ioc_txn  
-----------
 fast_path
(1 row)

SET yb_enable_ioc_do_nothing_pushdown = off;
SELECT ioc_txn($$EXECUTE pd_fast_guc_p (11, 110)$$);
   ioc_txn   
-------------
 distributed
(1 row)

SELECT ioc_pushdown($$EXECUTE pd_fast_guc_p (1, 99)$$);
 ioc_pushdown 
--------------
 fallback
(1 row)

EXECUTE pd_fast_guc_p (12, 120);
SET yb_enable_ioc_do_nothing_pushdown = on;
SELECT ioc_txn($$EXECUTE pd_fast_guc_p (13, 130)$$);
  ioc_txn  
-----------
 fast_path
(1 row)

SELECT * FROM pd_fast_guc ORDER BY id;
 id | val 
----+-----
  1 |  10
  2 |  20
  3 |  30
  4 |  40
  5 |  50
  6 |  60
 10 | 100
 11 | 110
 12 | 120
 13 | 130
(10 rows)

DEALLOCATE pd_fast_guc_p;
-- IOC pushdown can use a generic plan.  Plain INSERT and single-row UPDATE
-- continue to use custom plans.
CREATE TABLE pd_plan_cache (id int PRIMARY KEY, val int);
SET yb_test_planner_custom_plan_threshold TO 1;
PREPARE pd_plan_cache_ioc_p (int, int) AS
  INSERT INTO pd_plan_cache VALUES ($1, $2) ON CONFLICT (id) DO NOTHING;
EXECUTE pd_plan_cache_ioc_p (1, 10);
EXECUTE pd_plan_cache_ioc_p (2, 20);
SELECT name, generic_plans > 0 AS uses_generic, custom_plans > 0 AS used_custom
  FROM pg_prepared_statements WHERE name = 'pd_plan_cache_ioc_p';
        name         | uses_generic | used_custom 
---------------------+--------------+-------------
 pd_plan_cache_ioc_p | t            | t
(1 row)

PREPARE pd_plan_cache_ins_p (int, int) AS INSERT INTO pd_plan_cache VALUES ($1, $2);
EXECUTE pd_plan_cache_ins_p (100, 100);
EXECUTE pd_plan_cache_ins_p (101, 101);
SELECT name, generic_plans = 0 AS stays_custom
  FROM pg_prepared_statements WHERE name = 'pd_plan_cache_ins_p';
        name         | stays_custom 
---------------------+--------------
 pd_plan_cache_ins_p | t
(1 row)

PREPARE pd_plan_cache_upd_p (int, int) AS UPDATE pd_plan_cache SET val = $2 WHERE id = $1;
EXECUTE pd_plan_cache_upd_p (1, 11);
EXECUTE pd_plan_cache_upd_p (1, 12);
SELECT name, generic_plans = 0 AS stays_custom
  FROM pg_prepared_statements WHERE name = 'pd_plan_cache_upd_p';
        name         | stays_custom 
---------------------+--------------
 pd_plan_cache_upd_p | t
(1 row)

DEALLOCATE pd_plan_cache_ioc_p;
DEALLOCATE pd_plan_cache_ins_p;
DEALLOCATE pd_plan_cache_upd_p;
SET yb_test_planner_custom_plan_threshold TO DEFAULT;
--- Cleanup
DROP FUNCTION ioc_pushdown(text);
DROP FUNCTION ins_count(text);
DROP FUNCTION ioc_plan(text);
DROP FUNCTION ioc_tuples(text);
DROP FUNCTION ioc_txn(text);
