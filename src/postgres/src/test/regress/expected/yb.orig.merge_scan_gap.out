--
-- See yb_merge_scan_schedule for details about the test.  Tests that a merge
-- scan does not sort past a gap column whose covering equality runs after the
-- streams are merged (issue #33384): the filter is local because expression
-- pushdown is off, the collation is not C, or the operator is not immutable,
-- or it is pushed to the table read after the index-side merge.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/merge_scan_setup.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/parameterized_query.sql'
\i :filename
\set _echo_parameterized_query :ECHO
\set ECHO none
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set P1 ':explain'
\set P2
\set Q1 ':off'
\set Q2 ':on'
SET enable_sort = off;
-- These tables are of no use to other tests, so they are defined here rather
-- than in yb.orig.merge_scan_setup.  In each, c1 = c2 makes c2 redundant for
-- ORDER BY c1, c3 on the index (s, c1, c2, c3), and the first row is a decoy
-- that fails c1 = c2, sorts first within its stream, and sorts last by
-- (c1, c3), so that a merge past the gap misorders the survivors.
--
-- Local filter: expression pushdown off
--
CREATE TABLE gap_tbl (s int, c1 int, c2 int, c3 int,
    PRIMARY KEY (s ASC, c1 ASC, c2 ASC, c3 ASC));
INSERT INTO gap_tbl VALUES
    (1, 1, 0, 9), (1, 1, 1, 0), (2, 1, 1, 4), (1, 5, 5, 1), (2, 5, 5, 2);
ANALYZE gap_tbl;
SET yb_enable_expression_pushdown = off;
\set query ':P :Q SELECT c1, c3, s, c2 FROM gap_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT c1, c3, s, c2 FROM gap_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;
                                       QUERY PLAN                                       
----------------------------------------------------------------------------------------
 Sort (actual rows=4 loops=1)
   Output: c1, c3, s, c2
   Sort Key: gap_tbl.c1, gap_tbl.c3
   Sort Method: quicksort
   ->  Seq Scan on public.gap_tbl (actual rows=4 loops=1)
         Output: c1, c3, s, c2
         Filter: ((gap_tbl.s = ANY ('{1,2}'::integer[])) AND (gap_tbl.c1 = gap_tbl.c2))
         Rows Removed by Filter: 1
         Storage Table Read Requests: 1
         Storage Table Read Ops: 1
         Storage Table Rows Scanned: 5
(11 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 64)*/ SELECT c1, c3, s, c2 FROM gap_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Incremental Sort (actual rows=4 loops=1)
   Output: c1, c3, s, c2
   Sort Key: gap_tbl.c1, gap_tbl.c3
   Presorted Key: gap_tbl.c1
   Full-sort Groups: 1  Sort Method: quicksort
   ->  Index Scan using gap_tbl_pkey on public.gap_tbl (actual rows=4 loops=1)
         Output: c1, c3, s, c2
         Index Cond: (gap_tbl.s = ANY ('{1,2}'::integer[]))
         Merge Sort Key: gap_tbl.c1
         Merge Stream Key: gap_tbl.s
         Merge Streams: 2
         Merge Cond: (gap_tbl.s = ANY ('{1,2}'::integer[]))
         Filter: (gap_tbl.c1 = gap_tbl.c2)
         Rows Removed by Filter: 1
         Storage Table Read Requests: 1
         Storage Table Read Ops: 2
         Storage Table Rows Scanned: 5
(17 rows)

/*+Set(yb_max_merge_scan_streams 0)*/ SELECT c1, c3, s, c2 FROM gap_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;
 c1 | c3 | s | c2 
----+----+---+----
  1 |  0 | 1 |  1
  1 |  4 | 2 |  1
  5 |  1 | 1 |  5
  5 |  2 | 2 |  5
(4 rows)

/*+Set(yb_max_merge_scan_streams 64)*/ SELECT c1, c3, s, c2 FROM gap_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;
(output identical to previous)
RESET yb_enable_expression_pushdown;
--
-- Local filter: non-C collation
--
CREATE TABLE gap_coll_tbl (s int, c1 text COLLATE "en_US", c2 text COLLATE "en_US",
    c3 int, PRIMARY KEY (s ASC, c1 ASC, c2 ASC, c3 ASC));
INSERT INTO gap_coll_tbl VALUES
    (1, 'b', 'a', 9), (1, 'b', 'b', 0), (2, 'b', 'b', 4), (1, 'e', 'e', 1),
    (2, 'e', 'e', 2);
ANALYZE gap_coll_tbl;
\set query ':P :Q SELECT c1, c3, s, c2 FROM gap_coll_tbl WHERE s IN (1, 2) AND c1 = c2 ORDER BY c1, c3;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
