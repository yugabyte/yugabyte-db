/*+Set(yb_max_merge_scan_streams 64)*/ SELECT d, gap, ord1, ord2, bkt FROM gap_idx_tbl WHERE bkt IN (1, 2) AND ord1 = gap AND ord1 = d ORDER BY ord1, ord2;
