--
-- See yb_merge_scan_schedule for details about the test.  Tests a merge scan
-- whose sort columns skip an index column that a filter holds equal to an
-- earlier column.  Such a gap column varies within each stream, so the merge
-- also sorts on it, and the merge order holds wherever the filter runs.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/merge_scan_setup.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/parameterized_query.sql'
\i :filename
\set _echo_parameterized_query :ECHO
\set ECHO none
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set P1 ':explain'
\set P2
\set Q1 ':off'
\set Q2 ':on'
-- Small response pages make the execution metrics of the plan variants
-- distinct without growing the tables: at the default page size their rows
-- come back in one read request either way.
SET yb_fetch_row_limit = 16;
SET enable_sort = off;
-- These tables are of no use to other tests, so they are defined here rather
-- than in yb.orig.merge_scan_setup.  Unless a section says otherwise, ord1 =
-- gap makes gap redundant for ORDER BY ord1, ord2 on the index (bkt, ord1, gap,
-- ord2), and the first row is a decoy that fails ord1 = gap, sorts first within
-- its stream, and sorts last by (ord1, ord2), so that a merge that does not
-- sort on gap misorders the survivors.
-- Local filter: non-C collation
CREATE TABLE gap_coll_tbl (bkt int, ord1 text COLLATE "en_US", gap text COLLATE "en_US",
    ord2 int, PRIMARY KEY (bkt ASC, ord1 ASC, gap ASC, ord2 ASC));
INSERT INTO gap_coll_tbl VALUES
    (1, 'b', 'a', 9), (1, 'b', 'b', 0), (2, 'b', 'b', 4), (1, 'e', 'e', 1),
    (2, 'e', 'e', 2);
ANALYZE gap_coll_tbl;
\set query ':P :Q SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Sort (actual rows=4 loops=1)
   Output: gap, ord1, ord2, bkt
   Sort Key: gap_coll_tbl.gap COLLATE "en_US", gap_coll_tbl.ord2
   Sort Method: quicksort
   ->  Seq Scan on public.gap_coll_tbl (actual rows=4 loops=1)
         Output: gap, ord1, ord2, bkt
         Storage Filter: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
         Filter: (gap_coll_tbl.ord1 = gap_coll_tbl.gap)
         Rows Removed by Filter: 1
         Storage Table Read Requests: 1
         Storage Table Read Ops: 1
         Storage Table Rows Scanned: 5
(12 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 64)*/ SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2;
                                                QUERY PLAN                                                
----------------------------------------------------------------------------------------------------------
 Index Scan using gap_coll_tbl_pkey on public.gap_coll_tbl (actual rows=4 loops=1)
   Output: gap, ord1, ord2, bkt
   Index Cond: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
   Merge Sort Key: gap_coll_tbl.ord1 COLLATE "en_US", gap_coll_tbl.gap COLLATE "en_US", gap_coll_tbl.ord2
   Merge Stream Key: gap_coll_tbl.bkt
   Merge Streams: 2
   Merge Cond: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
   Filter: (gap_coll_tbl.ord1 = gap_coll_tbl.gap)
   Rows Removed by Filter: 1
   Storage Table Read Requests: 1
   Storage Table Read Ops: 2
   Storage Table Rows Scanned: 5
(12 rows)

/*+Set(yb_max_merge_scan_streams 0)*/ SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2;
 gap | ord1 | ord2 | bkt 
-----+------+------+-----
 b   | b    |    0 |   1
 b   | b    |    4 |   2
 e   | e    |    1 |   1
 e   | e    |    2 |   2
(4 rows)

/*+Set(yb_max_merge_scan_streams 64)*/ SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2;
(output identical to previous)
-- Secondary index: filter pushed to the table, read after the index merge
--
-- d is not in the index.  The planner does not evaluate equality clauses as
-- written: it chains the members of the class of ord1, gap, and d in the order
-- the clauses bring them in, generates an equality for each link, and pushes an
-- equality to the index only when it references index columns alone (see
-- #38120).
-- - ord1 = d AND gap = d generates ord1 = d and d = gap, both pushed to the
--   table, so a filter ties gap only at the table read.
-- - ord1 = d AND ord1 = gap generates the same equalities, so the ord1 = gap it
--   writes does not run on the index.
-- - ord1 = gap AND ord1 = d generates ord1 = gap, which runs on the index,
--   within each stream, before the merge, and gap = d.
-- TODO(#38120): the first two queries should run ord1 = gap on the index.
-- TODO(#37785): the last query should not merge on gap.
CREATE TABLE gap_idx_tbl (k int, bkt int, ord1 int, gap int, ord2 int, d int,
    PRIMARY KEY (k ASC));
CREATE INDEX NONCONCURRENTLY gap_idx_tbl_idx ON gap_idx_tbl (bkt ASC, ord1 ASC, gap ASC, ord2 ASC);
INSERT INTO gap_idx_tbl VALUES
    (1, 1, 1, 0, 9, 1), (2, 1, 1, 1, 0, 1), (3, 2, 1, 1, 4, 1), (4, 1, 5, 5, 1, 5),
    (5, 2, 5, 5, 2, 5);
ANALYZE gap_idx_tbl;
\set R1 'ord1 = d AND gap = d'
\set R2 'ord1 = d AND ord1 = gap'
\set R3 'ord1 = gap AND ord1 = d'
\set query ':P :Q SELECT d, gap, ord1, ord2, bkt FROM gap_idx_tbl WHERE bkt IN (1, 2) AND :R ORDER BY ord1, ord2;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT d, gap, ord1, ord2, bkt FROM gap_idx_tbl WHERE bkt IN (1, 2) AND ord1 = d AND gap = d ORDER BY ord1, ord2;
                                                                     QUERY PLAN                                                                      
-----------------------------------------------------------------------------------------------------------------------------------------------------
 Sort (actual rows=4 loops=1)
   Output: d, gap, ord1, ord2, bkt
   Sort Key: gap_idx_tbl.d, gap_idx_tbl.ord2
   Sort Method: quicksort
   ->  Seq Scan on public.gap_idx_tbl (actual rows=4 loops=1)
         Output: d, gap, ord1, ord2, bkt
         Storage Filter: ((gap_idx_tbl.bkt = ANY ('{1,2}'::integer[])) AND (gap_idx_tbl.ord1 = gap_idx_tbl.d) AND (gap_idx_tbl.d = gap_idx_tbl.gap))
         Storage Table Read Requests: 1
         Storage Table Read Ops: 1
         Storage Table Rows Scanned: 5
(10 rows)

