--
-- See yb_merge_scan_schedule for details about the test.  Tests merge scans
-- with gap columns.  A gap column is an index column before the last ORDER BY
-- column of the index that the ORDER BY can skip because a filter or the index
-- predicate ties it to an earlier column or to a constant.  The merge sorts on
-- each gap column, since a filter that ties it can run after the merge.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/data/explainrun_merge_scan.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/data/explainrun.sql'
\i :filename
-- A helper script to explain and run a query.  Use in regress tests by
-- defining :explain, :query, and optionally :hint#.
\set explain1 ':explain :hint1 :query;'
\set explain2 ':explain1 :explain :hint2 :query;'
\set explain3 ':explain2 :explain :hint3 :query;'
\set explain4 ':explain3 :explain :hint4 :query;'
\set explain5 ':explain4 :explain :hint5 :query;'
\set explain1run1 ':explain1; :hint1 :query;'
\set explain2run2 ':explain2; :hint1 :query; :hint2 :query;'
\set explain3run3 ':explain3; :hint1 :query; :hint2 :query; :hint3 :query;'
\set explain4run4 ':explain4; :hint1 :query; :hint2 :query; :hint3 :query; :hint4 :query;'
\set explain5run5 ':explain5; :hint1 :query; :hint2 :query; :hint3 :query; :hint4 :query; :hint5 :query;'
-- Default to no hints.
\set hint1 ''
\set hint2 ''
\set hint3 ''
\set hint4 ''
\set hint5 ''
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set hint1 ':off'
\set hint2 ':on'
SET enable_sort = off;
-- Local filter: non-C collation
--
-- ord1 = gap compares text with a non-C collation, which is not pushed down, so
-- the filter runs after the merge.
CREATE TABLE gap_coll_tbl (bkt int, ord1 text COLLATE "en_US", gap text COLLATE "en_US",
    ord2 int, PRIMARY KEY (bkt ASC, ord1 ASC, gap ASC, ord2 ASC));
INSERT INTO gap_coll_tbl VALUES
    (1, 'b', 'b', 10), (1, 'b', 'b', 30),  -- stream bkt = 1
    (2, 'b', 'b', 20),                     -- stream bkt = 2
    (1, 'b', 'a', 99);                     -- decoy, fails ord1 = gap
ANALYZE gap_coll_tbl;
\set query 'SELECT gap, ord1, ord2, bkt FROM gap_coll_tbl WHERE bkt IN (1, 2) AND ord1 = gap ORDER BY ord1, ord2'
:explain2run2
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Sort (actual rows=3 loops=1)
   Output: gap, ord1, ord2, bkt
   Sort Key: gap_coll_tbl.gap COLLATE "en_US", gap_coll_tbl.ord2
   Sort Method: quicksort
   ->  Seq Scan on public.gap_coll_tbl (actual rows=3 loops=1)
         Output: gap, ord1, ord2, bkt
         Storage Filter: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
         Filter: (gap_coll_tbl.ord1 = gap_coll_tbl.gap)
         Rows Removed by Filter: 1
         Storage Table Read Requests: 1
         Storage Table Read Ops: 1
         Storage Table Rows Scanned: 4
(12 rows)

                                                QUERY PLAN                                                
----------------------------------------------------------------------------------------------------------
 Index Scan using gap_coll_tbl_pkey on public.gap_coll_tbl (actual rows=3 loops=1)
   Output: gap, ord1, ord2, bkt
   Index Cond: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
   Merge Sort Key: gap_coll_tbl.ord1 COLLATE "en_US", gap_coll_tbl.gap COLLATE "en_US", gap_coll_tbl.ord2
   Merge Stream Key: gap_coll_tbl.bkt
   Merge Streams: 2
   Merge Cond: (gap_coll_tbl.bkt = ANY ('{1,2}'::integer[]))
   Filter: (gap_coll_tbl.ord1 = gap_coll_tbl.gap)
   Rows Removed by Filter: 1
   Storage Table Read Requests: 1
   Storage Table Read Ops: 2
   Storage Table Rows Scanned: 4
(12 rows)

 gap | ord1 | ord2 | bkt 
-----+------+------+-----
 b   | b    |   10 |   1
 b   | b    |   20 |   2
 b   | b    |   30 |   1
(3 rows)

 gap | ord1 | ord2 | bkt 
-----+------+------+-----
 b   | b    |   10 |   1
 b   | b    |   20 |   2
 b   | b    |   30 |   1
(3 rows)

-- Secondary index: filter pushed to the table, read after the index merge
--
-- d is not in the index.  The planner does not evaluate equality clauses as
-- written: it chains the members of the class of ord1, gap, and d in the order
-- the clauses bring them in, generates an equality for each link, and pushes an
-- equality to the index only when it references index columns alone (see
-- #38120).
-- - ord1 = d AND gap = d generates ord1 = d and d = gap, both pushed to the
--   table, so a filter ties gap only at the table read.
-- - ord1 = d AND ord1 = gap generates the same equalities, so the ord1 = gap it
--   writes does not run on the index.
-- - ord1 = gap AND ord1 = d generates ord1 = gap, which runs on the index,
--   within each stream, before the merge, and gap = d.
-- TODO(#38120): the first two queries should run ord1 = gap on the index.
-- TODO(#37785): the last query should not merge on gap.
CREATE TABLE gap_idx_tbl (k int, bkt int, ord1 int, gap int, ord2 int, d int,
    PRIMARY KEY (k ASC));
CREATE INDEX NONCONCURRENTLY gap_idx_tbl_idx ON gap_idx_tbl (bkt ASC, ord1 ASC, gap ASC, ord2 ASC);
INSERT INTO gap_idx_tbl VALUES
    (1, 1, 1, 1, 10, 1), (2, 1, 1, 1, 30, 1),  -- stream bkt = 1
    (3, 2, 1, 1, 20, 1),                       -- stream bkt = 2
    (4, 1, 1, 0, 99, 1);                       -- decoy, fails gap = d
ANALYZE gap_idx_tbl;
\set query 'SELECT d, gap, ord1, ord2, bkt FROM gap_idx_tbl WHERE bkt IN (1, 2) AND ord1 = d AND gap = d ORDER BY ord1, ord2'
:explain2run2
                                                                     QUERY PLAN                                                                      
-----------------------------------------------------------------------------------------------------------------------------------------------------
 Sort (actual rows=3 loops=1)
   Output: d, gap, ord1, ord2, bkt
   Sort Key: gap_idx_tbl.d, gap_idx_tbl.ord2
   Sort Method: quicksort
   ->  Seq Scan on public.gap_idx_tbl (actual rows=3 loops=1)
         Output: d, gap, ord1, ord2, bkt
         Storage Filter: ((gap_idx_tbl.bkt = ANY ('{1,2}'::integer[])) AND (gap_idx_tbl.ord1 = gap_idx_tbl.d) AND (gap_idx_tbl.d = gap_idx_tbl.gap))
         Storage Table Read Requests: 1
         Storage Table Read Ops: 1
         Storage Table Rows Scanned: 4
(10 rows)

                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Index Scan using gap_idx_tbl_idx on public.gap_idx_tbl (actual rows=3 loops=1)
   Output: d, gap, ord1, ord2, bkt
   Index Cond: (gap_idx_tbl.bkt = ANY ('{1,2}'::integer[]))
   Merge Sort Key: gap_idx_tbl.ord1, gap_idx_tbl.gap, gap_idx_tbl.ord2
   Merge Stream Key: gap_idx_tbl.bkt
   Merge Streams: 2
   Merge Cond: (gap_idx_tbl.bkt = ANY ('{1,2}'::integer[]))
   Storage Filter: ((gap_idx_tbl.ord1 = gap_idx_tbl.d) AND (gap_idx_tbl.d = gap_idx_tbl.gap))
   Storage Table Read Requests: 1
   Storage Table Read Ops: 1
   Storage Table Rows Scanned: 4
   Storage Index Read Requests: 1
   Storage Index Read Ops: 2
   Storage Index Rows Scanned: 4
(14 rows)

