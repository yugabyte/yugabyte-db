--
-- Open retry bugs, run with yb_enable_replay_retry on.  Each one comes from
-- the in-place restart keeping PG state that only an abort resets; the replay
-- aborts for real, so each must behave as after an abort and a replay of the
-- same statement.  The first two sections are the repros of PR 35700 (#30540,
-- yb.orig.query_layer_retry_state) and PR 35863 (yb.orig.query_layer_retry_user).
--
SET yb_enable_replay_retry = on;
--
-- A query-layer retry of a whole transaction must leave the backend as an
-- abort followed by a replay of the same command would.  Each case below
-- raises a retriable kAborted (YB001) on its first attempt only, keyed on a
-- sequence, so the retry always runs once and then succeeds.
--
--
-- #30540: the retry released PL/pgSQL's simple-expression plan refcounts but
-- kept the local transaction id, so a plan invalidated before the retry made
-- it fail with "plancache reference ... is not owned by resource owner
-- PL/pgSQL simple expressions".  Scenario: the first attempt evaluates a
-- simple expression, runs DISCARD PLANS, then raises YB001; the retry must
-- return 1.
--
CREATE SEQUENCE attempt;
CREATE FUNCTION f() RETURNS int LANGUAGE plpgsql AS $$
BEGIN
  IF nextval('attempt') = 1 THEN
    EXECUTE 'DISCARD PLANS';
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
SELECT f();
 f 
---
 1
(1 row)

--
-- The same retry inside an explicit SERIALIZABLE block: the new local
-- transaction id is assigned mid-block, and the block must keep its
-- isolation level.
--
ALTER SEQUENCE attempt RESTART;
BEGIN ISOLATION LEVEL SERIALIZABLE;
SELECT f();
 f 
---
 1
(1 row)

SHOW transaction_isolation;
 transaction_isolation 
-----------------------
 serializable
(1 row)

COMMIT;
--
-- The procedure shape #30540 was reported on: CALL of a procedure that
-- invalidates plans and raises YB001 before its COMMIT; the retried CALL
-- must commit exactly one row.
--
CREATE TABLE retry_rows (k int);
CREATE SEQUENCE p_attempt;
CREATE PROCEDURE p() LANGUAGE plpgsql AS $$
BEGIN
  INSERT INTO retry_rows VALUES (1);
  IF nextval('p_attempt') = 1 THEN
    EXECUTE 'DISCARD PLANS';
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  COMMIT;
END $$;
-- READ COMMITTED retries this CALL on its own; opt it in so REPEATABLE READ
-- (the debug-build default) retries it too.
SET yb_extra_commands_to_retry = 'CALL';
SET yb_extra_commands_to_retry_in_proc = 'DISCARD PLANS';
CALL p();
SELECT count(*) FROM retry_rows;
 count 
-------
     1
(1 row)

RESET yb_extra_commands_to_retry;
RESET yb_extra_commands_to_retry_in_proc;
DROP PROCEDURE p();
DROP SEQUENCE p_attempt;
DROP TABLE retry_rows;
DROP FUNCTION f();
DROP SEQUENCE attempt;
--
-- With yb_enable_replay_retry on, a query-layer retry aborts the transaction
-- and replays it, so it must leave the session as an abort and a replay of the
-- same statement would.  Each
-- function below raises a retriable kAborted (YB001) on its first call only,
-- keyed on a sequence.  After the retry, current_user must be the caller.
-- First case: retry_alice calls sd(), a SECURITY DEFINER function owned by
-- the test user.
--
CREATE ROLE retry_alice;
CREATE SEQUENCE sd_attempt;
GRANT USAGE ON SEQUENCE sd_attempt TO retry_alice;
CREATE FUNCTION sd() RETURNS int LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  IF nextval('sd_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
GRANT EXECUTE ON FUNCTION sd() TO retry_alice;
SET ROLE retry_alice;
SELECT sd();
 sd 
----
  1
(1 row)

SELECT current_user;
 current_user 
--------------
 retry_alice
(1 row)

RESET ROLE;
--
-- sr() sets the role with a SET clause instead of SECURITY DEFINER.  After
-- the retry, current_user must be the caller, not retry_bob.  The check runs
-- in the same REPEATABLE READ transaction, because COMMIT would undo the
-- clause first and hide the bug.
--
CREATE ROLE retry_bob;
CREATE SEQUENCE sr_attempt;
GRANT USAGE ON SEQUENCE sr_attempt TO retry_bob;
CREATE FUNCTION sr() RETURNS int LANGUAGE plpgsql SET role = retry_bob AS $$
BEGIN
  IF nextval('sr_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT sr();
 sr 
----
  1
(1 row)

SELECT current_user;
 current_user 
--------------
 yugabyte
(1 row)

COMMIT;
--
-- sde() and sre() are sd() and sr() with an exception block that does not
-- catch YB001.  plpgsql runs the block in a subtransaction and rolls it back
-- before the error leaves the function.  The retry must still restore the
-- caller.
--
CREATE SEQUENCE sde_attempt;
GRANT USAGE ON SEQUENCE sde_attempt TO retry_alice;
CREATE FUNCTION sde() RETURNS int LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  IF nextval('sde_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
EXCEPTION WHEN division_by_zero THEN
  RETURN -1;
END $$;
GRANT EXECUTE ON FUNCTION sde() TO retry_alice;
SET ROLE retry_alice;
SELECT sde();
 sde 
-----
   1
(1 row)

SELECT current_user;
 current_user 
--------------
 retry_alice
(1 row)

RESET ROLE;
CREATE SEQUENCE sre_attempt;
GRANT USAGE ON SEQUENCE sre_attempt TO retry_bob;
CREATE FUNCTION sre() RETURNS int LANGUAGE plpgsql SET role = retry_bob AS $$
BEGIN
  IF nextval('sre_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
EXCEPTION WHEN division_by_zero THEN
  RETURN -1;
END $$;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT sre();
 sre 
-----
   1
(1 row)

SELECT current_user;
 current_user 
--------------
 yugabyte
(1 row)

COMMIT;
--
-- srs() sets search_path with a SET clause.  After the retry, an unqualified
-- name in the same transaction must resolve through the caller's
-- search_path: rt is public.rt, not retry_s.rt.
--
CREATE SCHEMA retry_s;
CREATE TABLE rt (v text);
INSERT INTO rt VALUES ('public');
CREATE TABLE retry_s.rt (v text);
INSERT INTO retry_s.rt VALUES ('retry_s');
CREATE SEQUENCE srs_attempt;
CREATE FUNCTION srs() RETURNS int LANGUAGE plpgsql SET search_path = retry_s AS $$
BEGIN
  IF nextval('public.srs_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT srs();
 srs 
-----
   1
(1 row)

SELECT v FROM rt;
   v    
--------
 public
(1 row)

COMMIT;
--
-- sdp() is SECURITY DEFINER and also sets search_path with a SET clause, so
-- the failed attempt leaks both the user switch and a GUC level.  After the
-- retry, current_user must be retry_alice and rt must be public.rt.
--
CREATE SEQUENCE sdp_attempt;
GRANT SELECT ON rt TO retry_alice;
CREATE FUNCTION sdp() RETURNS int LANGUAGE plpgsql SECURITY DEFINER
  SET search_path = retry_s AS $$
BEGIN
  IF nextval('public.sdp_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
GRANT EXECUTE ON FUNCTION sdp() TO retry_alice;
SET ROLE retry_alice;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT sdp();
 sdp 
-----
   1
(1 row)

SELECT current_user;
 current_user 
--------------
 retry_alice
(1 row)

SELECT v FROM rt;
   v    
--------
 public
(1 row)

COMMIT;
RESET ROLE;
--
-- spr() has no SET clause and is not SECURITY DEFINER.  Its body runs a
-- plain SET ROLE on the first call only, then raises YB001.  The abort undoes
-- that SET, and the retried call does not run it again.  After the retry,
-- current_user must be the
-- caller and the role setting none, as after an abort and a replay.
--
CREATE SEQUENCE spr_attempt;
CREATE FUNCTION spr() RETURNS int LANGUAGE plpgsql AS $$
BEGIN
  IF nextval('spr_attempt') = 1 THEN
    SET ROLE retry_bob;
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SELECT spr();
 spr 
-----
   1
(1 row)

SELECT current_user, current_setting('role') AS role;
 current_user | role 
--------------+------
 yugabyte     | none
(1 row)

COMMIT;
SELECT current_user, current_setting('role') AS role;
 current_user | role 
--------------+------
 yugabyte     | none
(1 row)

RESET ROLE;
DROP FUNCTION sd();
DROP FUNCTION sr();
DROP FUNCTION sde();
DROP FUNCTION sre();
DROP FUNCTION srs();
DROP FUNCTION sdp();
DROP FUNCTION spr();
DROP SEQUENCE sd_attempt;
DROP SEQUENCE sr_attempt;
DROP SEQUENCE sde_attempt;
DROP SEQUENCE sre_attempt;
DROP SEQUENCE srs_attempt;
DROP SEQUENCE sdp_attempt;
DROP SEQUENCE spr_attempt;
DROP TABLE rt;
DROP TABLE retry_s.rt;
DROP SCHEMA retry_s;
DROP ROLE retry_alice;
DROP ROLE retry_bob;
--
-- From the DB-25108 session's repro.sql: the SET-clause role in autocommit,
-- without a transaction block.  After the retry, current_user is the caller.
--
CREATE ROLE retry_carol;
CREATE SEQUENCE src_attempt;
GRANT USAGE ON SEQUENCE src_attempt TO retry_carol;
CREATE FUNCTION src() RETURNS int LANGUAGE plpgsql SET role = retry_carol AS $$
BEGIN
  IF nextval('src_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kAborted' USING ERRCODE = 'YB001';
  END IF;
  RETURN 1;
END $$;
SELECT src();
 src 
-----
   1
(1 row)

SELECT current_user, session_user, current_setting('role');
 current_user | session_user | current_setting 
--------------+--------------+-----------------
 yugabyte     | yugabyte     | none
(1 row)

SELECT last_value FROM src_attempt;
 last_value 
------------
        100
(1 row)

DROP FUNCTION src();
DROP SEQUENCE src_attempt;
DROP ROLE retry_carol;
--
-- #34751: the in-place restart kept the failed attempt's catalog cache
-- entries, so a retried CREATE TABLE IF NOT EXISTS found the uncommitted
-- table, skipped, and the next statement failed with "does not exist".  The
-- event trigger raises a retriable kConflict once, after the table is created
-- in the failed attempt.
--
SET default_transaction_isolation = 'repeatable read';
CREATE SEQUENCE ct_attempt;
CREATE FUNCTION ct_inj() RETURNS event_trigger LANGUAGE plpgsql AS $$
BEGIN
  IF nextval('ct_attempt') = 1 THEN
    RAISE EXCEPTION 'injected kConflict' USING ERRCODE = 'YB003';
  END IF;
END $$;
CREATE EVENT TRIGGER ct_inj ON ddl_command_end WHEN TAG IN ('CREATE TABLE')
  EXECUTE FUNCTION ct_inj();
SET yb_extra_commands_to_retry = 'CREATE TABLE';
CREATE TABLE IF NOT EXISTS ct_t (k int);
INSERT INTO ct_t VALUES (1);
SELECT * FROM ct_t;
 k 
---
 1
(1 row)

RESET yb_extra_commands_to_retry;
DROP EVENT TRIGGER ct_inj;
DROP FUNCTION ct_inj();
DROP SEQUENCE ct_attempt;
DROP TABLE ct_t;
RESET default_transaction_isolation;
