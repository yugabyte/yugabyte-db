    (DEFAULT, false, 'select * from r where e = 123'),
    (DEFAULT, false, 'select * from r where e < 123'),
    (DEFAULT, false, 'select * from r where e > 123'),
    (DEFAULT, false, 'select * from r where e <= 123'),
    (DEFAULT, false, 'select * from r where e >= 123'),
    (DEFAULT, false, 'select * from r where e <> 123'),
    (DEFAULT, false, 'select * from r where e between 123 and 456'),
    (DEFAULT, false, 'select * from r where c = ''abc'''),
