ALTER USER phguc PASSWORD 'pw_d';
ALTER USER phguc PASSWORD 'pw_e';
ALTER USER phguc PASSWORD 'pw_f';
\c yugabyte yugabyte
SELECT pwd_hist_len('phguc');
 pwd_hist_len 
