--
-- Memory use of scans with pushed-down filters that are rescanned many times
--
-- Every rescan instantiates the scan's pushdown expressions again and
-- serializes them into a new DocDB request.  Peak memory must not grow with
-- the number of rescans.
--
CREATE TABLE t_outer (k int PRIMARY KEY, v int);
CREATE TABLE t_inner (k int PRIMARY KEY, v int, w int);
CREATE INDEX t_inner_w_v_idx ON t_inner (w ASC) INCLUDE (v);
CREATE TABLE t_small (k int PRIMARY KEY, v int);
INSERT INTO t_outer SELECT i, i % 7 FROM generate_series(1, 5000) i;
INSERT INTO t_inner SELECT i, i % 7, i FROM generate_series(1, 5000) i;
INSERT INTO t_small SELECT i, i FROM generate_series(1, 10) i;
ANALYZE t_outer, t_inner, t_small;
SET yb_explain_hide_non_deterministic_fields = off;
SET yb_enable_bitmapscan = on;
-- Peak memory of a statement that rescans its inner scan once per row of
-- t_outer with k <= n.
CREATE FUNCTION peak_mem_kb(query text, n int) RETURNS bigint
LANGUAGE plpgsql AS
$$
DECLARE
    plan json;
BEGIN
    EXECUTE format('EXPLAIN (ANALYZE, SUMMARY, FORMAT JSON) ' || query, n)
        INTO plan;
    RETURN (plan -> 0 ->> 'Peak Memory Usage')::bigint;
END;
$$;
-- If each rescan kept its own copy of the pushdown expressions, doubling the
-- rescans from 2500 to 5000 would add about 4 MB.
CREATE FUNCTION check_rescan_memory(query text) RETURNS text
LANGUAGE plpgsql AS
$$
DECLARE
    peak_n bigint := peak_mem_kb(query, 2500);
    peak_2n bigint := peak_mem_kb(query, 5000);
BEGIN
    IF peak_2n - peak_n < 1024 THEN
        RETURN 'ok';
    END IF;
    RETURN format('peak memory grew from %s kB to %s kB', peak_n, peak_2n);
END;
$$;
-- Index Scan, correlated subquery
\set query 'SELECT sum((SELECT i.v FROM t_inner i WHERE i.k = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= %s'
EXPLAIN (COSTS OFF) SELECT sum((SELECT i.v FROM t_inner i WHERE i.k = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= 2500;
                     QUERY PLAN                     
----------------------------------------------------
 Aggregate
   ->  Seq Scan on t_outer o
         Storage Filter: (k <= 2500)
   SubPlan 1
     ->  Index Scan using t_inner_pkey on t_inner i
           Index Cond: (k = o.k)
           Storage Filter: (v >= 0)
(7 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

-- Index Scan, nested loop, filter that references the outer row
\set query '/*+ NestLoop(o i) IndexScan(i t_inner_pkey) Leading((o i)) Set(yb_bnl_batch_size 1) */ SELECT count(*) FROM t_outer o JOIN t_inner i ON i.k = o.k AND i.v = o.v WHERE o.k <= %s'
EXPLAIN (COSTS OFF) /*+ NestLoop(o i) IndexScan(i t_inner_pkey) Leading((o i)) Set(yb_bnl_batch_size 1) */ SELECT count(*) FROM t_outer o JOIN t_inner i ON i.k = o.k AND i.v = o.v WHERE o.k <= 2500;
                       QUERY PLAN                       
--------------------------------------------------------
 Aggregate
   ->  Nested Loop
         ->  Seq Scan on t_outer o
               Storage Filter: (k <= 2500)
         ->  Index Scan using t_inner_pkey on t_inner i
               Index Cond: (k = o.k)
               Storage Filter: (o.v = v)
(7 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

-- Index Only Scan
\set query 'SELECT sum((SELECT i.v FROM t_inner i WHERE i.w = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= %s'
EXPLAIN (COSTS OFF) SELECT sum((SELECT i.v FROM t_inner i WHERE i.w = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= 2500;
                         QUERY PLAN                         
------------------------------------------------------------
 Aggregate
   ->  Seq Scan on t_outer o
         Storage Filter: (k <= 2500)
   SubPlan 1
     ->  Index Only Scan using t_inner_w_v_idx on t_inner i
           Index Cond: (w = o.k)
           Storage Filter: (v >= 0)
(7 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

-- Seq Scan
\set query 'SELECT sum((SELECT s.k FROM t_small s WHERE s.v = o.v)) FROM t_outer o WHERE o.k <= %s'
EXPLAIN (COSTS OFF) SELECT sum((SELECT s.k FROM t_small s WHERE s.v = o.v)) FROM t_outer o WHERE o.k <= 2500;
             QUERY PLAN              
-------------------------------------
 Aggregate
   ->  Seq Scan on t_outer o
         Storage Filter: (k <= 2500)
   SubPlan 1
     ->  Seq Scan on t_small s
           Storage Filter: (v = o.v)
(6 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

-- Bitmap Index Scan and YB Bitmap Table Scan
\set query '/*+ BitmapScan(i) */ SELECT sum((SELECT i.w FROM t_inner i WHERE i.w = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= %s'
EXPLAIN (COSTS OFF) /*+ BitmapScan(i) */ SELECT sum((SELECT i.w FROM t_inner i WHERE i.w = o.k AND i.v >= 0)) FROM t_outer o WHERE o.k <= 2500;
                        QUERY PLAN                        
----------------------------------------------------------
 Aggregate
   ->  Seq Scan on t_outer o
         Storage Filter: (k <= 2500)
   SubPlan 1
     ->  YB Bitmap Table Scan on t_inner i
           Storage Recheck Cond: ((w = o.k) AND (v >= 0))
           ->  Bitmap Index Scan on t_inner_w_v_idx
                 Index Cond: (w = o.k)
                 Storage Index Filter: (v >= 0)
(9 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

-- Tid Scan
SELECT ybctid AS small_ybctid FROM t_small WHERE k = 1 \gset
\set query '/*+ TidScan(s) */ SELECT sum((SELECT s.k FROM t_small s WHERE s.ybctid = ''' :small_ybctid ''' AND s.v = o.v)) FROM t_outer o WHERE o.k <= %s'
EXPLAIN (COSTS OFF) /*+ TidScan(s) */ SELECT sum((SELECT s.k FROM t_small s WHERE s.ybctid = :'small_ybctid' AND s.v = o.v)) FROM t_outer o WHERE o.k <= 2500;
                           QUERY PLAN                           
----------------------------------------------------------------
 Aggregate
   ->  Seq Scan on t_outer o
         Storage Filter: (k <= 2500)
   SubPlan 1
     ->  Tid Scan on t_small s
           TID Cond: (ybctid = '\x47121048800000012121'::bytea)
           Storage Filter: (v = o.v)
(7 rows)

SELECT check_rescan_memory(:'query');
 check_rescan_memory 
---------------------
 ok
(1 row)

RESET yb_explain_hide_non_deterministic_fields;
RESET yb_enable_bitmapscan;
DROP FUNCTION check_rescan_memory(text);
DROP FUNCTION peak_mem_kb(text, int);
DROP TABLE t_outer, t_inner, t_small;
