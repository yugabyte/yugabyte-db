create table pl.p6 partition of pl.p for values from (501) to (601)
create table pl.p7 partition of pl.p for values from (601) to (701)
create table pl.p8 partition of pl.p for values from (701) to (801)
create table pl.p9 partition of pl.p for values from (801) to (901)
create table pl.p10 partition of pl.p for values from (901) to (1001)
create table pl.p11 partition of pl.p for values from (1001) to (1101)
create table pl.p12 partition of pl.p for values from (1101) to (1201)
create table pl.p13 partition of pl.p for values from (1201) to (1301)
create table pl.p14 partition of pl.p for values from (1301) to (1401)
create table pl.p15 partition of pl.p for values from (1401) to (1501)
create table pl.p16 partition of pl.p for values from (1501) to (1601)
create table pl.p17 partition of pl.p for values from (1601) to (1701)
create table pl.p18 partition of pl.p for values from (1701) to (1801)
