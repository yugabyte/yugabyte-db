select format('explain (costs off) %s', query) from queries where qid = 605 \gexec
explain (costs off) select * from pl.p where k <= 500 + extract(year from now())::int * 0
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Gather
   Workers Planned: 2
   ->  Parallel Append
         Subplans Removed: 20
         ->  Parallel Index Scan using p1_pkey on p1 p_1
               Index Cond: (k <= (500 + ((EXTRACT(year FROM now()))::integer * 0)))
         ->  Parallel Index Scan using p2_pkey on p2 p_2
               Index Cond: (k <= (500 + ((EXTRACT(year FROM now()))::integer * 0)))
         ->  Parallel Index Scan using p3_pkey on p3 p_3
               Index Cond: (k <= (500 + ((EXTRACT(year FROM now()))::integer * 0)))
         ->  Parallel Index Scan using p4_pkey on p4 p_4
               Index Cond: (k <= (500 + ((EXTRACT(year FROM now()))::integer * 0)))
         ->  Parallel Index Scan using p5_pkey on p5 p_5
               Index Cond: (k <= (500 + ((EXTRACT(year FROM now()))::integer * 0)))
(14 rows)

