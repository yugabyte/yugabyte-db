-- setrefs.c keeps a single-child Append whose parallel awareness differs from
-- the scan's.  With parallel Append off, a partition pruned to one child under
-- a subquery kept by its WITH clause or by a security_barrier view, and a
-- UNION ALL member kept as a subquery, put a layer that is never parallel
-- aware between the Append and a parallel scan: the Append stays, and the Agg
-- above it evaluates the aggregates.  With parallel Append on, the Append is
-- parallel aware like the scan and goes.
CREATE TABLE ybaggtest_part (k int, v int, PRIMARY KEY (k ASC)) PARTITION BY RANGE (k);
CREATE TABLE ybaggtest_part_1 PARTITION OF ybaggtest_part FOR VALUES FROM (0) TO (1000);
CREATE TABLE ybaggtest_part_2 PARTITION OF ybaggtest_part FOR VALUES FROM (1000) TO (2000);
INSERT INTO ybaggtest_part SELECT i, i % 10 FROM generate_series(0, 1999) i;
ANALYZE ybaggtest_part;
CREATE VIEW ybaggtest_part_sb WITH (security_barrier) AS SELECT k, v FROM ybaggtest_part WHERE k >= 1000;
SET yb_parallel_range_rows = 100;
SET max_parallel_workers_per_gather = 2;
SET parallel_setup_cost = 0;
SET enable_parallel_append = off;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM (WITH w AS (SELECT 1) SELECT k, v FROM ybaggtest_part WHERE k >= 1000) s;
                                                  QUERY PLAN                                                  
--------------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Partial Aggregate
               ->  Append
                     ->  Parallel Index Scan using ybaggtest_part_2_pkey on ybaggtest_part_2 ybaggtest_part_1
                           Index Cond: (k >= 1000)
(7 rows)

SELECT COUNT(*) FROM (WITH w AS (SELECT 1) SELECT k, v FROM ybaggtest_part WHERE k >= 1000) s;
 count 
-------
  1000
(1 row)

EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ybaggtest_part_sb;
                                                  QUERY PLAN                                                  
--------------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Partial Aggregate
               ->  Append
                     ->  Parallel Index Scan using ybaggtest_part_2_pkey on ybaggtest_part_2 ybaggtest_part_1
                           Index Cond: (k >= 1000)
(7 rows)

SELECT COUNT(*) FROM ybaggtest_part_sb;
 count 
-------
  1000
(1 row)

EXPLAIN (COSTS OFF) SELECT SUM(x) FROM ((WITH w AS (SELECT 1) SELECT k AS x FROM ybaggtest_part_2 WHERE k >= 1000) UNION ALL (SELECT k FROM ybaggtest_part_2 WHERE false)) u;
                                         QUERY PLAN                                          
---------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Partial Aggregate
               ->  Append
                     ->  Parallel Index Scan using ybaggtest_part_2_pkey on ybaggtest_part_2
                           Index Cond: (k >= 1000)
(7 rows)

SELECT SUM(x) FROM ((WITH w AS (SELECT 1) SELECT k AS x FROM ybaggtest_part_2 WHERE k >= 1000) UNION ALL (SELECT k FROM ybaggtest_part_2 WHERE false)) u;
   sum   
---------
 1499500
(1 row)

RESET enable_parallel_append;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM (WITH w AS (SELECT 1) SELECT k, v FROM ybaggtest_part WHERE k >= 1000) s;
                                               QUERY PLAN                                               
--------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Scan using ybaggtest_part_2_pkey on ybaggtest_part_2 ybaggtest_part_1
                     Index Cond: (k >= 1000)
                     Partial Aggregate: true
(7 rows)

RESET yb_parallel_range_rows;
RESET max_parallel_workers_per_gather;
RESET parallel_setup_cost;
DROP VIEW ybaggtest_part_sb;
DROP TABLE ybaggtest_part;
-- The scan below a plain Aggregate shows the width of the rows DocDB returns
-- to it: the partial-aggregate row under a pushdown, whatever columns the
-- aggregates read, and ybctid when a filter DocDB cannot evaluate keeps the
-- aggregate in PostgreSQL and the scan outputs no column (#20955).
CREATE FUNCTION ybaggtest_widths(query text) RETURNS TABLE (node text, width int, partial_aggregate text) LANGUAGE plpgsql AS $$
DECLARE
  plan jsonb;
BEGIN
  EXECUTE 'EXPLAIN (FORMAT JSON) ' || query INTO plan;
  RETURN QUERY SELECT n->>'Node Type', (n->>'Plan Width')::int, n->>'Partial Aggregate' FROM jsonb_path_query(plan, 'strict $.**?(exists (@."Node Type"))') n;
END $$;
CREATE FUNCTION ybaggtest_volatile() RETURNS bool LANGUAGE plpgsql AS $$ BEGIN RETURN true; END $$;
SELECT * FROM ybaggtest_widths('/*+ SeqScan(ybaggtest) */ SELECT COUNT(*) FROM ybaggtest');
   node    | width | partial_aggregate 
-----------+-------+-------------------
 Aggregate |     8 | 
 Seq Scan  |     9 | true
(2 rows)

SELECT * FROM ybaggtest_widths('/*+ IndexOnlyScan(ybaggtest ybaggtestindexsimple) */ SELECT SUM(int_4) FROM ybaggtest');
      node       | width | partial_aggregate 
-----------------+-------+-------------------
 Aggregate       |     8 | 
 Index Only Scan |     9 | true
(2 rows)

SELECT * FROM ybaggtest_widths('/*+ SeqScan(ybaggtest) */ SELECT COUNT(*) FROM ybaggtest WHERE ybaggtest_volatile()');
   node    | width | partial_aggregate 
-----------+-------+-------------------
 Aggregate |     8 | 
 Seq Scan  |    11 | 
(2 rows)

DROP FUNCTION ybaggtest_volatile();
DROP FUNCTION ybaggtest_widths(text);
-- A cached plan that pushes the aggregate down below an Index Scan or an Index
-- Only Scan evaluates it in PostgreSQL once yb_test_skip_binding_scan_keys,
-- set after planning, makes the scan recheck its index condition, which a
-- pushed-down aggregate row cannot take: both counts stay 100 (#20955).
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_indexonlyscan = off;
PREPARE ybaggtest_mpk_is AS SELECT COUNT(*) FROM ybaggtest_mpk WHERE v < 10;
EXPLAIN (COSTS OFF) EXECUTE ybaggtest_mpk_is;
                       QUERY PLAN                        
---------------------------------------------------------
 Finalize Aggregate
   ->  Index Scan using ybaggtest_mpk_v on ybaggtest_mpk
         Index Cond: (v < 10)
         Partial Aggregate: true
(4 rows)

RESET enable_indexonlyscan;
SET enable_indexscan = off;
PREPARE ybaggtest_mpk_ios AS SELECT COUNT(*) FROM ybaggtest_mpk WHERE v < 10;
EXPLAIN (COSTS OFF) EXECUTE ybaggtest_mpk_ios;
                          QUERY PLAN                          
--------------------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ybaggtest_mpk_v on ybaggtest_mpk
         Index Cond: (v < 10)
         Partial Aggregate: true
(4 rows)

SET yb_test_skip_binding_scan_keys = on;
EXPLAIN (COSTS OFF) EXECUTE ybaggtest_mpk_is;
                       QUERY PLAN                        
---------------------------------------------------------
 Aggregate
   ->  Index Scan using ybaggtest_mpk_v on ybaggtest_mpk
         Index Cond: (v < 10)
(3 rows)

EXECUTE ybaggtest_mpk_is;
 count 
-------
   100
(1 row)

EXPLAIN (COSTS OFF) EXECUTE ybaggtest_mpk_ios;
                          QUERY PLAN                          
--------------------------------------------------------------
 Aggregate
   ->  Index Only Scan using ybaggtest_mpk_v on ybaggtest_mpk
         Index Cond: (v < 10)
(3 rows)

EXECUTE ybaggtest_mpk_ios;
 count 
-------
   100
(1 row)

RESET yb_test_skip_binding_scan_keys;
DEALLOCATE ybaggtest_mpk_is;
DEALLOCATE ybaggtest_mpk_ios;
RESET enable_seqscan;
RESET enable_bitmapscan;
RESET enable_indexscan;
RESET yb_enable_cbo;
RESET yb_enable_primary_key_decode_from_index;
DROP TABLE ybaggtest_mpk;
--
-- Test NULL rows are handled properly by COUNT.
--
-- Create table without primary key.
CREATE TABLE ybaggtest2 (
    a int
);
-- Create index where column a is not part of the key.
CREATE INDEX NONCONCURRENTLY ybaggtest2index ON ybaggtest2 ((1)) INCLUDE (a);
-- Insert NULL rows.
INSERT INTO ybaggtest2 VALUES (NULL), (NULL);
-- Insert regular rows.
INSERT INTO ybaggtest2 VALUES (1), (2), (3);
-- Verify NULL rows are included in COUNT(*) but not in COUNT(row).
\set ss '/*+SeqScan(ybaggtest2)*/'
\set ios '/*+IndexOnlyScan(ybaggtest2 ybaggtest2index)*/'
\set query 'SELECT COUNT(*) FROM ybaggtest2'
-- tests using run_ss_ios cannot use a plain index scan (so they also cannot use a bitmap index scan)
-- adding a hint would just re-test sequential scan
\set run_ss_ios ':explain :query; :explain :ss :query; :explain :ios :query; :ss :query; :ios :query;'
:run_ss_ios;
