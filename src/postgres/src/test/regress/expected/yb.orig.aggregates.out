-- A filter the index condition implies is dropped from the Index Scan, so the
-- aggregate is pushed down, although DocDB cannot evaluate the filter (a
-- PL/pgSQL function, which the planner cannot inline).
CREATE FUNCTION ybaggtest_udf(int) RETURNS bool LANGUAGE plpgsql IMMUTABLE AS $$ BEGIN RETURN $1 > 0; END $$;
/*+ IndexScan(ybaggtest ybaggtestindexsimple) */ EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ybaggtest WHERE int_4 = 2147483647 AND (int_4 = 2147483647 OR ybaggtest_udf(int_2));
                        QUERY PLAN                        
----------------------------------------------------------
 Finalize Aggregate
   ->  Index Scan using ybaggtestindexsimple on ybaggtest
         Index Cond: (int_4 = 2147483647)
         Partial Aggregate: true
(4 rows)

/*+ IndexScan(ybaggtest ybaggtestindexsimple) */ SELECT COUNT(*) FROM ybaggtest WHERE int_4 = 2147483647 AND (int_4 = 2147483647 OR ybaggtest_udf(int_2));
 count 
-------
    99
(1 row)

