/*+Set(yb_max_merge_scan_streams 64)*/ SELECT id, f4, x FROM num_tbl WHERE f4 = ANY('{1.5,2.5}'::float8[]) ORDER BY id LIMIT 10;
ERROR:  merge scan stream key column "f4" has no usable bound condition
