  YbBatchedNL(w1 w3)
*/
SELECT COUNT(*) FROM w1, w2, w3, w4
 WHERE w3.k = w1.a AND w3.j <= w2.j AND w4.j = w1.a AND w3.v < w1.b + w2.c;
