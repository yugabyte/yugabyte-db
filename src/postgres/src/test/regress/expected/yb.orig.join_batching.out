-- The batched key is a placeholder value, the NULL constant the subquery
-- supplies: the batched index condition is built from it as from a column,
-- and the right join keeps the subquery's row (#24186).
/*+Leading(r2 r1)*/
EXPLAIN (COSTS OFF)
SELECT *
FROM rk1 r1
RIGHT OUTER JOIN (
    (SELECT
        NULL::int AS nullcol
     FROM
        h
     LIMIT 1)) AS r2
ON (r1.a = r2.nullcol);
