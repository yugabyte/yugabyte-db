SELECT COUNT(*)
FROM repro31724 AS t1, repro31724 AS t2, repro31724 AS t3
WHERE t3.c_vc_key  = t2.c_vc
  AND t3.c_int_key = t2.c_int + t1.pk;
 count 
-------
     3
(1 row)

-- Force the issue plan shape: SubPlan on BNL Join Filter with batched
-- c_int_key lookup. Correct COUNT is 1; unfixed builds may return 4.
EXPLAIN (COSTS OFF)
/*+ Leading((t2 (t1 t3))) IndexScan(t3 repro31724_c_int_key_idx) YbBatchedNL(t1 t3) */
SELECT COUNT(*)
FROM repro31724 AS t1, repro31724 AS t2, repro31724 AS t3
WHERE t3.c_vc_key  = t2.c_vc
  AND t3.c_int_key = t2.c_int + t1.pk
  AND t2.c_int IN (
      SELECT s.c_int FROM repro31724 AS s WHERE s.c_vc = t1.c_vc
  );
                                                               QUERY PLAN                                                               
----------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Nested Loop
         ->  Seq Scan on repro31724 t2
         ->  YB Batched Nested Loop Join
               Join Filter: (((t2.c_int + t1.pk) = t3.c_int_key) AND (SubPlan 1))
               Batch Matching: Tuplestore
               ->  Seq Scan on repro31724 t1
               ->  Index Scan using repro31724_c_int_key_idx on repro31724 t3
                     Index Cond: (c_int_key = ANY (ARRAY[(t2.c_int + t1.pk), (t2.c_int + $4), (t2.c_int + $5), ..., (t2.c_int + $12)]))
                     Storage Filter: ((t2.c_vc)::text = (c_vc_key)::text)
               SubPlan 1
                 ->  Seq Scan on repro31724 s
                       Storage Filter: ((c_vc)::text = (t1.c_vc)::text)
(13 rows)

/*+ Leading((t2 (t1 t3))) IndexScan(t3 repro31724_c_int_key_idx) YbBatchedNL(t1 t3) */
SELECT COUNT(*)
FROM repro31724 AS t1, repro31724 AS t2, repro31724 AS t3
WHERE t3.c_vc_key  = t2.c_vc
  AND t3.c_int_key = t2.c_int + t1.pk
  AND t2.c_int IN (
      SELECT s.c_int FROM repro31724 AS s WHERE s.c_vc = t1.c_vc
  );
