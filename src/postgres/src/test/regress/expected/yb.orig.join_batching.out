-- GEQO ignores join hints, and without the check its own search picks the
-- split for the four-relation query above.
-- Expected: t1b.b + t1a.b is never probed with t1a and t1b batched by different
-- joins, and the count matches that query's unbatched baseline.
/*+
  Set(geqo_threshold 2)
  Set(enable_seqscan on)
  Set(yb_bnl_batch_size 3)
*/
EXPLAIN (COSTS OFF)
SELECT COUNT(*) FROM p1 t1a, p1 t1b, p5 t2a, p5 t2b
 WHERE t2a.a = t1a.a AND t2b.a = t2a.b AND t2a.b = t1b.b + t1a.b
   AND t1a.a < 60 AND t1b.a < 60;
                                                           QUERY PLAN                                                           
--------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  YB Batched Nested Loop Join
         Join Filter: (t2a.b = t2b.a)
         ->  YB Batched Nested Loop Join
               Join Filter: ((t1a.a = t2a.a) AND ((t1b.b + t1a.b) = t2a.b))
               ->  Nested Loop
                     ->  Seq Scan on p1 t1b
                           Storage Filter: (a < 60)
                     ->  Seq Scan on p1 t1a
                           Storage Filter: (a < 60)
               ->  Index Scan using p5_pkey on p5 t2a
                     Index Cond: (ROW(a, b) = ANY (ARRAY[ROW(t1a.a, (t1b.b + t1a.b)), ROW($1, ($4 + $7)), ROW($2, ($5 + $8))]))
         ->  Index Only Scan using p5_hash_asc on p5 t2b
               Index Cond: (a = ANY (ARRAY[t2a.b, $10, $11]))
(14 rows)

