-- The scalar parameter (w2) comes from two joins above the batched join; the
-- withheld clause passes through the intermediate batched join on w4.
/*+
  Set(yb_enable_cbo on)
  Set(enable_hashjoin off)
  Set(enable_mergejoin off)
  Set(enable_material off)
  Set(yb_bnl_batch_size 3)
  Set(enable_nestloop on)
  Set(enable_seqscan on)
  Leading((w2 (w4 (w1 w3))))
  IndexScan(w3)
  YbBatchedNL(w1 w3)
*/
EXPLAIN (COSTS OFF)
SELECT COUNT(*) FROM w1, w2, w3, w4
 WHERE w3.k = w1.a AND w3.j <= w2.j AND w4.j = w1.a AND w3.v < w1.b + w2.c;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Aggregate
   ->  Nested Loop
         ->  Seq Scan on w2
         ->  YB Batched Nested Loop Join
               Join Filter: (w3.k = w4.j)
               ->  Seq Scan on w4
               ->  YB Batched Nested Loop Join
                     Join Filter: ((w1.a = w3.k) AND (w3.v < (w1.b + w2.c)))
                     ->  Index Scan using w1_pkey on w1
                           Index Cond: (a = ANY (ARRAY[w4.j, $1, $2]))
                     ->  Index Scan using w3_pkey on w3
                           Index Cond: ((k = ANY (ARRAY[w1.a, $4, $5])) AND (j <= w2.j))
(12 rows)

