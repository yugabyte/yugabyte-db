  Set(enable_mergejoin off)
  Set(enable_material off)
  Set(yb_bnl_batch_size 3)
  Set(enable_nestloop on)
  Set(enable_seqscan on)
  Leading((w2 (w4 (w1 w3))))
  IndexScan(w3)
  YbBatchedNL(w1 w3)
*/
EXPLAIN (COSTS OFF)
SELECT COUNT(*) FROM w1, w2, w3, w4
 WHERE w3.k = w1.a AND w3.j <= w4.j AND w4.j = w2.j AND w3.v < w1.b + w4.c;
                                       QUERY PLAN                                        
-----------------------------------------------------------------------------------------
 Aggregate
   ->  Nested Loop
         Join Filter: (w4.j = w2.j)
         ->  Seq Scan on w2
         ->  Nested Loop
               ->  Seq Scan on w4
               ->  YB Batched Nested Loop Join
                     Join Filter: ((w1.a = w3.k) AND (w3.v < (w1.b + w4.c)))
                     ->  Seq Scan on w1
                     ->  Index Scan using w3_pkey on w3
                           Index Cond: ((k = ANY (ARRAY[w1.a, $1, $2])) AND (j <= w4.j))
(11 rows)

