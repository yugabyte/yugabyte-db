(30 rows)

RESET yb_bnl_enable_hashing;
--
-- Same shapes with partitionwise join off: plans should be unchanged
--
SET enable_partitionwise_join = off;
EXPLAIN (COSTS OFF)
SELECT t1.a, t1.c, t2.b, t2.c FROM prt1 t1, prt2 t2 WHERE t1.a = t2.b AND t1.b = 0 ORDER BY t1.a, t2.b;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: t1.a
   ->  YB Batched Nested Loop Join
         Join Filter: (t2.b = t1.a)
         ->  Append
               ->  Seq Scan on prt2_p1 t2_1
               ->  Seq Scan on prt2_p2 t2_2
               ->  Seq Scan on prt2_p3 t2_3
         ->  Append
               ->  Index Scan using iprt1_p1_a on prt1_p1 t1_1
                     Index Cond: (a = ANY (ARRAY[t2.b, $1, $2]))
                     Filter: (b = 0)
               ->  Index Scan using iprt1_p2_a on prt1_p2 t1_2
                     Index Cond: (a = ANY (ARRAY[t2.b, $1, $2]))
                     Filter: (b = 0)
               ->  Index Scan using iprt1_p3_a on prt1_p3 t1_3
                     Index Cond: (a = ANY (ARRAY[t2.b, $1, $2]))
                     Filter: (b = 0)
(18 rows)

SELECT t1.a, t1.c, t2.b, t2.c FROM prt1 t1, prt2 t2 WHERE t1.a = t2.b AND t1.b = 0 ORDER BY t1.a, t2.b;
  a  |  c   |  b  |  c   
-----+------+-----+------
   0 | 0000 |   0 | 0000
 150 | 0150 | 150 | 0150
 300 | 0300 | 300 | 0300
 450 | 0450 | 450 | 0450
(4 rows)

EXPLAIN (COSTS OFF)
SELECT COUNT(*) FROM prt1 t1
  LEFT JOIN prt1 t2 ON t1.a = t2.a
  LEFT JOIN prt1 t3 ON t2.a = t3.a;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Aggregate
   ->  YB Batched Nested Loop Left Join
         Join Filter: (t2.a = t3.a)
         ->  YB Batched Nested Loop Left Join
               Join Filter: (t1.a = t2.a)
               ->  Append
                     ->  Seq Scan on prt1_p1 t1_1
                     ->  Seq Scan on prt1_p2 t1_2
                     ->  Seq Scan on prt1_p3 t1_3
               ->  Append
                     ->  Index Only Scan using iprt1_p1_a on prt1_p1 t2_1
                           Index Cond: (a = ANY (ARRAY[t1.a, $1, $2]))
                     ->  Index Only Scan using iprt1_p2_a on prt1_p2 t2_2
                           Index Cond: (a = ANY (ARRAY[t1.a, $1, $2]))
                     ->  Index Only Scan using iprt1_p3_a on prt1_p3 t2_3
                           Index Cond: (a = ANY (ARRAY[t1.a, $1, $2]))
         ->  Append
               ->  Index Only Scan using iprt1_p1_a on prt1_p1 t3_1
                     Index Cond: (a = ANY (ARRAY[t2.a, $4, $5]))
               ->  Index Only Scan using iprt1_p2_a on prt1_p2 t3_2
                     Index Cond: (a = ANY (ARRAY[t2.a, $4, $5]))
               ->  Index Only Scan using iprt1_p3_a on prt1_p3 t3_3
                     Index Cond: (a = ANY (ARRAY[t2.a, $4, $5]))
(23 rows)

SELECT COUNT(*) FROM prt1 t1
  LEFT JOIN prt1 t2 ON t1.a = t2.a
  LEFT JOIN prt1 t3 ON t2.a = t3.a;
 count 
-------
   300
(1 row)

RESET enable_partitionwise_join;
--
-- Mismatched partition bounds: partitionwise join cannot apply even when
-- enabled, so this exercises BNL with a partitioned inner directly.
--
SET enable_partitionwise_join = on;
EXPLAIN (COSTS OFF)
SELECT t1.a, t1.c, t2.b, t2.c FROM prt1 t1, prt4_n t2 WHERE t1.a = t2.a ORDER BY t1.a;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: t1.a
   ->  YB Batched Nested Loop Join
         Join Filter: (t2.a = t1.a)
         ->  Append
               ->  Seq Scan on prt4_n_p1 t2_1
               ->  Seq Scan on prt4_n_p2 t2_2
               ->  Seq Scan on prt4_n_p3 t2_3
         ->  Append
               ->  Index Scan using iprt1_p1_a on prt1_p1 t1_1
                     Index Cond: (a = ANY (ARRAY[t2.a, $1, $2]))
               ->  Index Scan using iprt1_p2_a on prt1_p2 t1_2
                     Index Cond: (a = ANY (ARRAY[t2.a, $1, $2]))
               ->  Index Scan using iprt1_p3_a on prt1_p3 t1_3
                     Index Cond: (a = ANY (ARRAY[t2.a, $1, $2]))
(15 rows)

