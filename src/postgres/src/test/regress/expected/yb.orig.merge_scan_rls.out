/*+IndexScan(bkt_tbl bkt_tbl_expr_idx) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops on)*/ SELECT r1, r2, r3, r4, r5 FROM bkt_tbl ORDER BY r1, r2, r3, r4, r5 LIMIT 5;
(output identical to previous)
\unset Q2
-- A clause on the generated bucket column, without derivation: the clause
-- matches the leading pk column and is leakproof (bare int column, builtin
-- equality), so it remains securely promotable under RLS.  The promoted clause
-- supplies the pk streams.
\set Q1 '/*+IndexScan(bkt_tbl bkt_tbl_pkey) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/'
\set query ':P :Q1 SELECT r1, r2, r3, r4, r5, bkt FROM bkt_tbl WHERE bkt IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+IndexScan(bkt_tbl bkt_tbl_pkey) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/ SELECT r1, r2, r3, r4, r5, bkt FROM bkt_tbl WHERE bkt IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Limit (actual rows=5 loops=1)
   Output: r1, r2, r3, r4, r5, bkt
   ->  Index Scan using bkt_tbl_pkey on public.bkt_tbl (actual rows=5 loops=1)
         Output: r1, r2, r3, r4, r5, bkt
         Index Cond: (bkt_tbl.bkt = ANY ('{0,1,2}'::integer[]))
         Merge Sort Key: bkt_tbl.r1, bkt_tbl.r2, bkt_tbl.r3, bkt_tbl.r4, bkt_tbl.r5
         Merge Stream Key: bkt_tbl.bkt
         Merge Streams: 3
         Merge Cond: (bkt_tbl.bkt = ANY ('{0,1,2}'::integer[]))
         Storage Filter: (bkt_tbl.n >= 0)
         Storage Table Read Requests: 1
         Storage Table Read Ops: 3
         Storage Table Rows Scanned: 15
(13 rows)

/*+IndexScan(bkt_tbl bkt_tbl_pkey) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/ SELECT r1, r2, r3, r4, r5, bkt FROM bkt_tbl WHERE bkt IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;
 r1 | r2 | r3 | r4 | r5 | bkt 
----+----+----+----+----+-----
  0 |  0 |  0 |  6 |  8 |   2
  0 |  0 |  0 |  6 |  9 |   0
  0 |  0 |  0 |  8 |  9 |   2
  0 |  0 |  1 |  1 |  3 |   1
  0 |  0 |  1 |  3 |  4 |   1
(5 rows)

-- A clause on the index expression, without derivation: the clause matches the
-- secondary index expression, but neither yb_hash_code nor int4mod is
-- leakproof, so under RLS the clause is not securely promotable and must not
-- form merge streams.  The hint falls back to an ordinary sorted plan with the
-- clause as a filter.
\set Q1 '/*+IndexScan(bkt_tbl bkt_tbl_expr_idx) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/'
\set query ':P :Q1 SELECT r1, r2, r3, r4, r5, yb_hash_code(r3, r2, r4, r5, r1) % 3 FROM bkt_tbl WHERE yb_hash_code(r3, r2, r4, r5, r1) % 3 IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+IndexScan(bkt_tbl bkt_tbl_expr_idx) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/ SELECT r1, r2, r3, r4, r5, yb_hash_code(r3, r2, r4, r5, r1) % 3 FROM bkt_tbl WHERE yb_hash_code(r3, r2, r4, r5, r1) % 3 IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;
                                                             QUERY PLAN                                                              
-------------------------------------------------------------------------------------------------------------------------------------
 Limit (actual rows=5 loops=1)
   Output: r1, r2, r3, r4, r5, ((yb_hash_code(r3, r2, r4, r5, r1) % 3))
   ->  Sort (actual rows=5 loops=1)
         Output: r1, r2, r3, r4, r5, ((yb_hash_code(r3, r2, r4, r5, r1) % 3))
         Sort Key: bkt_tbl.r1, bkt_tbl.r2, bkt_tbl.r3, bkt_tbl.r4, bkt_tbl.r5
         Sort Method: top-N heapsort
         ->  Seq Scan on public.bkt_tbl (actual rows=5048 loops=1)
               Output: r1, r2, r3, r4, r5, (yb_hash_code(r3, r2, r4, r5, r1) % 3)
               Storage Filter: (bkt_tbl.n >= 0)
               Filter: ((yb_hash_code(bkt_tbl.r3, bkt_tbl.r2, bkt_tbl.r4, bkt_tbl.r5, bkt_tbl.r1) % 3) = ANY ('{0,1,2}'::integer[]))
               Storage Table Read Requests: 3
               Storage Table Read Ops: 11
               Storage Table Rows Scanned: 5048
(13 rows)

/*+IndexScan(bkt_tbl bkt_tbl_expr_idx) Set(yb_max_merge_scan_streams 64) Set(yb_enable_derived_saops off)*/ SELECT r1, r2, r3, r4, r5, yb_hash_code(r3, r2, r4, r5, r1) % 3 FROM bkt_tbl WHERE yb_hash_code(r3, r2, r4, r5, r1) % 3 IN (0, 1, 2) ORDER BY r1, r2, r3, r4, r5 LIMIT 5;
