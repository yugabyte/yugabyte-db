/*+Set(yb_max_merge_scan_streams 64)*/ SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;
(output identical to previous)
/*+Set(enable_sort off) Set(yb_max_merge_scan_streams 64)*/ SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;
(output identical to previous)
-- The same broken EquivalenceClass, with the query also holding d at
-- 2020-01-02.  date = date is leakproof, so that clause binds d as an index
-- condition, and d is a stream key.
\set query ':P :Q SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND d = make_date(2020, 1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND d = make_date(2020, 1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;
                                                                      QUERY PLAN                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit (actual rows=4 loops=1)
   Output: c, s, d
   ->  Sort (actual rows=4 loops=1)
         Output: c, s, d
         Sort Key: rls_ec_tbl.c
         Sort Method: top-N heapsort
         ->  Index Scan using rls_ec_tbl_pkey on public.rls_ec_tbl (actual rows=50 loops=1)
               Output: c, s, d
               Index Cond: ((rls_ec_tbl.s = ANY ('{1,2}'::integer[])) AND (rls_ec_tbl.d = '01-02-2020'::date) AND (rls_ec_tbl.d = '01-02-2020'::date))
               Storage Filter: ((rls_ec_tbl.d = rls_ec_tbl.t) AND (rls_ec_tbl.t = 'Thu Jan 02 00:00:00 2020'::timestamp without time zone))
               Storage Table Read Requests: 1
               Storage Table Read Ops: 1
               Storage Table Rows Scanned: 51
(13 rows)

EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 64)*/ SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND d = make_date(2020, 1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;
(output identical to previous)
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(enable_sort off) Set(yb_max_merge_scan_streams 64)*/ SELECT c, s, d FROM rls_ec_tbl WHERE s IN (1, 2) AND d = make_date(2020, 1, 2) AND t = make_timestamp(2020, 1, 2, 0, 0, 0) ORDER BY c LIMIT 4;
                                                                   QUERY PLAN                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------
 Limit (actual rows=4 loops=1)
   Output: c, s, d
   ->  Index Scan using rls_ec_tbl_pkey on public.rls_ec_tbl (actual rows=4 loops=1)
         Output: c, s, d
         Index Cond: ((rls_ec_tbl.s = ANY ('{1,2}'::integer[])) AND (rls_ec_tbl.d = '01-02-2020'::date) AND (rls_ec_tbl.d = '01-02-2020'::date))
         Merge Sort Key: rls_ec_tbl.c
