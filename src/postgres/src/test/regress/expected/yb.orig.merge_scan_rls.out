         Index Cond: ((yb_hash_code(bkt_tbl.r3, bkt_tbl.r2, bkt_tbl.r4, bkt_tbl.r5, bkt_tbl.r1) % 3) = ANY ('{0,1,2}'::integer[]))
         Merge Sort Key: bkt_tbl.r1, bkt_tbl.r2, bkt_tbl.r3, bkt_tbl.r4, bkt_tbl.r5
         Merge Stream Key: (yb_hash_code(bkt_tbl.r3, bkt_tbl.r2, bkt_tbl.r4, bkt_tbl.r5, bkt_tbl.r1) % 3)
         Merge Streams: 3
         Merge Cond: ((yb_hash_code(bkt_tbl.r3, bkt_tbl.r2, bkt_tbl.r4, bkt_tbl.r5, bkt_tbl.r1) % 3) = ANY ('{0,1,2}'::integer[]))
         Storage Filter: (bkt_tbl.n >= 0)
         Storage Table Read Requests: 1
         Storage Table Read Ops: 3
         Storage Table Rows Scanned: 11
         Storage Index Read Requests: 1
         Storage Index Read Ops: 3
         Storage Index Rows Scanned: 15
(16 rows)

