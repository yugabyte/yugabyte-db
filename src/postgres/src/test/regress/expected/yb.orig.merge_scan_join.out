\set query ':explain :Q SELECT * FROM r5n JOIN h3r2n ON r5n.r4 = h3r2n.r1 AND r5n.r5 = h3r2n.r2 WHERE r5n.r1 = 1 AND r5n.r2 IN (6, 7, 8, 9, 10) AND r5n.r3 IN (1, 2, 3, 4, 5) LIMIT 5;'
\i :run_query
\set _echo_run_query :ECHO
