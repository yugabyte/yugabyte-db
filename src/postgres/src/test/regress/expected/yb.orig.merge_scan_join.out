--
-- See yb_merge_scan_schedule for details about the test.  Do not sort on the
-- r5n.n column because that ruins the plans.
--
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/merge_scan_setup.sql'
\i :filename
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/yb_commands/parameterized_query.sql'
\i :filename
\set _echo_parameterized_query :ECHO
\set ECHO none
\set explain 'EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF)'
\set off '/*+Set(yb_max_merge_scan_streams 0)*/'
\set on '/*+Set(yb_max_merge_scan_streams 64)*/'
\set P1 ':explain'
\set P2
\set Q1 ':off'
\set Q2 ':on'
-- Small response pages make the execution metrics of the plan variants
-- distinct without growing the tables: at the default page size their rows
-- come back in one read request either way.
SET yb_fetch_row_limit = 16;
-- Basic join without order
-- Third hint is to show hash join rightfully does not use merge scan.
-- Fourth hint is to show merge scan in a merge join.
-- Fifth hint is to show merge scan in the inner side of a merge join.
\set query ':explain :Q SELECT DISTINCT ON (a.r3, a.r4) * FROM r5n a JOIN r5n b ON a.r3 = b.r1 WHERE a.r1 = 9 AND a.r2 IN (3, 4, 5) LIMIT 5;'
\set Q3 '/*+HashJoin(a b) Set(yb_max_merge_scan_streams 64)*/'
\set Q4 '/*+MergeJoin(a b) Set(yb_max_merge_scan_streams 64)*/'
\set Q5 '/*+MergeJoin(a b) Leading((b a)) Set(yb_max_merge_scan_streams 64)*/'
\i :run_query
\set _echo_run_query :ECHO
\set ECHO none
EXPLAIN (ANALYZE, DIST, VERBOSE, COSTS OFF, SUMMARY OFF, TIMING OFF) /*+Set(yb_max_merge_scan_streams 0)*/ SELECT DISTINCT ON (a.r3, a.r4) * FROM r5n a JOIN r5n b ON a.r3 = b.r1 WHERE a.r1 = 9 AND a.r2 IN (3, 4, 5) LIMIT 5;
                                            QUERY PLAN                                            
--------------------------------------------------------------------------------------------------
 Limit (actual rows=5 loops=1)
   Output: a.n, a.r5, a.r3, a.r1, a.r2, a.r4, b.n, b.r5, b.r3, b.r1, b.r2, b.r4
   ->  Unique (actual rows=5 loops=1)
         Output: a.n, a.r5, a.r3, a.r1, a.r2, a.r4, b.n, b.r5, b.r3, b.r1, b.r2, b.r4
         ->  Sort (actual rows=4294 loops=1)
               Output: a.n, a.r5, a.r3, a.r1, a.r2, a.r4, b.n, b.r5, b.r3, b.r1, b.r2, b.r4
               Sort Key: a.r3, a.r4
               Sort Method: external merge
               ->  YB Batched Nested Loop Join (actual rows=82301 loops=1)
                     Output: a.n, a.r5, a.r3, a.r1, a.r2, a.r4, b.n, b.r5, b.r3, b.r1, b.r2, b.r4
                     Join Filter: (a.r3 = b.r1)
                     ->  Index Scan using r5n_pkey on public.r5n a (actual rows=163 loops=1)
                           Output: a.n, a.r5, a.r3, a.r1, a.r2, a.r4
                           Index Cond: ((a.r1 = 9) AND (a.r2 = ANY ('{3,4,5}'::bigint[])))
                           Storage Table Read Requests: 11
                           Storage Table Read Ops: 11
                           Storage Table Rows Scanned: 163
                     ->  Index Scan using r5n_pkey on public.r5n b (actual rows=5048 loops=1)
                           Output: b.n, b.r5, b.r3, b.r1, b.r2, b.r4
                           Index Cond: (b.r1 = ANY (ARRAY[a.r3, ...]))
                           Storage Table Read Requests: 320
                           Storage Table Read Ops: 320
                           Storage Table Rows Scanned: 5048
(23 rows)

