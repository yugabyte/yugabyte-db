--
-- GH #30978 with DDL savepoints on: once a DDL has run in a transaction
-- block, no query in the block gets a parallel plan, even after ROLLBACK TO
-- a savepoint that undoes the DDL: ROLLBACK TO does not clear the block's
-- DDL state, so the block stays serial until it ends. Companion of
-- yb.orig.ddl_txn_parallel, which says why the block is serial, and
-- whose schedule turns DDL savepoint support off (#33497).
--
SET yb_enable_cbo = on;
SET force_parallel_mode = on;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET yb_parallel_range_rows = 1;
CREATE TABLE ddl_sp_par (id INT, PRIMARY KEY (id ASC));
INSERT INTO ddl_sp_par SELECT i FROM generate_series(1, 1000) i;
ANALYZE ddl_sp_par;
-- ROLLBACK TO a savepoint taken before the DDL: the DDL is undone, but the
-- block stays serial.
BEGIN;
SAVEPOINT s1;
ALTER TABLE ddl_sp_par ADD COLUMN c TEXT DEFAULT 'g';
ROLLBACK TO SAVEPOINT s1;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_sp_par;
                        QUERY PLAN                         
-----------------------------------------------------------
 Finalize Aggregate
   ->  Index Only Scan using ddl_sp_par_pkey on ddl_sp_par
         Partial Aggregate: true
(3 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  SELECT COUNT(*) FROM ddl_sp_par;
                                    QUERY PLAN                                     
-----------------------------------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Index Only Scan using ddl_sp_par_pkey on ddl_sp_par (actual rows=1 loops=1)
         Heap Fetches: 0
         Partial Aggregate: true
(4 rows)

SELECT COUNT(*) FROM ddl_sp_par;
 count 
-------
  1000
(1 row)

COMMIT;
-- Once the block ends, the query gets a parallel plan again.
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_sp_par;
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Noop Aggregate
               ->  Parallel Index Only Scan using ddl_sp_par_pkey on ddl_sp_par
                     Partial Aggregate: true
(6 rows)

-- GH #30978 as filed: REPEATABLE READ, a DDL, a savepoint, more DDL after
-- the savepoint, then ROLLBACK TO it. The DDL before the savepoint stays, so
-- a worker would not see column c.
BEGIN ISOLATION LEVEL REPEATABLE READ;
ALTER TABLE ddl_sp_par ADD COLUMN c TEXT DEFAULT 'g';
SAVEPOINT s2;
CREATE INDEX ddl_sp_par_c ON ddl_sp_par (c);
NOTICE:  making create index for table "ddl_sp_par" nonconcurrent
DETAIL:  Create index in transaction block cannot be concurrent.
HINT:  Consider running it outside of a transaction block. See https://github.com/yugabyte/yugabyte-db/issues/6240.
UPDATE ddl_sp_par SET c = 'special' WHERE id <= 10;
ROLLBACK TO SAVEPOINT s2;
EXPLAIN (COSTS OFF) SELECT COUNT(*) FROM ddl_sp_par WHERE c = 'g';
               QUERY PLAN                
-----------------------------------------
 Finalize Aggregate
   ->  Seq Scan on ddl_sp_par
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)
  SELECT COUNT(*) FROM ddl_sp_par WHERE c = 'g';
                      QUERY PLAN                      
------------------------------------------------------
 Finalize Aggregate (actual rows=1 loops=1)
   ->  Seq Scan on ddl_sp_par (actual rows=1 loops=1)
         Storage Filter: (c = 'g'::text)
         Partial Aggregate: true
(4 rows)

SELECT COUNT(*) FROM ddl_sp_par WHERE c = 'g';
 count 
-------
  1000
(1 row)

ROLLBACK;
DROP TABLE ddl_sp_par;
RESET force_parallel_mode;
