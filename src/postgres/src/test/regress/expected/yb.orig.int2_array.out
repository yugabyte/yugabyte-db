EXPLAIN (COSTS OFF) SELECT min(a), max(a) FROM int2vector_rs_idx;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Aggregate
   ->  Index Only Scan using int2vector_rs_idx_a on int2vector_rs_idx
