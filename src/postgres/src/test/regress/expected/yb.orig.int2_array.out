                       QUERY PLAN                        
---------------------------------------------------------
 Aggregate
   ->  Seq Scan on int2vector_rowcmp_test
         Filter: (ROW(v, k) > ROW('1 2'::int2vector, 0))
(3 rows)

SELECT array_agg(k ORDER BY k) FROM int2vector_rowcmp_test WHERE (v, k) > ('1 2', 0);
