/* YB: workaround for lack of transactional DDL
BEGIN;
*/ -- YB
CREATE EXTENSION IF NOT EXISTS anon CASCADE;
CREATE TABLE hundred AS
SELECT generate_series(1,100) AS h;
BEGIN; -- YB: workaround for lack of transactional DDL
SAVEPOINT before_error_invalid_label;
  SECURITY LABEL FOR anon ON TABLE hundred IS 'INVALID LABEL';
ERROR:  Anon: `INVALID LABEL` is not a valid label for a table
ROLLBACK TO before_error_invalid_label;
SAVEPOINT before_error_invalid_label2;
  SECURITY LABEL FOR anon ON DATABASE :DBNAME IS 'INVALID LABEL'; -- YB: the database doesn't need to be 'contrib_regression'
ERROR:  Anon: `INVALID LABEL` is not a valid label for a database
ROLLBACK TO before_error_invalid_label2;
SAVEPOINT before_sql_injection;
  SECURITY LABEL FOR anon ON TABLE hundred
  IS 'TABLESAMPLE BERNOULLI (33); CREATE ROLE bob SUPERUSER;';
ERROR:  Anon: `TABLESAMPLE BERNOULLI (33); CREATE ROLE bob SUPERUSER;` is not a valid label for a table
DETAIL:  TABLESAMPLE BERNOULLI (33); CREATE ROLE bob SUPERUSER; is not a valid expression
ROLLBACK TO before_sql_injection;
SECURITY LABEL FOR anon ON TABLE hundred
IS 'TABLESAMPLE SYSTEM(33)';
SECURITY LABEL FOR anon ON TABLE hundred IS NULL;
SECURITY LABEL FOR anon ON DATABASE :DBNAME -- YB: the database doesn't need to be 'contrib_regression'
IS 'TABLESAMPLE BERNOULLI(50)';
SECURITY LABEL FOR anon ON COLUMN hundred.h
IS 'MASKED WITH VALUE 0';
SELECT count(*) = 100 FROM hundred;
 ?column? 
----------
 t
(1 row)

--
-- Transparent Dynamic Masking
--
CREATE ROLE jimmy LOGIN;
SECURITY LABEL FOR anon ON ROLE jimmy IS 'MASKED';
GRANT USAGE ON SCHEMA public TO jimmy;
GRANT ALL ON ALL TABLES IN SCHEMA public TO jimmy;
SET ROLE jimmy;
SELECT count(*) = 100 FROM hundred;
 ?column? 
----------
 t
(1 row)

RESET ROLE;
SET anon.transparent_dynamic_masking TO true;
/* YB(#4288): TABLESAMPLE is not supported; a masked read of a sampled table errors
SET ROLE jimmy;
SELECT count(*) < 100 FROM hundred;
RESET ROLE;
*/ -- YB
SET anon.transparent_dynamic_masking TO false;
--
-- Static Masking
--
-- This should raise a notice
SELECT anon.anonymize_column('hundred','h');
NOTICE:  The TABLESAMPLE rule will be ignored.
            Only anonymize_table() and anonymize_database() can apply sampling rules
 anonymize_column 
------------------
 t
(1 row)

-- The sampling rule is ignored, the table is NOT sampled
SELECT count(*) = 100 FROM hundred;
 ?column? 
----------
 t
(1 row)

/* YB(#4288): TABLESAMPLE is not supported; static masking of a sampled table errors
SAVEPOINT before_anonymize_database;
SELECT anon.anonymize_database();
SELECT count(*) < 100 FROM hundred;
ROLLBACK TO before_anonymize_database;

SAVEPOINT before_anonymize_table;
SELECT anon.anonymize_table('hundred');
SELECT count(*) < 100 FROM hundred;
ROLLBACK TO before_anonymize_table;
*/ -- YB
SECURITY LABEL FOR anon ON DATABASE :DBNAME IS NULL; -- YB: the database doesn't need to be 'contrib_regression'
ROLLBACK;
RESET ROLE; -- YB: workaround for lack of transactional DDL
SECURITY LABEL FOR anon ON DATABASE :DBNAME IS NULL; -- YB: workaround for lack of transactional DDL
DROP TABLE hundred CASCADE; -- YB: workaround for lack of transactional DDL
REVOKE ALL PRIVILEGES ON SCHEMA public FROM jimmy; -- YB: workaround for lack of transactional DDL
DROP ROLE jimmy; -- YB: workaround for lack of transactional DDL
DROP EXTENSION anon CASCADE; -- YB: workaround for lack of transactional DDL
