if [[ -z "{{ package_path | default('') }}" ]]; then
  package_path="{{ ynp_dir }}/../../thirdparty"
else
  package_path="{{ package_path }}"
fi

yb_user="{{ yb_user }}"
node_exporter_port="{{ node_exporter_port }}"
# Directory used by node_exporter's textfile collector for YugabyteDB metrics.
metrics_dir="{{ yb_home_dir }}/metrics"
# Installed under the yb home like the DB servers, YBC and the OTel collector.
install_dir="{{ yb_home_dir }}/node_exporter"
web_config="$install_dir/web.yml"
systemd_dir="{{ yb_user_home }}/.config/systemd/user"
unit_path="$systemd_dir/node_exporter.service"

# The module runs as the DB user, or as root when provisioning has sudo, like ConfigureSystemd.
ne_systemctl() {
    local cmd="XDG_RUNTIME_DIR=/run/user/$(id -u "$yb_user") systemctl --user $*"
    if [ "$SUDO_ACCESS" = "true" ]; then
        su - "$yb_user" -c "$cmd"
    else
        bash -c "$cmd"
    fi
}

# ConfigureRootSystemd removes the root-level unit that YBA versions before 2026.2 laid out; without
# root it stays, and holds the exporter port.
if [ -f /etc/systemd/system/node_exporter.service ]; then
    echo "Root-level node_exporter.service is installed. Run with root provisioning to migrate it" \
        "to user-level systemd"
    exit 1
fi

# Detect system architecture
arch=$(uname -m)
if [[ "$arch" == "x86_64" ]]; then
    node_exporter_package="node_exporter-1.12.1-fips.linux-amd64.tar.gz"
    node_exported_package_name="node_exporter-1.12.1-fips.linux-amd64"
elif [[ "$arch" == "aarch64" ]]; then
    node_exporter_package="node_exporter-1.12.1-fips.linux-arm64.tar.gz"
    node_exported_package_name="node_exporter-1.12.1-fips.linux-arm64"
else
    echo "Unsupported architecture: $arch"
    exit 1
fi
if [ ! -f "$package_path/$node_exporter_package" ]; then
    echo "Error: $node_exporter_package not found in $package_path"
    exit 1
fi

mkdir -p "$install_dir" "$metrics_dir"
tar zxf "$package_path/$node_exporter_package" -C "$install_dir"
# web.yml is the only file that changes after provisioning: empty means plain HTTP, and node-agent
# writes the TLS server config into it once the certs exist. Never overwrite it here, so a
# reprovision keeps the universe's TLS state.
[ -f "$web_config" ] || : > "$web_config"
if [ "$SUDO_ACCESS" = "true" ]; then
    chown -R "$yb_user":"$yb_user" "$install_dir" "$metrics_dir"
    su - "$yb_user" -c "mkdir -p '$systemd_dir'"
else
    mkdir -p "$systemd_dir"
fi
chmod 750 "$install_dir"
chmod 640 "$web_config"
chmod -R 755 "$metrics_dir"

exec_args=(
    "--web.listen-address=:$node_exporter_port"
    "--web.config.file=$web_config"
    "--collector.textfile.directory=$metrics_dir"
)

# Create the temp file beside the unit, not in /tmp: mv keeps a file's SELinux label, and systemd is
# denied reading a unit that still carries /tmp's label. Hidden and without the .service suffix,
# systemd never loads it as a unit.
tmp_file=$(mktemp "$systemd_dir/.node_exporter.service.XXXXXX")
cat <<EOL > "$tmp_file"
[Unit]
Description=node_exporter - Exporter for machine metrics.
After=network-online.target
StartLimitInterval=100
StartLimitBurst=10

[Install]
WantedBy=default.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
{% if configure_fips != 'True' %}
# node_exporter is a GOFIPS140 build, which defaults to FIPS mode and its strict TLS rules.
Environment="GODEBUG=fips140=off"
{% endif %}
ExecStart=$install_dir/$node_exported_package_name/node_exporter ${exec_args[*]}
EOL
chmod 644 "$tmp_file"
if [ "$SUDO_ACCESS" = "true" ]; then
    chown "$yb_user":"$yb_user" "$tmp_file"
fi
mv "$tmp_file" "$unit_path"

# Restart unconditionally: the unit's binary path, port and textfile directory all come
# from provisioning input, and a running node_exporter keeps its old values until restarted.
# A restart only costs one scrape, so no attempt is made to detect what changed.
ne_systemctl daemon-reload
ne_systemctl enable node_exporter
ne_systemctl restart node_exporter

# Verify the listener, so provisioning fails if the exporter does not come up.
for _ in $(seq 1 30); do
    if ne_systemctl is-active --quiet node_exporter \
        && (exec 3<>"/dev/tcp/127.0.0.1/$node_exporter_port") 2>/dev/null; then
        echo "Node exporter setup is complete (serving on :$node_exporter_port as $yb_user)."
        exit 0
    fi
    sleep 1
done
echo "node_exporter did not start listening on :$node_exporter_port"
exit 1
