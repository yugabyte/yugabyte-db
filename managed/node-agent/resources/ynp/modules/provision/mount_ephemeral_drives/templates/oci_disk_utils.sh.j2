# OCI data disk discovery helpers.
#
# YBA attaches OCI block volumes to the running instance without a device path,
# and asks for them as sdb, sdc, ..., assuming the boot volume is sda. The
# kernel doesn't always name them in that order: the boot volume can take a
# requested name, and a data volume a name YBA did not request.
#
# The caller defines:
#   DEV_ROOT            (normally /dev)
#   FSTAB_PATH          (normally /etc/fstab)
#   DEFAULT_SSD_DRIVES  the device names YBA requested, e.g. "sdb sdc"
#   mounts              the mount paths YBA requested, in the same order

# Sets oci_disk_tree_rv to the disk's lsblk tree, as "NAME MOUNTPOINT" lines.
# Returns 1 when the disk does not exist, and 2 when lsblk fails otherwise.
oci_disk_tree() {
  local rc=0
  oci_disk_tree_rv=$(lsblk -nr -o NAME,MOUNTPOINT "$DEV_ROOT/$1") || rc=$?
  # lsblk exits 32 when none of the given devices exist.
  if [[ $rc -eq 32 ]]; then
    return 1
  elif [[ $rc -ne 0 ]]; then
    echo >&2 "lsblk failed on $DEV_ROOT/$1 with exit code $rc."
    return 2
  fi
}

# Returns 0 when the given lsblk tree is the boot volume's: it holds /, /boot or
# /boot/efi. lsblk lists an LVM root under the partition that holds it.
oci_tree_is_boot_volume() {
  local entry=""
  local mount_point=""
  while read -r entry mount_point; do
    case "$mount_point" in
      / | /boot | /boot/efi) return 0 ;;
    esac
  done <<< "$1"
  return 1
}

# Returns 0 when the given lsblk tree is a whole disk with nothing under it: no
# partitions, LVM or other holders.
oci_tree_is_whole_disk() {
  [[ "$1" != *$'\n'* ]]
}

# A blank disk has no filesystem, partition table, LVM or RAID signature: blkid
# exits 2 and prints nothing. blkid also exits 2 when it can't open the disk,
# but then says why on stderr.
oci_disk_is_blank() {
  local errors=""
  local rc=0
  errors=$(blkid -p "$DEV_ROOT/$1" 2>&1 >/dev/null) || rc=$?
  if [[ $rc -eq 2 && -z "$errors" ]]; then
    return 0
  fi
  if [[ -n "$errors" ]]; then
    echo >&2 "$errors"
  fi
  return 1
}

# Sets oci_disks to the whole sd disks, those with no partitions, LVM or other
# holders, oci_disk_mounts to where each is mounted, and oci_disk_uuids to each
# one's filesystem UUID, or an empty string. blkid -p reads the disk, so this
# doesn't depend on udev having created the by-uuid links yet.
oci_list_disks() {
  local listing=""
  local name=""
  local device_type=""
  local disk=""
  local disk_mount=""
  local rc=0

  oci_disks=()
  oci_disk_mounts=()
  oci_disk_uuids=()
  listing=$(lsblk -dnr -o NAME,TYPE) || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo >&2 "lsblk failed to list disks with exit code $rc."
    return 1
  fi
  while read -r name device_type; do
    if [[ "$device_type" != "disk" || ! "$name" =~ ^sd[a-z]+$ ]]; then
      continue
    fi
    rc=0
    oci_disk_tree "$name" || rc=$?
    if [[ $rc -eq 2 ]]; then
      echo >&2 "Not using disk $name."
    fi
    if [[ $rc -ne 0 ]] || ! oci_tree_is_whole_disk "$oci_disk_tree_rv"; then
      continue
    fi
    read -r disk disk_mount <<< "$oci_disk_tree_rv"
    oci_disks+=("$name")
    oci_disk_mounts+=("$disk_mount")
    oci_disk_uuids+=("$(blkid -p -s UUID -o value "$DEV_ROOT/$name" 2>/dev/null || true)")
  done <<< "$listing"
}

# Sets oci_fstab_disk_rv to the disk holding the filesystem that the YBA fstab
# entry for the given mount path names by UUID, or an empty string when there is
# no such entry or no such disk. Returns 1 when the entry is ambiguous.
oci_fstab_disk() {
  local mount_path=$1
  local -a uuids=()
  local j=0

  oci_fstab_disk_rv=""
  if [[ ! -r "$FSTAB_PATH" ]] || ! grep -Fqx -- "#$mount_path" "$FSTAB_PATH"; then
    return 0
  fi
  mapfile -t uuids < <(awk -v mount_path="$mount_path" '
      !/^[[:space:]]*#/ && NF >= 2 && $2 == mount_path && $1 ~ /^UUID=/ {
        print substr($1, 6)
      }
    ' "$FSTAB_PATH")
  # Jinja renders this file, and bash's array length syntax opens a Jinja
  # comment, so test the elements instead.
  if [[ -z "${uuids[0]:-}" ]]; then
    return 0
  elif [[ -n "${uuids[1]:-}" ]]; then
    echo >&2 "$FSTAB_PATH has more than one entry for $mount_path."
    return 1
  fi
  for j in "${!oci_disks[@]}"; do
    if [[ "${oci_disk_uuids[j]}" != "${uuids[0]}" ]]; then
      continue
    fi
    if [[ -n "$oci_fstab_disk_rv" ]]; then
      echo >&2 "Disks $oci_fstab_disk_rv and ${oci_disks[j]} both have UUID ${uuids[0]}."
      return 1
    fi
    oci_fstab_disk_rv=${oci_disks[j]}
  done
}

# Sets get_oci_drives_rv to a device name for each requested name, in order:
#   1. the disk an earlier run put at that name's mount path: the one fstab
#      names by UUID, or else the one mounted there. The kernel can rename disks
#      across reboots, so the requested name may now be another data volume, or
#      the boot volume, and a data volume may be left unmounted (fstab mounts
#      them with nofail).
#   2. otherwise the requested name, unless it is the boot volume or a disk that
#      step 1 gave to another mount path.
#   3. otherwise a blank disk that no other mount path uses. With none, the boot
#      volume's name is kept, and the probe loop skips it.
# Local NVMe names are kept. Returns 1 when lsblk fails on a requested disk, when
# a requested disk other than the boot volume has partitions or holders, which
# mount_drives would format away, when fstab and the mounts disagree or name a
# disk twice, or when a disk at another mount path has no replacement.
get_oci_drives() {
  local -a requested=()
  local -a drives=()
  local -a pending=()
  local name=""
  local mounted=""
  local rc=0
  local i=0
  local j=0

  read -r -a requested <<< "$DEFAULT_SSD_DRIVES"
  oci_list_disks || return 1
  for i in "${!requested[@]}"; do
    drives[i]=""
    if ! [[ "${requested[i]}" =~ ^sd[a-z]+$ && -n "${mounts[i]:-}" ]]; then
      continue
    fi
    mounted=""
    for j in "${!oci_disks[@]}"; do
      if [[ "${oci_disk_mounts[j]}" != "${mounts[i]}" ]]; then
        continue
      fi
      if [[ -n "$mounted" ]]; then
        echo >&2 "Disks $mounted and ${oci_disks[j]} are both mounted at ${mounts[i]}."
        return 1
      fi
      mounted=${oci_disks[j]}
    done
    oci_fstab_disk "${mounts[i]}" || return 1
    if [[ -n "$oci_fstab_disk_rv" && -n "$mounted" && "$oci_fstab_disk_rv" != "$mounted" ]]; then
      echo >&2 "$FSTAB_PATH puts disk $oci_fstab_disk_rv at ${mounts[i]}, but disk $mounted is mounted there."
      return 1
    fi
    name=${oci_fstab_disk_rv:-$mounted}
    if [[ -z "$name" ]]; then
      continue
    fi
    if [[ " ${drives[*]} " == *" $name "* ]]; then
      echo >&2 "Disk $name belongs at more than one mount path."
      return 1
    fi
    drives[i]=$name
    if [[ -n "$oci_fstab_disk_rv" ]]; then
      echo "Disk $name holds the filesystem $FSTAB_PATH mounts at ${mounts[i]}. Using it there."
    else
      echo "Disk $name is already mounted at ${mounts[i]}. Using it there."
    fi
  done

  for i in "${!requested[@]}"; do
    name=${requested[i]}
    if [[ -n "${drives[i]}" ]]; then
      continue
    fi
    if ! [[ "$name" =~ ^sd[a-z]+$ ]]; then
      drives[i]=$name
      continue
    fi
    if [[ " ${drives[*]} " == *" $name "* ]]; then
      echo "Requested disk $name belongs at another mount path."
      pending+=("$i")
      continue
    fi
    rc=0
    oci_disk_tree "$name" || rc=$?
    if [[ $rc -eq 1 ]]; then
      drives[i]=$name
      continue
    elif [[ $rc -ne 0 ]]; then
      echo >&2 "Cannot tell whether requested disk $name is the boot volume."
      return 1
    fi
    if oci_tree_is_boot_volume "$oci_disk_tree_rv"; then
      echo "Requested disk $name is the boot volume."
      pending+=("$i")
      continue
    fi
    if ! oci_tree_is_whole_disk "$oci_disk_tree_rv"; then
      echo >&2 "Requested disk $name has partitions or holders. Refusing to format it."
      return 1
    fi
    drives[i]=$name
  done

  for i in ${pending[@]+"${pending[@]}"}; do
    name=${requested[i]}
    for j in "${!oci_disks[@]}"; do
      if [[ -z "${oci_disk_mounts[j]}" && " ${drives[*]} " != *" ${oci_disks[j]} "* ]] && \
         oci_disk_is_blank "${oci_disks[j]}"; then
        drives[i]=${oci_disks[j]}
        echo "Using blank disk ${drives[i]} instead of $name."
        break
      fi
    done
    if [[ -n "${drives[i]}" ]]; then
      continue
    fi
    if [[ " ${drives[*]} " == *" $name "* ]]; then
      echo >&2 "Requested disk $name belongs at another mount path, and no blank disk can replace it."
      return 1
    fi
    echo >&2 "Requested disk $name is the boot volume, and no blank disk can replace it."
    drives[i]=$name
  done
  get_oci_drives_rv="${drives[*]}"
}
