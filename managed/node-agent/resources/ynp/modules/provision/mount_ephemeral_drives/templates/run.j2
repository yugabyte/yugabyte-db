#
# This script discovers cloud data drives and mounts them at /mnt/d0,
# /mnt/d1, etc. The /etc/fstab file is also updated so that the drives are
# mounted again after a reboot.
#
# This script is based on (is a customized version of) the script:
#     https://gist.github.com/joemiller/6049831
#
set -euo pipefail

readonly CLOUD_TYPE_B64="{{ cloud_type | default('') | base64_encode }}"
readonly DEFAULT_SSD_DRIVES_B64="{{ device_paths | default('') | base64_encode }}"
readonly MOUNT_PATHS_B64="{{ mount_paths | default('') | base64_encode }}"
readonly LUN_INDEXES_B64="{{ disk_lun_indexes | default('') | base64_encode }}"
readonly IMDSV2_REQUIRED_B64="{{ imdsv2required | default('') | base64_encode }}"
# Optional mount-path=UUID pairs from prior /etc/fstab (e.g. OS upgrade). Space-separated.
readonly PATH_TO_UUID_MAPPING_B64="{{ path_to_uuid_mapping | default('') | base64_encode }}"
readonly DEV_ROOT="/dev"
readonly AZURE_DISK_ROOT="/dev/disk/azure"
readonly SYS_CLASS_NVME="/sys/class/nvme"
readonly SYS_CLASS_BLOCK="/sys/class/block"
readonly FSTAB_PATH="/etc/fstab"
# Do not allow the provisioning environment to replace the trusted Azure
# identification utility. The helper's override is only for isolated tests.
unset AZURE_NVME_ID_COMMAND

{% include "azure_disk_utils.sh.j2" %}

{% raw %}
CLOUD_TYPE=$(printf '%s' "$CLOUD_TYPE_B64" | base64 --decode)
readonly CLOUD_TYPE
DEFAULT_SSD_DRIVES=$(printf '%s' "$DEFAULT_SSD_DRIVES_B64" | base64 --decode)
readonly DEFAULT_SSD_DRIVES
MOUNT_PATHS=$(printf '%s' "$MOUNT_PATHS_B64" | base64 --decode)
readonly MOUNT_PATHS
LUN_INDEXES=$(printf '%s' "$LUN_INDEXES_B64" | base64 --decode)
readonly LUN_INDEXES
IMDSv2Required=$(printf '%s' "$IMDSV2_REQUIRED_B64" | base64 --decode)
readonly IMDSv2Required
PATH_TO_UUID_MAPPING=$(printf '%s' "$PATH_TO_UUID_MAPPING_B64" | base64 --decode)
readonly PATH_TO_UUID_MAPPING

should_check_aws_meta() {
  [[ -z $DEFAULT_SSD_DRIVES && $CLOUD_TYPE == "aws" ]]
}

if [[ "$IMDSv2Required" == "True" ]]; then
  TOKEN=$(curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 120")
  CURL_COMMANND="curl -H \"X-aws-ec2-metadata-token: $TOKEN\""
else
  CURL_COMMANND="curl"
fi
# Figure out how many ephemerals we have by querying the metadata API, and then:
#  - convert the drive name returned from the API to the hosts DRIVE_SCHEME, if necessary
#  - verify a matching device is available in /dev/
#  - mount the drives at the provided mount points
readonly METADATA_URL_BASE="http://169.254.169.254/2012-01-12"

# arg: ephemeral
get_device_path() {
  local ephemeral_name=$1
  local output=
  if should_check_aws_meta; then
    output=$($CURL_COMMANND --silent $METADATA_URL_BASE/meta-data/block-device-mapping/$ephemeral_name)
  else
    output=$ephemeral_name
  fi
  get_device_path_rv="/dev/$output"
}

get_azu_drives() {
  local -a lun_indexes=()
  local -a seen_lun_indexes=()
  local -a seen_devices=()
  local current_lun_index=""
  local existing=""
  local device_type=""
  local num_lun_indexes=0

  if [[ "$LUN_INDEXES" == *$'\n'* || "$LUN_INDEXES" == *$'\r'* ]]; then
    echo >&2 "Azure LUN indexes must be a single whitespace-delimited line."
    return 1
  fi
  read -r -a lun_indexes <<< "$LUN_INDEXES"
  num_lun_indexes=${#lun_indexes[@]}

  # LUN order is the contract between YBA's disk attachments and mount paths.
  # Resolve every disk before allowing any filesystem operation.
  if [[ $num_lun_indexes -ne ${#mounts[@]} ]]; then
    echo >&2 "Expected ${#mounts[@]} Azure LUN indexes, received $num_lun_indexes."
    return 1
  fi

  get_azu_drives_rv=""
  AZURE_DEVICE_LUNS=()
  for current_lun_index in "${lun_indexes[@]}"; do
    if ! [[ "$current_lun_index" =~ ^[0-9]+$ ]]; then
      echo >&2 "Invalid Azure LUN index: $current_lun_index"
      return 1
    fi
    for existing in "${seen_lun_indexes[@]}"; do
      if [[ "$existing" == "$current_lun_index" ]]; then
        echo >&2 "Duplicate Azure LUN index: $current_lun_index"
        return 1
      fi
    done
    seen_lun_indexes+=("$current_lun_index")

    resolve_azure_data_disk "$current_lun_index" || return 1
    if [[ ! -b "$AZURE_DATA_DISK" ]]; then
      echo >&2 "Azure LUN $current_lun_index resolved to non-block device $AZURE_DATA_DISK."
      return 1
    fi
    device_type=$(lsblk -dn -o TYPE "$AZURE_DATA_DISK" 2>/dev/null || true)
    if [[ "$device_type" != "disk" ]]; then
      echo >&2 "Azure LUN $current_lun_index resolved to $device_type device $AZURE_DATA_DISK."
      return 1
    fi
    for existing in "${seen_devices[@]}"; do
      if [[ "$existing" == "$AZURE_DATA_DISK" ]]; then
        echo >&2 "Multiple Azure LUNs resolved to $AZURE_DATA_DISK."
        return 1
      fi
    done
    seen_devices+=("$AZURE_DATA_DISK")

    get_azu_drives_rv="$get_azu_drives_rv $AZURE_DATA_DISK"
    AZURE_DEVICE_LUNS+=("$current_lun_index")
  done
}

get_ephemeral_drives() {
  if should_check_aws_meta; then
    local -i attempt=0
    local ephemerals=""
    while true; do
      if $CURL_COMMANND --silent $METADATA_URL_BASE/meta-data/ | grep block-device-mapping >/dev/null; then
        break
      fi
      echo >&2 "$METADATA_URL_BASE/meta-data/block-device-mapping not yet available"
      echo >&2 "Retrying after 200ms..."
      sleep 0.2
      let attempt+=1
      if [[ $attempt -ge 300 ]]; then
        echo "Retried enough times. Exiting..."
        exit 1
      fi
    done

    # Verify that we can curl this URL successfully.
    $CURL_COMMANND --silent $METADATA_URL_BASE/meta-data/block-device-mapping/ >/dev/null

    # Turn off error checking and grep for ephemeral drives. We won't fail even if none are present.
    set +e
    get_ephemeral_drives_rv=$(
        $CURL_COMMANND --silent $METADATA_URL_BASE/meta-data/block-device-mapping/ | grep ephemeral )
    set -e
  elif [[ $CLOUD_TYPE == "azu" ]]; then
    get_azu_drives
    get_ephemeral_drives_rv=$get_azu_drives_rv
  else
    get_ephemeral_drives_rv=$DEFAULT_SSD_DRIVES
  fi
}

# Resolve device paths for each entry in MOUNT_PATHS using PATH_TO_UUID_MAPPING
# (space-separated mount_path=uuid pairs). Sets get_device_paths_from_uuid_mapping_rv
# as a bash array parallel to mounts (same order as MOUNT_PATHS).
get_device_paths_from_uuid_mapping() {
  local -a mapping_entries=()
  local -a device_paths=()
  local mount_path device_uuid by_uuid_path actual_path entry found

  if [[ "$PATH_TO_UUID_MAPPING" == *$'\n'* || "$PATH_TO_UUID_MAPPING" == *$'\r'* ]]; then
    echo >&2 "PATH_TO_UUID_MAPPING must be a single whitespace-delimited line."
    return 1
  fi
  read -r -a mapping_entries <<< "$PATH_TO_UUID_MAPPING"

  if [[ ${#mounts[@]} -eq 0 ]]; then
    echo >&2 "No mount points provided, cannot resolve devices from UUID mapping."
    return 1
  fi
  if [[ ${#mapping_entries[@]} -eq 0 ]]; then
    echo >&2 "PATH_TO_UUID_MAPPING is empty, cannot resolve devices."
    return 1
  fi

  for mount_path in "${mounts[@]}"; do
    found=""
    device_uuid=""
    for entry in "${mapping_entries[@]}"; do
      if [[ "${entry%%=*}" == "$mount_path" ]]; then
        device_uuid="${entry#*=}"
        found=1
        break
      fi
    done
    if [[ -z "$found" || -z "$device_uuid" || "$device_uuid" == "$mount_path" ]]; then
      echo >&2 "No UUID mapping found for mount path $mount_path"
      return 1
    fi
    if ! [[ "$device_uuid" =~ ^[A-Za-z0-9-]+$ ]]; then
      echo >&2 "Invalid filesystem UUID '$device_uuid' for mount path $mount_path"
      return 1
    fi
    by_uuid_path="$DEV_ROOT/disk/by-uuid/$device_uuid"
    if ! [[ -e "$by_uuid_path" ]]; then
      echo >&2 "Device for UUID $device_uuid (mount $mount_path) not found at $by_uuid_path"
      return 1
    fi
    actual_path=$(readlink -eq "$by_uuid_path")
    echo "Resolved $mount_path -> UUID=$device_uuid -> $actual_path"
    device_paths+=( "$actual_path" )
  done
  get_device_paths_from_uuid_mapping_rv=( "${device_paths[@]}" )
}

# Mount each device path onto the corresponding mount path from the mounts array (same order).
# Pass device paths as: mount_drives "${device_paths[@]}"
# Optional first flag --no-format skips mkfs (for remounting preserved disks after OS upgrade).
mount_drives() {
  local allow_format=true
  if [[ "${1:-}" == "--no-format" ]]; then
    allow_format=false
    shift
  fi
  local -a device_paths=("$@")
  local mount_path device_path canonical_device_path device_uuid file_system blkid_error
  local actual_path already_mounted fs_opts
  local idx=0

  echo "Mount drives ${device_paths[*]} for mount points ${mounts[*]} (allow_format=$allow_format)"
  for device_path in "${device_paths[@]}"; do
    fs_opts="defaults,noatime,nofail,allocsize=4m"
    set +e
    # NOTE: This does not seem to return the actual file system
    file_system=$(/sbin/blkid -o value -s TYPE -c /dev/null $device_path)
    blkid_error=$?
    set -e
    # On some EC2 instance types (e.g., i2.4xlarge), the above command or fdisk doesn't discover
    # the drive correctly. It in turn returns an exit code of 2 indicating that the drive was not
    # found.  In that case, we go ahead and create XFS on that drive.
    if [[ $blkid_error -ne 0 && $blkid_error -ne 2 ]]; then
      echo "blkid returned exit code $blkid_error for $device_path"
      exit 1
    fi
    if [[ $blkid_error -eq 2 || $file_system != xfs ]]; then
      if [[ "$allow_format" != true ]]; then
        echo >&2 "Refusing to format $device_path (blkid_error=$blkid_error fs=$file_system); expected existing filesystem"
        exit 1
      fi
      if [[ $CLOUD_TYPE == "azu" ]]; then
        # Re-resolve the LUN immediately before the destructive step so a selected Azure device
        # can never be replaced by generic device-name enumeration.
        canonical_device_path=$(readlink -e -- "$device_path" 2>/dev/null || true)
        if [[ -z "$canonical_device_path" ]] || \
           ! validate_azure_data_disk "$canonical_device_path" "${AZURE_DEVICE_LUNS[$idx]}"; then
          echo >&2 "Refusing to format unverified Azure disk $device_path."
          exit 1
        fi
      fi
      if [[ -f /sbin/mkfs.xfs ]]; then
        echo "Creating xfs on: " $device_path
        /sbin/mkfs.xfs $device_path -f
        file_system=xfs
        fs_opts="${fs_opts},ikeep"
      else
        echo "mkfs.xfs not found. Using the default - $file_system"
      fi
    fi

    mount_path=${mounts[$idx]}

    mkdir -p "$mount_path"
    chmod 777 "$mount_path"

    device_uuid=$(/sbin/blkid -o value -s UUID -c /dev/null $device_path)
    echo "device uuid = $device_uuid"
    echo "Updating the UUID entry for $mount_path in fstab..."
    replace_fstab_mount_entry \
      "$FSTAB_PATH" "$mount_path" "$device_uuid" "$file_system" "$fs_opts"
    echo "checking actual path"
    already_mounted=false
    # Sometimes link does not exist at the time of checking
    if test -e "$DEV_ROOT/disk/by-uuid/$device_uuid"; then
      actual_path=$(readlink -eq "$DEV_ROOT/disk/by-uuid/$device_uuid")
      echo "actual_path is $actual_path"
      mount | egrep -q "^$actual_path on $mount_path " && already_mounted=true
    fi
    if $already_mounted; then
      echo "$device_path is already mounted on $mount_path"
    else
      echo "Mounting UUID=$device_uuid on $mount_path"
      # Mount by target so this initial mount exercises the persisted fstab entry.
      ( set -x; mount "$mount_path" )
    fi
    # The first time we mount the drives, the permissions seem to flip back to 755. Perhaps,
    # there's a better way to set the permissions in fstab itself. But couldn't find one that
    # works. For now, updating the permissions again. On subsequent mount/umounts, this problem
    # does not happen. So we are covered on that front (e.g. as might happen during a reboot).
    chmod 777 $mount_path
    idx=$((idx+1))
  done
}

# Starting a block whose output will be redirected to syslog.
(
  declare -i exit_code=0

  # Take into account xvdb or sdb
  # Handle LVM root volumes (common on OCI) by checking TYPE column
  root_line=$(lsblk -o NAME,TYPE,MOUNTPOINT | awk '$3 == "/" {print $1, $2}')
  root_drive=$(echo "$root_line" | awk '{print $1}' | tr -cd '[:alnum:]/')
  root_type=$(echo "$root_line" | awk '{print $2}')

  # For LVM root, find the underlying physical device
  if [[ "$root_type" == "lvm" ]]; then
    echo "Detected LVM root volume: $root_drive"
    root_parent=$(pvs --noheadings -o pv_name 2>/dev/null | head -1 | xargs basename 2>/dev/null || echo "sda")
  else
    root_parent=$(lsblk -ndo pkname "/dev/${root_drive}" 2>/dev/null || echo "")
    if [[ -z "${root_parent}" ]]; then
      root_parent=$root_drive
    fi
  fi
  if [[ "$root_parent" =~ .*xvd.* ]]; then
    echo "Detected 'xvd' drive naming scheme (root: $root_parent)"
    DRIVE_SCHEME='xvd'
  elif [[ "$root_parent" =~ .*nvme.* ]]; then
    echo "Detected 'nvme' drive naming scheme (root: $root_parent)"
    DRIVE_SCHEME='nvme'
  else
    echo "Detected 'sd' drive naming scheme (root: $root_parent)"
    DRIVE_SCHEME='sd'
  fi

  if [[ "$MOUNT_PATHS" == *$'\n'* || "$MOUNT_PATHS" == *$'\r'* ]]; then
    echo >&2 "Mount paths must be a single whitespace-delimited line."
    exit 1
  fi
  declare -ag mounts=()
  read -r -a mounts <<< "$MOUNT_PATHS"
  # For old generation aws instances, we assume YugaWare requests a number of ephemerals appropriate
  # to the instance type. E.g. m3.medium only supports 1 ephemeral, but m3.xlarge supports 2.
  if [[ ${#mounts[@]} -eq 0 ]]; then
    echo >&2 "No mount points provided, cannot mount any devices."
    exit 1
  fi
  validate_mount_paths

  # When path->UUID mapping is provided (e.g. after root-volume / OS upgrade), remount using the
  # known UUIDs instead of rediscovering and potentially reformatting devices.
  if [[ -n "${PATH_TO_UUID_MAPPING}" ]]; then
    echo "Using provided path_to_uuid_mapping for remount: ${PATH_TO_UUID_MAPPING}"
    get_device_paths_from_uuid_mapping
    mount_drives --no-format "${get_device_paths_from_uuid_mapping_rv[@]}"
    exit $exit_code
  fi

  device_paths=()

  get_ephemeral_drives
  declare -ag ephemerals=()
  read -r -a ephemerals <<< "$get_ephemeral_drives_rv"

  declare -i num_devices=${#ephemerals[@]}

  if [[ $num_devices -eq 0 ]]; then
    echo >&2 "Found no volumes to mount for mount points: $MOUNT_PATHS"
    exit 1
  fi
  if [[ $CLOUD_TYPE == "azu" ]]; then
    validate_azure_mount_targets
  fi

  echo "============================"
  echo "Drives supporting SSDs:"
  echo "${ephemerals[@]}"
  echo "============================"

  if [[ $num_devices -lt ${#mounts[@]} ]]; then
    echo >&2 "Only $num_devices volumes discovered, but ${#mounts[@]} mount points provided: $MOUNT_PATHS."
    echo >&2 "Will mount available volumes and return an error after that."
    exit_code=1
  fi

  if [[ ${#mounts[@]} -lt $num_devices ]]; then
    echo >&2 "Only ${#mounts[@]} mount points provided: $MOUNT_PATHS, but num_devices=$num_devices."
    declare -i num_devices=${#mounts[@]}
    echo >&2 "Will only mount $num_devices volumes, and return an error after that."
    exit_code=1
  fi

  declare -g eph_idx=0
  declare -g max_iterations=$((num_devices+1))
  # iterate through 1 more than num_devices to skip over root volume
  for (( i=0; i<max_iterations; ++i )); do
    e=${ephemerals[eph_idx]}
    echo "Probing $e ..."
    if [[ $CLOUD_TYPE == "azu" ]]; then
        # Azure discovery already resolved the requested LUN. Never replace it
        # with a generated NVMe kernel name.
        device_path=$e
    elif [[ $CLOUD_TYPE == "gcp" ]]; then
        # For gcp we are using by-id links, so just need to resolve them
        device_path=$(readlink -eq "/dev/$e")
    elif [[ $CLOUD_TYPE == "aws" && "$DRIVE_SCHEME" == "nvme" ]]; then
        # Some instance types (C5, M5 etc) have EBS volume mounted as nvme
        # In which case we want to make the device path to match that
        # https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/nvme-ebs-volumes.html
        device_idx=$((i))
        device_path="/dev/nvme${device_idx}n1"
    else
        get_device_path "$e"
        device_path=$get_device_path_rv

        # If needed, convert 'sdb' -> 'xvdb'
        device_path=$(echo $device_path | sed "s/sd/$DRIVE_SCHEME/")
    fi

    echo "Device path $device_path"

    if ! [[ -b "$device_path" ]]; then
      echo "Ephemeral disk $e, $device_path is not present. Skipping."
      continue
    fi

    device_type=$(lsblk -dn -o TYPE "$device_path" 2>/dev/null || true)
    if [[ "$device_type" != "disk" ]]; then
      echo >&2 "Refusing to use non-disk device $device_path (type: $device_type)."
      exit 1
    fi

    # In aws we cannot clearly identify whether disk is provided with ami or added by yba
    # So if we see that disk is already mounted to some mount point that is not managed by yba
    # then we skip it
    declare -g active_mount_points
    active_mount_points=$(lsblk -o MOUNTPOINT -nr "$device_path" | grep -v '^$' || true)
    if ! [[ -z "$active_mount_points" ]]; then
      declare -g mount_points_arr=(${active_mount_points})
      for value in "${mount_points_arr[@]}"
      do
        if [[ $CLOUD_TYPE == "azu" && "$value" != "${mounts[$eph_idx]}" ]]; then
          echo >&2 "$device_path is mounted at $value, expected ${mounts[$eph_idx]} for Azure LUN ${AZURE_DEVICE_LUNS[$eph_idx]}."
          exit 1
        elif [[ $CLOUD_TYPE != "azu" ]] && \
             ! [[ " ${mounts[*]} " =~ [[:space:]]${value}[[:space:]] ]]; then
          echo "$device_path is mounted at $value, which is not expected to be managed by yba"
          max_iterations=$((max_iterations+1))
          continue 2
        fi
      done
    fi

    # Test that the device actually exists since you can request more ephemeral drives than are
    # available for an instance type and the meta-data API will happily tell you it exists when it
    # really does not.
    # Also check to make sure we don't try to mount on root volume
    canonical_device_path=$(readlink -e -- "$device_path" 2>/dev/null || true)
    canonical_root_path=$(readlink -e -- "/dev/${root_parent}" 2>/dev/null || true)
    if [[ -n "$canonical_device_path" && "$canonical_device_path" != "$canonical_root_path" ]]; then
      validate_mount_paths
      if [[ $CLOUD_TYPE == "azu" ]] && \
         ! validate_azure_data_disk "$canonical_device_path" "${AZURE_DEVICE_LUNS[$eph_idx]}"; then
        echo >&2 "Refusing filesystem operations on unverified Azure disk $canonical_device_path."
        exit 1
      fi
      if [[ $CLOUD_TYPE == "azu" ]]; then
        validate_azure_mount_targets
      fi
      echo "Detected ephemeral disk: $device_path"

      device_paths+=( "$device_path" )

      # only increment ephemeral index when mount path is used for a device
      eph_idx=$((eph_idx+1))
      # break when we are done with all mounts
      if [ "$eph_idx" = "$num_devices" ]; then
        break
      fi
    else
      echo "Ephemeral disk $e, $device_path is a part of root $root_drive. Skipping."
      if [[ $CLOUD_TYPE == "azu" ]]; then
        echo >&2 "Azure LUN ${AZURE_DEVICE_LUNS[$eph_idx]} resolved to the root device."
        exit 1
      fi
    fi
  done

  if [[ ${#device_paths[@]} -lt ${#mounts[@]} ]]; then
    echo >&2 "Only ${#device_paths[@]} devices resolved for ${#mounts[@]} mount points: $MOUNT_PATHS."
    exit_code=1
    if [[ $CLOUD_TYPE == "azu" ]]; then
      # Every Azure LUN maps to exactly one mount path; mounting a partial set would shift disks
      # onto the wrong mount points.
      echo >&2 "Refusing to mount a partial set of Azure data disks."
      exit 1
    fi
  fi

  mount_drives "${device_paths[@]}"

  exit $exit_code

  {% endraw %}

) 2>&1 | logger -t "${0##*/}"
