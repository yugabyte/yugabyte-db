is_cloud={{ is_cloud | default(false) }}
is_yb_prebuilt_image={{ is_yb_prebuilt_image | default(false) }}
bin_path="/usr/local/bin"
# Hosts with umask 0027 create root-owned files as 640; yugabyte (and user
# systemd) must be able to read /etc/systemd/{system,user}.conf and similar.
umask 022

# Set a sysctl key now and save it in /etc/sysctl.conf so it survives a reboot
# or `sysctl --system`. The value is always appended, so it is the last entry
# for the key and wins when the file is loaded; earlier entries for the key
# (with or without spaces around "=") are removed first so the file stays free
# of duplicates and repeated runs leave it unchanged.
# Remove every entry for a sysctl key (with or without spaces around "=")
# from the given file.
remove_sysctl_key() {
  local key_re="${1//./[.]}"
  sed -i "/^[[:space:]]*${key_re}[[:space:]]*=/d" "$2"
}

persist_sysctl() {
  local key="$1" value="$2" conf=/etc/sysctl.conf
  touch "$conf"
  remove_sysctl_key "$key" "$conf"
  # Start on a new line if the file does not end with one.
  if [[ -s "$conf" && -n "$(tail -c 1 "$conf")" ]]; then
    echo >> "$conf"
  fi
  echo "${key}=${value}" >> "$conf"
  sysctl -w "${key}=${value}"
}

{% if os_distribution == "ubuntu" %}
# Ubuntu's apport service rewrites kernel.core_pattern when it starts, clobbering
# the value sysctl loads from /etc/sysctl.conf and breaking YB core dump capture.
if systemctl is-enabled apport.service >/dev/null 2>&1; then
  echo "Disabling Apport service..."
  systemctl disable --now apport.service || true
  if [[ -f /etc/default/apport ]]; then
    sed -i 's/^enabled=.*/enabled=0/' /etc/default/apport
  fi
fi
{% endif %}

# Set system limits
# Append limits to /etc/security/limits.conf if they don't already exist
#
{% for key in limits %}
{% set value = limits[key] %}
if ! grep -qP "^\*\s+-\s+{{ key }}\s+{{ value }}$" /etc/security/limits.conf; then
  echo "*                -       {{ key }}            {{ value }}" | \
  tee -a /etc/security/limits.conf
fi
{% endfor %}

if test ! -f /etc/security/limits.d/20-nproc.conf; then
  touch /etc/security/limits.d/20-nproc.conf
  echo "File /etc/security/limits.d/20-nproc.conf created."
else
  echo "File /etc/security/limits.d/20-nproc.conf already exists."
fi
chmod 644 /etc/security/limits.d/20-nproc.conf
# Replace with the desired nproc limit regardless of the current value.
sed -i 's/\(*[[:space:]]*soft[[:space:]]*nproc[[:space:]]*\)[0-9]\+/\1{{ nproc_limit }}/' /etc/security/limits.d/20-nproc.conf


# Determine the PLATFORM_ID e.g platform:el8
platform_id=$(grep -oP '(?<=^PLATFORM_ID=).+' /etc/os-release | tr -d '"' || echo "unknown")
# Extract the EL version from the platform_id e.g 8
platform_el_version=$(echo "$platform_id" | grep -oP '(?<=platform:el)\d+(?=\D|$)' || echo "0")

if [[ "$platform_el_version" -ge 8 ]]; then
  # Check and set DefaultLimitNOFILE in /etc/systemd/system.conf
  if ! grep -q "^DefaultLimitNOFILE={{ fd_limit }}" /etc/systemd/system.conf; then
    echo 'DefaultLimitNOFILE={{ fd_limit }}' | tee -a /etc/systemd/system.conf
  fi

  # Check and set DefaultLimitNOFILE in /etc/systemd/user.conf
  if ! grep -q "^DefaultLimitNOFILE={{ fd_limit }}" /etc/systemd/user.conf; then
    echo 'DefaultLimitNOFILE={{ fd_limit }}' | tee -a /etc/systemd/user.conf
  fi
  # chmod even when settings already exist (AMI may ship these as 640).
  chmod 644 /etc/systemd/system.conf /etc/systemd/user.conf
else
  echo "el8/9 not detected, not updating file limits"
fi
echo "Systemd file limits configured."


# Reload systemd to apply changes
systemctl daemon-reload

# Apply some changes to the current shell session
ulimit -n {{ fd_limit }}
ulimit -u {{ nproc_limit }}


# Configure kernel settings
persist_sysctl vm.swappiness "{{ vm_swappiness }}"

if [[ "$is_cloud" == "False" ]]; then
  persist_sysctl kernel.core_pattern "{{ kernel_core_pattern }}"
  persist_sysctl vm.max_map_count "{{ vm_max_map_count }}"
fi

if [[ "$is_cloud" == "True" ]]; then
  # Define paths and directories
  DUMP_DIR="{{ yb_home_dir }}/cores"

  # Ensure the cores directory exists with proper permissions
  if [[ -L "$DUMP_DIR" ]]; then
    echo "YB Prebuilt AMI detected, skipping creation of cores directory"
  else
    mkdir -p "$DUMP_DIR"
    chmod 0755 "$DUMP_DIR"
    chown "{{ yb_user }}:{{ yb_user }}" "$DUMP_DIR"
  fi

  # Create core dump compression script
  cat << 'EOF' > "$bin_path/compress_core.sh"
#!/bin/bash
DUMP_DIR="{{ yb_home_dir }}/cores"
CORE_FILE="$DUMP_DIR/$(basename $1).$$.gz"
GZIP_PATH=$(PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" which gzip)
if [[ -z "$GZIP_PATH" ]]; then
  echo "gzip not found, aborting." >> "$DUMP_DIR/custom_core_dump.log"
  exit 1
fi
"$GZIP_PATH" -c >> "$CORE_FILE"
chmod 644 "$CORE_FILE"
EOF

  # Create core dump kernel pattern
  CORE_SCRIPT="$bin_path/compress_core.sh"
  chmod +x $CORE_SCRIPT
  CORE_DIR="{{ yb_home_dir }}/cores"
  CORE_PATTERN="|$CORE_SCRIPT $CORE_DIR/core_yb.%t.%e.%p"

  persist_sysctl kernel.core_pattern "$CORE_PATTERN"

  persist_sysctl vm.max_map_count "{{ vm_max_map_count }}"
  # Earlier YNP versions saved vm.max_map_count in this drop-in instead. At boot
  # systemd-sysctl reads it after /etc/sysctl.conf (99-sysctl.conf), so a stale
  # value left there would win; remove the key from it.
  if [[ -f /etc/sysctl.d/99-vm-max-map-count.conf ]]; then
    remove_sysctl_key vm.max_map_count /etc/sysctl.d/99-vm-max-map-count.conf
  fi

  # Apply the changes system-wide
  sysctl --system

  if [[ "{{ os_family }}" == "RedHat" ]]; then
    # Check if tuned is installed
    if command -v tuned-adm &> /dev/null; then
        echo "Tuned is installed. Enabling and starting the service..."
        systemctl enable --now tuned
        # Ensure tuned service is running before applying a profile
        if systemctl is-active --quiet tuned; then
            tuned-adm profile latency-performance
        else
            echo "Error: Tuned service is not running. Skipping tuning configuration."
        fi
    else
        echo "Tuned is not installed. Skipping tuning configuration."
    fi
  fi

  # Check if the distribution is Ubuntu
  if [[ "{{ os_distribution }}" == "ubuntu" ]]; then
    # Check if /etc/apt/apt.conf.d/20auto-upgrades exists
    if [[ -f /etc/apt/apt.conf.d/20auto-upgrades ]]; then
      echo "Reenabling unattended upgrades in /etc/apt/apt.conf.d/20auto-upgrades..."
      sed -i '/Unattended-Upgrade/s/"0"/"1"/' /etc/apt/apt.conf.d/20auto-upgrades
    else
      echo "/etc/apt/apt.conf.d/20auto-upgrades not found. Skipping reenable of unattended upgrades."
    fi

    # Check if /etc/apt/apt.conf.d/50unattended-upgrades exists
    if [[ -f /etc/apt/apt.conf.d/50unattended-upgrades ]]; then
      echo "Disabling automatic reboot in /etc/apt/apt.conf.d/50unattended-upgrades..."
      if ! grep -q 'Unattended-Upgrade::Automatic-Reboot "false";' /etc/apt/apt.conf.d/50unattended-upgrades; then
        echo 'Unattended-Upgrade::Automatic-Reboot "false";' >> /etc/apt/apt.conf.d/50unattended-upgrades
      fi
    else
      echo "/etc/apt/apt.conf.d/50unattended-upgrades not found. Skipping disable of automatic reboot."
    fi
  fi
fi

JOURNALD_CONF="/etc/systemd/journald.conf"
CONFIG_BLOCK="##### ADDED BY YUGABYTE #####"
SETTINGS="Storage=persistent
MaxRetentionSec=30days
SystemMaxUse=400M"

# Check if the block already exists
if ! grep -q "$CONFIG_BLOCK" "$JOURNALD_CONF"; then
    echo -e "\n$CONFIG_BLOCK" | sudo tee -a "$JOURNALD_CONF" > /dev/null
    echo "$SETTINGS" | sudo tee -a "$JOURNALD_CONF" > /dev/null
    echo "$CONFIG_BLOCK" | sudo tee -a "$JOURNALD_CONF" > /dev/null
    echo "Updated $JOURNALD_CONF with journald settings."
else
    echo "Settings already present in $JOURNALD_CONF. No changes made."
fi

systemctl restart systemd-journald
echo "systemd-journald restarted successfully."

# For earlyoom MEMLOCK requirement
if ! grep -q "^DefaultLimitMEMLOCK=" /etc/systemd/system.conf; then
    echo 'DefaultLimitMEMLOCK=50M' | tee -a /etc/systemd/system.conf
fi
if ! grep -q "^DefaultLimitMEMLOCK=" /etc/systemd/user.conf; then
    echo 'DefaultLimitMEMLOCK=50M' | tee -a /etc/systemd/user.conf
fi
chmod 644 /etc/systemd/system.conf /etc/systemd/user.conf

# Enable linger for user-level systemd services
{% if use_system_level_systemd == 'False' %}
yb_user_id=$(id -u {{ yb_user }})
runtime_dir="/run/user/${yb_user_id}"
xdg_runtime_env="export XDG_RUNTIME_DIR=$runtime_dir"

# Add XDG_RUNTIME_DIR to .bashrc if not present
if ! grep -qxF "${xdg_runtime_env}" {{ yb_user_home }}/.bashrc >/dev/null 2>&1; then
    su - {{ yb_user }} -c "echo '${xdg_runtime_env}' >> {{ yb_user_home }}/.bashrc"
fi

if [[ "$platform_el_version" -ge 8 ]]; then
    # Stop user systemd service
    su - {{ yb_user }} -c "XDG_RUNTIME_DIR=$runtime_dir systemctl --user exit >/dev/null 2>&1" || true
    
    status_cmd="XDG_RUNTIME_DIR=$runtime_dir systemctl --user status --no-pager >/dev/null 2>&1"
    count=0
    
    # Wait for user systemd to stop
    while su - {{ yb_user }} -c "$status_cmd"; do
        count=$((count + 1))
        if [ $count -gt 10 ]; then
            echo "User systemd service failed to stop after $count attempts."
            exit 1
        fi
        echo "Waiting for user systemd service to stop..."
        sleep 2
    done
    
    count=0
    # Enable linger and start user systemd with retries
    until su - {{ yb_user }} -c "$status_cmd"; do
        if ! loginctl enable-linger {{ yb_user }}; then
            echo "Failed to enable linger for user {{ yb_user }}"
            exit 1
        fi
        systemctl start user@${yb_user_id}.service
        count=$((count + 1))
        if [ $count -gt 10 ]; then
            echo "User systemd service failed to start after $count attempts."
            exit 1
        fi
        echo "Waiting for user systemd service to become active..."
        sleep 2
    done
else
    # Non el8/el9 - just enable linger
    if ! loginctl enable-linger {{ yb_user }}; then
        echo "Failed to enable linger for user {{ yb_user }}"
        exit 1
    fi
fi

{% endif %}

echo "Kernel settings configured."
echo "OS Configuration applied successfully."
