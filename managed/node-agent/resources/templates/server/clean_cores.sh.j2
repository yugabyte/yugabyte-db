set -euo pipefail

print_help() {
  cat <<EOT
Usage: ${0##*/} [<options>]
Options:
  -n, --num_corestokeep <numcorestokeep>
    number of latest core files to keep (default: 5).
  -h, --help
    Show usage
EOT
}

num_cores_to_keep={{ num_cores_to_keep | default(5) }}
YB_CRASH_DIR="{{ yb_home_dir }}/cores/"
if [[ -n "{{ yb_cores_dir }}" ]]; then
  YB_CRASH_DIR="{{yb_cores_dir}}/"
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--num_corestokeep)
      num_cores_to_keep=$2
      shift
    ;;
    -h|--help)
      print_help
      exit 0
    ;;
    *)
      echo "Invalid option: $1" >&2
      print_help
      exit 1
  esac
  shift
done

if [[ -z "${num_cores_to_keep}" || ! "${num_cores_to_keep}" =~ ^[0-9]+$ ]]; then
  echo "num_cores_to_keep must be a non-negative integer" >&2
  exit 1
fi

USER=${USER:-$(whoami)}
if [[ "$(id -u)" != "0" && "$USER" != "yugabyte" ]]; then
  echo "This script must be run as root or yugabyte"
  exit 1
fi

# NUL-delimited so core names with spaces (e.g. "... (deleted)" when the crashed binary was
# replaced on disk) or glob characters survive intact.
# Counted in the loop because bash's array-length syntax opens a Jinja comment.
core_files=()
num_core_files=0
while IFS=$'\t' read -r -d '' _ file; do
  core_files+=("$file")
  num_core_files=$((num_core_files + 1))
done < <(find "$YB_CRASH_DIR" -name 'core_*' -type f -printf '%T@\t%p\0' | sort -z -n)
if [[ "${num_core_files}" -gt "${num_cores_to_keep}" ]]; then
  for file in "${core_files[@]:0:num_core_files-num_cores_to_keep}"; do
    echo "Deleting core file $file"
    rm -f -- "$file"
  done
fi
