#!/bin/bash
# Managed by node-agent (ConfigureCloudFederation) for S3-on-GCP federated IAM; do not edit.
# credential_process for YBC: exchanges the node's GCE identity token for temporary AWS
# credentials via STS AssumeRoleWithWebIdentity. Uses only curl + sed (no awscli/jq/unzip).
set -u
AUDIENCE="{{ audience }}"
ROLE_ARN="{{ role_arn }}"

# Bounded on both calls: YBC blocks on this script to refresh credentials, so a hung metadata or
# STS request would stall the backup rather than fail it.
jwt=$(curl -sf --connect-timeout 5 --max-time 10 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity?audience=${AUDIENCE}&format=full")
if [ -z "$jwt" ]; then
  echo "S3-on-GCP: could not fetch GCE identity token; check the VM's service account and audience" >&2
  exit 1
fi

# AssumeRoleWithWebIdentity is unsigned, so a plain POST to the global STS endpoint suffices; the
# response is XML.
resp=$(curl -s --connect-timeout 5 --max-time 15 -X POST "https://sts.amazonaws.com/" \
  --data-urlencode "Action=AssumeRoleWithWebIdentity" \
  --data-urlencode "Version=2011-06-15" \
  --data-urlencode "RoleArn=${ROLE_ARN}" \
  --data-urlencode "RoleSessionName=yb-cross-cloud-federation" \
  --data-urlencode "WebIdentityToken=${jwt}")

# [^<]* keeps each capture inside its own tag, robust whether the XML is pretty-printed or one line.
get() { sed -n "s:.*<$1>\([^<]*\)</$1>.*:\1:p" <<< "$resp"; }
akid=$(get AccessKeyId)
if [ -z "$akid" ]; then
  # Report only the STS error fields, never the raw response: this branch is reached whenever the
  # parse above found no AccessKeyId, which includes the case where STS did return credentials in a
  # shape we failed to parse. stderr lands in the YBC log and from there in support bundles.
  code=$(get Code)
  echo "S3-on-GCP: STS AssumeRoleWithWebIdentity failed: ${code:-unrecognized STS response} $(get Message)" >&2
  exit 1
fi

# STS creds are base64 / ISO-8601 (no JSON-special chars), so building the credential_process JSON
# with printf is safe.
printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s","SessionToken":"%s","Expiration":"%s"}\n' \
  "$akid" "$(get SecretAccessKey)" "$(get SessionToken)" "$(get Expiration)"
