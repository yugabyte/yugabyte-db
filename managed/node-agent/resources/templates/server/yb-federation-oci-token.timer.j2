[Unit]
Description=Refresh the OCI identity token used for cross-cloud federation

[Timer]
# Setup refuses an identity domain whose tokens live under 30 minutes, so every run leaves a token
# that outlives the next one. Surviving a missed run takes a longer-lived token: an hour-long one
# survives one, a 30-minute one none.
OnBootSec=1min
OnUnitActiveSec=20min
Unit=yb-federation-oci-token.service

[Install]
WantedBy=timers.target
