#!/bin/bash

SCRIPT_NAME=$(basename "$0")

################### Config ###################
is_acceptable_clock_skew_wait_enabled="{{ is_acceptable_clock_skew_wait_enabled | default(true) }}"  # Whether check clock skew
acceptable_clock_skew_sec="{{ acceptable_clock_skew_sec | default(0.5) }}"  # In seconds
max_tries="{{ acceptable_clock_skew_max_tries | default(120) }}"  # Maximum number of tries before returning failure
retry_wait_time_s=1  # How long waits before retry in seconds
mount_points="{{ mount_paths | default('') | trim }}"  # Mount points
mount_wait_max_tries=300  # Maximum number of tries to wait for mount points
mount_wait_time_s=1  # How long to wait between checks for mount points

{% raw %}

# The mount point wait below must run even when the clock skew wait is turned
# off, so record the setting here instead of exiting early.
skip_clock_skew_check=false
if [[ "$is_acceptable_clock_skew_wait_enabled" != true && "$is_acceptable_clock_skew_wait_enabled" != "True" ]]; then
  echo "Wait for clock skew to go below the acceptable threshold is disabled."
  skip_clock_skew_check=true
fi

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

readonly PYTHON_EXECUTABLES=("python" "python3" "python3.11" "python3.10" "python3.9" "python3.8" "python3.7" "python3.6" "python3.12" "python2")
PYTHON_EXECUTABLE=""
set_python_executable() {
  for py_executable in "${PYTHON_EXECUTABLES[@]}"; do
    if which "$py_executable" > /dev/null 2>&1; then
      PYTHON_EXECUTABLE="$py_executable"
      export PYTHON_EXECUTABLE
      return
    fi
  done
}

check_clock_sync_chrony() {
  # if chrond is restarted, tracking will return all 0s
  set_python_executable
  chrony_tracking="$(chronyc tracking)"
  if [[ $? -ne 0 ]]; then
    echo "`chronyc tracking` failed to execute"
    return 1
  fi
  if [[ $(echo "${chrony_tracking}" | awk "/Reference ID/ {print \$4}") == "00000000" ]]; then
    echo "chrony is not initialized"
    return 1
  fi
  local skew=$(echo "${chrony_tracking}" | awk "/System time/ {print \$4}")
  local dispersion=$(echo "${chrony_tracking}" | awk "/Root dispersion/ {print \$4}")
  local delay=$(echo "${chrony_tracking}" | awk "/Root delay/ {print \$4}")
  local clock_error=""
  if [[ -z "${PYTHON_EXECUTABLE}" ]]; then
    clock_error=${skew}
  else
   clock_error=$(${PYTHON_EXECUTABLE} -c "print(${skew} + ${dispersion} + (0.5 * ${delay}))")
  fi

  if awk "BEGIN {exit !($clock_error < $acceptable_clock_skew_sec)}"; then
    echo "Clock skew is within acceptable limits: $skew ms"
    return 0
  else
    echo "Clock skew exceeds acceptable limits: $skew ms"
    return 1
  fi
}

check_clock_sync_ntpd() {
  set_python_executable
  local skew=$(ntpq -p | awk "\$1 ~ /^\*/ {print \$9}")
  local acceptable_skew_ms=$(${PYTHON_EXECUTABLE} -c "print(${acceptable_clock_skew_sec} * 1000)")

  if [[ -z "$skew" ]]; then
    echo "ntpd is not initialized"
    return 1
  fi

  if awk "BEGIN{exit !(${skew} < ${acceptable_skew_ms})}"; then
    echo "Clock skew is within acceptable limits: $skew ms"
    return 0
  else
    echo "Clock skew exceeds acceptable limits: $skew ms"
    return 1
  fi
}

check_clock_sync_timesyncd() {
  synchronized=$(timedatectl status | grep "System clock synchronized" | awk "{print \$4}")
  if [[ "${synchronized}" == "yes" ]]; then
    echo "timesyncd reports clock is synchronized"
    return 0
  else
    echo "timesyncd clock is not synchronized"
    return 1
  fi
}

systemd_loaded() {
  active=$(systemctl show -p ActiveState --value $1 | tr -d '[:space:]')
  if [[ "${active}" == "active" ]]; then
    return 0
  fi
  return 1
}

# Set by classify_mount_point to explain the returned state.
mount_point_state=""
# Set by pending_mount on every call: the path whose mount is still outstanding,
# or empty when nothing on the path is outstanding.
pending_mount_path=""

# --mountpoint matches the target exactly and canonicalizes symlinks and
# trailing slashes, unlike a substring match against /proc/mounts.
is_mounted() {
  findmnt --noheadings --mountpoint "$1" >/dev/null 2>&1
}

# Returns 0 if /etc/fstab declares a mount for the given path, whether or not it
# is mounted right now. fstab is what provisioning writes when it attaches a
# drive, so it is the declaration of intent this check trusts. A volume mounted
# by some other mechanism that leaves no fstab entry is indistinguishable from a
# path that was never meant to be a mount, and is treated as the latter.
mount_is_declared() {
  local options
  options=$(findmnt --fstab --noheadings -o OPTIONS --mountpoint "$1" 2>/dev/null)
  [[ -n "$options" ]] && [[ ",$options," != *",noauto,"* ]]
}

# Returns 0 if a declared mount has not appeared yet, at the given path or at
# any ancestor of it. The configured path is often a subdirectory of the mount
# rather than the mount itself, e.g. /mnt/d0/m1 under an entry for /mnt/d0, and
# such a path does not exist at all until its parent mount lands.
pending_mount() {
  local path="${1%/}"
  [[ -n "$path" ]] || path="/"
  pending_mount_path=""

  while true; do
    if mount_is_declared "$path" && ! is_mounted "$path"; then
      pending_mount_path="$path"
      return 0
    fi
    [[ "$path" != "/" ]] || return 1
    path=$(dirname "$path")
  done
}

# Returns 0 if nothing needs to be waited for, 1 if a mount is still pending,
# and 2 if no amount of waiting can succeed.
classify_mount_point() {
  local mount_point="$1"

  # Checked before the ancestor walk so that a path which is itself mounted is
  # never held up by a pending mount declared for one of its ancestors.
  if is_mounted "$mount_point"; then
    mount_point_state="mounted"
    return 0
  fi

  if pending_mount "$mount_point"; then
    mount_point_state="waiting on $pending_mount_path, which is declared but not mounted"
    return 1
  fi

  if [[ ! -d "$mount_point" ]]; then
    mount_point_state="directory does not exist and no declared mount would create it"
    return 2
  fi

  # On-prem providers may configure a path that is a plain directory inside an
  # already-mounted filesystem, e.g. /data on a node where only / is mounted.
  mount_point_state="no separate mount expected; directory on an already-mounted filesystem"
  return 0
}

wait_for_mount_points() {
  if [[ -z "$mount_points" ]]; then
    echo "No mount points specified, skipping mount point wait."
    return 0
  fi

  IFS=' ' read -ra mount_points_array <<< "$mount_points"
  if [[ ${#mount_points_array[@]} -eq 0 ]]; then
    echo "No mount points specified, skipping mount point wait."
    return 0
  fi

  if ! command_exists findmnt; then
    echo "WARNING: findmnt is not available, cannot verify mount points." \
         "Skipping the mount point wait."
    return 0
  fi

  echo "Waiting for mount points to be mounted: ${mount_points_array[*]}"
  local mount_iter=0
  while true; do
    local all_ready=true
    local pending_points=()
    local ready_report=()
    for mount_point in "${mount_points_array[@]}"; do
      classify_mount_point "$mount_point"
      case $? in
        0)
          ready_report+=("$mount_point is ready: $mount_point_state")
          ;;
        1)
          all_ready=false
          pending_points+=("$mount_point")
          if [[ $mount_iter -eq 0 ]] || [[ $((mount_iter % 10)) -eq 0 ]]; then
            echo "Mount point $mount_point is $mount_point_state, waiting..."
          fi
          ;;
        2)
          echo "ERROR: Mount point $mount_point is misconfigured:" \
               "$mount_point_state."
          echo "Waiting cannot resolve this. Check the mount paths configured" \
               "for this node."
          echo "Exiting with error."
          exit 1
          ;;
      esac
    done

    if [[ "$all_ready" == true ]]; then
      for report_line in "${ready_report[@]}"; do
        echo "Mount point $report_line."
      done
      return 0
    fi

    ((mount_iter++))
    if [[ $mount_iter -ge $mount_wait_max_tries ]]; then
      echo "ERROR: Failed to mount required mount points after" \
           "$mount_wait_max_tries attempts."
      echo "The following mount points failed to mount:"
      for mount_point in "${pending_points[@]}"; do
        echo "  - $mount_point"
      done
      echo "Exiting with error."
      exit 1
    fi
    sleep "$mount_wait_time_s"
  done
}

# Wait for mount points to be mounted before starting clock sync check
wait_for_mount_points

if [[ "$skip_clock_skew_check" == true ]]; then
  echo "Skipping clock skew check. Returning success."
  exit 0
fi

iter=0
while true; do
  # If chrony is available, use it for clock sync.
  if command_exists chronyc; then
    check_clock_sync_chrony
    res=$?
  # If ntpd is available, use it for clock sync.
  elif command_exists ntpd; then
    check_clock_sync_ntpd
    res=$?
  elif systemd_loaded systemd-timesyncd; then
    check_clock_sync_timesyncd
    res=$?
  else
    echo "Chrony, NTPd, and timesyncd are not available, but required."
    exit 1
  fi
  ((iter++))
  if [ $res -eq 0 ]; then
    echo "Success! Clock skew is within acceptable limits."
    exit 0
  fi
  if [ $iter -ge $max_tries ]; then
    echo "Failure! Maximum number of tries reached."
    exit 1
  fi
  sleep "$retry_wait_time_s"
done
{% endraw %}
