[Unit]
Description=OpenTelemetry Collector
After=network.target network-online.target multi-user.target
# Disable restart limits, using RestartSec to rate limit restarts
StartLimitInterval=0

[Service]
{% if ansible_os_family == 'RedHat' and (ansible_distribution_major_version == '7' or (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2')) %}
User={{ user_name }}
Group={{ user_name }}
{% endif %}
# Start
ExecStart={{yb_home_dir}}/otel-collector/otelcol-contrib \
    --config=file:{{yb_home_dir}}/otel-collector/config.yml
Restart=always
RestartSec=5
# Stop -> SIGTERM - 10s - SIGKILL (if not stopped)
KillMode=process
TimeoutStopFailureMode=terminate
KillSignal=SIGTERM
TimeoutStopSec=10
FinalKillSignal=SIGKILL
# Logs
StandardOutput=journal
StandardError=journal
# ulimit
LimitCORE=infinity
LimitNOFILE=1048576
LimitNPROC=12000
# Hard Memory limit
MemoryMax={{otel_col_max_memory}}M

# Set only when the control tasks actually wrote the credentials: exporters resolve these while
# building their pipelines, so a dangling value fails collector startup outright.
{% if otel_col_aws_access_key is defined and otel_col_aws_secret_key is defined %}
Environment="AWS_PROFILE=otel-collector"
{% endif %}
{% if otel_col_gcp_creds_local is defined %}
Environment="GOOGLE_APPLICATION_CREDENTIALS={{yb_home_dir}}/otel-collector/gcp_creds"
{% endif %}
Environment="HOME={{yb_home_dir}}"

[Install]
WantedBy=default.target
