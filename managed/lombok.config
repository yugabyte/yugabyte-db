# Lombok's config lookup walks up from each source file, so this covers src/main and src/test.
config.stopBubbling = true

# @Jacksonized warns and silently assumes Jackson 2 whenever this key is unset. YBA serializes
# with Jackson 2 (com.fasterxml.jackson, via Play), so state that rather than rely on the default.
lombok.jacksonized.jacksonVersion += 2
